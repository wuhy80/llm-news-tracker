name: Rewrite history to drop dead media

# The orphan prune removed thousands of media files from the working tree, but
# their bytes stayed referenced by every old commit. This drops those paths from
# all history, which is where the reclaimable space actually is: the first run
# took .git from 796 MB to 303 MB.
#
# Runs quarterly, and can also be dispatched by hand (mode=report measures first).
#
# Why it runs this way:
#   - in CI, because filter-repo needs every object and a local blob:none clone
#     does not have them
#   - in its own concurrency group, because a run still pending in archive-writes
#     is cancelled as soon as the five-minute translation job queues another run,
#     so a scheduled rewrite would never actually start
#   - with --force-with-lease plus a retry loop, because the writers keep pushing
#     and a plain --force would silently discard their commit
#
# Safety rails, all of which abort rather than guess:
#   - a live path can never enter the drop list (comm -23 against the current tree)
#   - an empty list is a successful no-op, not a failure
#   - a list above 12000 paths is refused as implausible
#   - mode must be the literal word "rewrite" for a manual run to change anything

on:
  workflow_dispatch:
    inputs:
      mode:
        description: "report = measure only, rewrite = rewrite history and force-push"
        type: choice
        options:
          - report
          - rewrite
        default: report
  schedule:
    # 03:00 UTC on the first of January, April, July and October.
    - cron: '0 3 1 */3 *'

permissions:
  contents: write

concurrency:
  # Deliberately not archive-writes: see the note above.
  group: history-rewrite
  cancel-in-progress: false

jobs:
  rewrite:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    env:
      REPO_URL: https://x-access-token:${{ secrets.GITHUB_TOKEN }}@github.com/${{ github.repository }}.git
      # A scheduled run has no inputs, so it rewrites; a manual run must ask.
      MODE: ${{ github.event_name == 'schedule' && 'rewrite' || inputs.mode }}
    steps:
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install git-filter-repo
        run: pip install --quiet git-filter-repo && git filter-repo --version

      - name: Rewrite and push, retrying if a writer gets there first
        run: |
          set -euo pipefail
          echo "mode: $MODE"
          git config --global user.name 'github-actions[bot]'
          git config --global user.email '41898282+github-actions[bot]@users.noreply.github.com'

          for attempt in 1 2 3; do
            echo "::group::attempt $attempt"
            rm -rf /tmp/work
            git clone --quiet --no-single-branch "$REPO_URL" /tmp/work
            cd /tmp/work

            git ls-tree -r HEAD --name-only -- data/article-media | sort > /tmp/live.txt
            git log --all --diff-filter=D --name-only --pretty=format: -- data/article-media \
              | sed '/^$/d' | sort -u > /tmp/deleted.txt
            comm -23 /tmp/deleted.txt /tmp/live.txt > /tmp/dead.txt
            echo "live media files   : $(wc -l < /tmp/live.txt)"
            echo "paths ever deleted : $(wc -l < /tmp/deleted.txt)"
            echo "drop list          : $(wc -l < /tmp/dead.txt)"
            echo "before             : $(du -sh --exclude=.git . | cut -f1) tree, $(du -sh .git | cut -f1) .git"

            if [ ! -s /tmp/dead.txt ]; then
              echo "nothing to drop; the history is already clean"
              echo "::endgroup::"
              exit 0
            fi
            if [ "$(wc -l < /tmp/dead.txt)" -gt 12000 ]; then
              echo "::error::drop list is implausibly large; refusing"
              exit 1
            fi
            if comm -12 /tmp/dead.txt /tmp/live.txt | grep -q .; then
              echo "::error::drop list contains a live path; refusing"
              exit 1
            fi

            if [ "$MODE" != "rewrite" ]; then
              echo "report run: first 5 entries of the drop list"
              head -n 5 /tmp/dead.txt
              echo "::endgroup::"
              exit 0
            fi

            git filter-repo --force --invert-paths --paths-from-file /tmp/dead.txt
            echo "after              : $(du -sh --exclude=.git . | cut -f1) tree, $(du -sh .git | cut -f1) .git"

            git remote add origin "$REPO_URL"
            if git push --force-with-lease origin HEAD:main; then
              echo "pushed $(git rev-parse --short HEAD)"
              echo "::endgroup::"
              exit 0
            fi
            echo "::endgroup::"
            echo "push raced with a writer; retrying from a fresh clone"
            sleep 60
          done
          echo "::error::could not push the rewritten history after 3 attempts"
          exit 1
