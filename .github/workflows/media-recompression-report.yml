name: Media recompression report

# Measures what the stored media would cost as MP4 or WebP, by converting each
# candidate into a temporary directory and recording the result.
#
# Read-only: it never writes to the repository, so it is safe to run at any time.
# Acting on the numbers (converting the archive) is a separate change.

on:
  workflow_dispatch:
    inputs:
      limit:
        description: "Only the N largest files per strategy (0 = all)"
        type: string
        default: "0"
      strategy:
        description: "Restrict to one strategy (blank = all)"
        type: string
        default: ""

permissions:
  contents: read

concurrency:
  group: media-recompression-report
  cancel-in-progress: true

jobs:
  report:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Test the report script
        run: python -m unittest discover -s tests -p 'test_media_recompression_report.py'

      - name: Ensure ffmpeg
        run: |
          if ! command -v ffmpeg >/dev/null 2>&1; then
            sudo apt-get update -qq
            sudo apt-get install -y -qq ffmpeg
          fi
          ffmpeg -version | head -n 1

      - name: Report recompression potential
        env:
          LIMIT: ${{ inputs.limit || '0' }}
          STRATEGY: ${{ inputs.strategy || '' }}
        run: |
          if [ -n "$LIMIT" ] && [ "$LIMIT" != "0" ]; then
            if [ -n "$STRATEGY" ]; then
              python scripts/media_recompression_report.py --limit "$LIMIT" --strategy "$STRATEGY"
            else
              python scripts/media_recompression_report.py --limit "$LIMIT"
            fi
          elif [ -n "$STRATEGY" ]; then
            python scripts/media_recompression_report.py --strategy "$STRATEGY"
          else
            python scripts/media_recompression_report.py
          fi
