name: Rebuild indexes

# Rebuilds the daily shards, the manifest and the locator tables from the
# snapshots. Needed whenever snapshots change outside the normal pipeline, such
# as after a backfill: the front page reads the shards, so a stale shard keeps
# showing the old value no matter what the snapshot says.
#
# It shares media-maintenance rather than archive-writes, because a run still
# pending in archive-writes is cancelled as soon as the five-minute translation
# job queues another one, which is exactly when this is needed. It touches only
# derived data, so it can rebuild from whatever the snapshots currently say.

on:
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: media-maintenance
  cancel-in-progress: false

jobs:
  rebuild:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Rebuild the shards from the snapshots
        run: python scripts/build_news_data.py

      - name: Validate the rebuilt data
        run: python scripts/validate_data.py

      - name: Commit when something changed
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add -A data
          if git diff --cached --quiet; then
            echo "Nothing to rebuild"
            exit 0
          fi
          git commit -m 'chore: rebuild indexes from the snapshots'
          for attempt in 1 2 3; do
            git pull --rebase origin main
            if git push origin HEAD:main; then
              exit 0
            fi
          done
          echo "Unable to push the rebuilt indexes" >&2
          exit 1
