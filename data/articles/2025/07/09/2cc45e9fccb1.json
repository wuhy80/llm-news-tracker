      "spans": [
        {
          "start": 0,
          "end": 38,
          "kind": "strong"
        }
      ]
    },
    {
      "id": "b0060",
      "source": "🤝 Designed for Human-Robot Interaction",
      "spans": []
    },
    {
      "id": "b0061",
      "source": "Expressive Movement: Motorized head and body rotation, and animated antennas for rich human-robot interactions.",
      "spans": [
        {
          "start": 0,
          "end": 19,
          "kind": "strong"
        }
      ]
    },
    {
      "id": "b0062",
      "source": "Multimodal Sensing: Equipped with a camera, microphones, and speakers for AI powered audio-visual interaction.",
      "spans": [
        {
          "start": 0,
          "end": 18,
          "kind": "strong"
        }
      ]
    },
    {
      "id": "b0063",
      "source": "Assemble It Yourself: Sold as a kit, build your own companion robot with friends and kids.",
      "spans": [
        {
          "start": 0,
          "end": 20,
          "kind": "strong"
        }
      ]
    },
    {
      "id": "b0064",
      "source": "🌍 Open, Modular & Community-Powered",
      "spans": []
    },
    {
      "id": "b0065",
      "source": "🤗 Hugging Face Integration: Use state-of-the-art open-source models for speech, vision, and personality.",
      "spans": [
        {
          "start": 2,
          "end": 26,
          "kind": "strong"
        }
      ]
    },
    {
      "id": "b0066",
      "source": "Open-Source Everything: Hardware, software, and simulation environments fully open-source and community-supported. Stay tuned for the hardware release!",
      "spans": [
        {
          "start": 0,
          "end": 22,
          "kind": "strong"
        },
        {
          "start": 34,
          "end": 42,
          "kind": "a",
          "href": "https://github.com/pollen-robotics/reachy_mini"
        },
        {
          "start": 48,
          "end": 71,
          "kind": "a",
          "href": "https://github.com/pollen-robotics/reachy_mini#in-simulation-mujoco"
        }
      ]
    },
    {
      "id": "b0067",
      "source": "Community-Driven: Upload, share and download robot behaviors with the 10M users of the Hugging Face community.",
      "spans": [
        {
          "start": 0,
          "end": 16,
          "kind": "strong"
        }
      ]
    },
    {
      "id": "b0068",
