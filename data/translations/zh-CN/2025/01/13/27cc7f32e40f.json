    },
    {
      "id": "b0017",
      "kind": "paragraph",
      "sourceHash": "406054a0ebe7a3da",
      "translationZh": "模型不影响程序流程",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0018",
      "kind": "paragraph",
      "sourceHash": "a2be05849f11ff47",
      "translationZh": "👤 开发者控制系统能够执行的所有功能及其执行时机。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0019",
      "kind": "paragraph",
      "sourceHash": "f906d578f61ff277",
      "translationZh": "简单处理器",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0022",
      "kind": "paragraph",
      "sourceHash": "26b234b8433106e1",
      "translationZh": "模型决定基本控制流",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0023",
      "kind": "paragraph",
      "sourceHash": "29c5242ea7314387",
      "translationZh": "👤 开发者控制系统能够执行的所有功能；系统控制各项功能的执行时机。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0024",
      "kind": "paragraph",
      "sourceHash": "065d8e6c0bf74a69",
      "translationZh": "路由器",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0027",
      "kind": "paragraph",
      "sourceHash": "24b454cddf65115f",
      "translationZh": "模型决定函数如何执行",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0028",
      "kind": "paragraph",
      "sourceHash": "de4a679cb27af7c0",
      "translationZh": "👤 💻 开发者控制系统可以执行的所有函数及其执行时机；系统控制这些函数的执行方式。",
      "provider": "nowcoding",
