    },
    {
      "id": "b0032",
      "kind": "paragraph",
      "sourceHash": "94848246e3297296",
      "translationZh": "模型控制迭代和程序的继续执行",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0033",
      "kind": "paragraph",
      "sourceHash": "90e325eecb8f827c",
      "translationZh": "💻 👤 开发者控制系统可以执行的高层函数；系统控制执行哪些函数、何时执行以及如何执行。",
      "provider": "nowcoding",
