  "sourceTitle": "CO₂ Emissions and Models Performance: Insights from the Open LLM Leaderboard",
  "sourceBodyHash": "39b9c9f0ef6a69ea7b93e2c180fea16aaab1d5317ac866c36a97e50c728f51fd",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
