      "explanationZh": "通过自动生成等方式构建的数据集；文中查询由视觉语言模型生成。"
    },
    {
      "term": "VLMs",
      "briefZh": "视觉语言模型",
      "explanationZh": "能够处理视觉与语言信息的模型，文中用于为图像生成查询。"
    },
    {
      "term": "search queries",
      "briefZh": "搜索查询",
      "explanationZh": "提交给搜索引擎、用于查找相关文档的查询内容。"
    },
    {
      "term": "language filtering",
      "briefZh": "语言筛选",
      "explanationZh": "按指定语言筛选搜索结果，以获取目标语言的文档。"
    },
    {
      "term": "document layout analysis",
      "briefZh": "文档版面分析",
      "explanationZh": "分析页面中的文本和视觉元素及其布局，此处用于判断页面类型。"
    },
