  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "ce36ebdaa0e4310f",
      "translationZh": "概要：机器人策略模型正变得越来越庞大，而且预测的是未来的一整段动作，而不是单个下一步动作。这导致机器人在等待新动作时处于空闲状态，在执行时出现明显延迟，响应也不够及时。异步推理通过将动作预测与动作执行解耦，使控制回路更加紧凑，消除运行时的延迟，从而实现适应性更强的控制。在这篇博文中，我们将介绍异步推理的基本原理，以及如何利用它来提升机器人策略在现实世界中的表现。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0002",
      "kind": "heading",
      "sourceHash": "a9360e0212a4d173",
      "translationZh": "目录",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0003",
