  "sourceTitle": "NVIDIA CEO Drops the Blueprint for Europe’s AI Boom",
  "sourceBodyHash": "67c0119ca1a1a66d428f259f8ca890875bef3e2f7bc8b04b023bcf0e2c217cf0",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "complete",
  "importanceLevel": 4,
