  "sourceUrl": "https://huggingface.co/blog/vllm-colocate",
  "sourceTitle": "No GPU left behind: Unlocking Efficiency with Co-located vLLM in TRL",
  "sourceBodyHash": "d952d40f517099546ceee4174bf723275d73f99c4e412da270cd292e9235e9e2",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "partial",
  "importanceLevel": 4,
  "provider": "nowcoding",
