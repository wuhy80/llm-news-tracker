    },
    {
      "term": "localization performance",
      "briefZh": "定位性能",
      "explanationZh": "在网页界面中准确定位交互目标的能力表现。"
    },
    {
      "term": "Pareto frontier",
      "briefZh": "帕累托前沿",
      "explanationZh": "多目标权衡中的最优解集合；在这里指成本与网页导航表现之间无法同时进一步改善的边界。"
    }
  ],
