  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "8da7ee6f48c790c1",
      "translationZh": "太长不看版：今天，我们发布了 LeRobotDataset:v3！在之前发布的 LeRobotDataset:v2 中，我们将每个回合存储在一个单独的文件中，当数据集扩展到数百万个回合时，就会遇到文件系统的限制。LeRobotDataset:v3 将多个回合打包到同一个文件中，利用关系型元数据，从包含多个回合的文件中检索单个回合级别的信息。新格式还原生支持以流式模式访问数据集，可以即时处理大型数据集。我们提供了一个只需一行命令即可使用的实用工具，用于将所有 LeRobotDataset 格式的数据集转换为新格式，并且非常兴奋能在下一个稳定版本发布之前，与社区分享这一里程碑！",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0002",
      "kind": "heading",
      "sourceHash": "a9360e0212a4d173",
      "translationZh": "目录",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0003",
      "kind": "list-item",
      "sourceHash": "faad12b0ebd64297",
      "translationZh": "安装 lerobot，并录制一个数据集",
