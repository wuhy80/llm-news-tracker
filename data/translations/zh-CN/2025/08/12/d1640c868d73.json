  "sourceTitle": "🇵🇭 FilBench - Can LLMs Understand and Generate Filipino?",
  "sourceBodyHash": "d57a62f5680955873e1f3d8291017240f8a97647e1ad1215f4061091baade0b5",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
