  "wordWise": [
    {
      "term": "open-weights",
      "briefZh": "开放权重",
      "explanationZh": "指公开模型权重，使用户能够获取并自行部署模型；不等同于开放全部训练代码或数据。"
    },
    {
      "term": "agentic tasks",
      "briefZh": "智能体任务",
      "explanationZh": "指由模型作为智能体执行的任务，通常涉及规划、采取行动和完成目标。"
    },
    {
      "term": "mixture-of-experts",
      "briefZh": "混合专家架构",
      "explanationZh": "由多个专家模块组成的模型架构，每次计算仅激活其中一部分，以降低计算开销。"
    },
    {
      "term": "4-bit quantization",
      "briefZh": "4 位量化",
      "explanationZh": "以 4 位数值表示模型参数的量化方式，用于减少资源占用。"
    },
    {
      "term": "active parameters",
      "briefZh": "活跃参数",
      "explanationZh": "指模型在一次计算中实际参与运算的参数，而非模型的全部参数。"
    },
    {
      "term": "on-device applications",
      "briefZh": "端侧应用",
      "explanationZh": "指在用户设备本地运行模型的应用，而非依赖远程服务器进行推理。"
    },
    {
      "term": "Inference Providers",
      "briefZh": "推理服务提供方",
      "explanationZh": "指提供模型推理服务的供应方；此处是通过 API 访问模型的服务渠道。"
    },
    {
      "term": "Local Inference",
      "briefZh": "本地推理",
      "explanationZh": "在本地设备上运行模型并生成结果，而非调用远程服务。"
    },
    {
      "term": "transformers",
      "briefZh": "模型工具库",
      "explanationZh": "用于加载和运行 Transformer 等模型的库，此处指本地推理所使用的工具。"
    },
    {
      "term": "AMD ROCm support",
      "briefZh": "计算平台支持",
      "explanationZh": "指对 AMD ROCm GPU 计算平台的兼容与支持。"
    },
    {
      "term": "Fine Tuning",
      "briefZh": "微调",
      "explanationZh": "在预训练模型的基础上进一步训练，使其适应特定任务或数据。"
    },
    {
      "term": "Evaluating the Model",
      "briefZh": "模型评估",
      "explanationZh": "衡量模型在相关任务上的表现。"
    },
    {
      "term": "Chat Templates",
      "briefZh": "聊天模板",
      "explanationZh": "用于将聊天消息组织成模型所需输入格式的模板。"
    },
    {
      "term": "System and Developer Messages",
      "briefZh": "系统与开发者消息",
      "explanationZh": "聊天中分别用于提供系统层级和开发者层级指令的消息类型。"
    },
    {
      "term": "tool use",
      "briefZh": "工具调用",
      "explanationZh": "模型调用外部工具以执行操作或获取信息的能力。"
    },
    {
      "term": "quantization",
      "briefZh": "量化",
      "explanationZh": "以较低位数表示模型数值的技术；此处采用 4-bit 方案，且仅用于 MoE 权重。"
    },
    {
      "term": "MoE weights",
      "briefZh": "混合专家权重",
      "explanationZh": "混合专家架构中专家模块的权重参数。"
    },
    {
      "term": "chain-of-thought",
      "briefZh": "思维链",
      "explanationZh": "模型在推理过程中形成的逐步推导过程。"
    },
    {
      "term": "reasoning effort levels",
      "briefZh": "推理投入级别",
      "explanationZh": "用于调节模型在推理上投入多少计算或处理资源的级别。"
    },
    {
      "term": "Instruction following",
      "briefZh": "指令遵循",
      "explanationZh": "模型按照用户给定的要求和约束完成任务的能力。"
    },
    {
      "term": "Inference implementations",
      "briefZh": "推理实现",
