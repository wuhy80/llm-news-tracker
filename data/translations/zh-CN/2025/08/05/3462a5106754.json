    {
      "id": "b0027",
      "kind": "list-item",
      "sourceHash": "2e147a970dca7dce",
      "translationZh": "总参数量分别为 21B 和 117B，激活参数量分别为 3.6B 和 5.1B。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0028",
      "kind": "list-item",
      "sourceHash": "545b88dd94ebed85",
      "translationZh": "使用 mxfp4 格式的 4-bit 量化方案。仅应用于 MoE 权重。据称，120B 可装入单张 80 GB GPU，20B 可装入单张 16GB GPU。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0029",
      "kind": "list-item",
      "sourceHash": "f25e1a883ad44915",
      "translationZh": "仅处理文本的推理模型；具备思维链，且推理投入程度可调。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0030",
      "kind": "list-item",
      "sourceHash": "3eda6becd3da1c09",
      "translationZh": "支持指令遵循和工具调用。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
