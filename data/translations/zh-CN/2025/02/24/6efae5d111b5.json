    },
    {
      "id": "b0028",
      "kind": "paragraph",
      "sourceHash": "5ee98a21603b8c8b",
      "translationZh": "最后是一个 HunyuanVideo 的示例。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0029",
