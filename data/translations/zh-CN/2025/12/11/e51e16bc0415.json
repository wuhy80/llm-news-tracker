  "sourceTitle": "As AI Grows More Complex, Model Builders Rely on NVIDIA",
  "sourceBodyHash": "469df4efb6ab3a6d690d212065f6c5822f042165cfb6dfa8f1196b64dcb2453d",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
