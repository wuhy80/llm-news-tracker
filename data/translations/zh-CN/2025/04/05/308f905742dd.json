  "wordWise": [
    {
      "term": "Mixture of Experts (MoE)",
      "briefZh": "混合专家",
      "explanationZh": "由多个专家模块组成的模型架构，处理输入时只激活其中一部分专家。"
    },
    {
      "term": "active parameters",
      "briefZh": "活跃参数",
      "explanationZh": "模型处理某次输入时实际参与计算的参数，而非模型的全部参数。"
    },
    {
      "term": "auto-regressive",
      "briefZh": "自回归",
      "explanationZh": "根据此前的内容逐步预测并生成后续内容的建模方式。"
    },
    {
      "term": "early fusion",
      "briefZh": "早期融合",
      "explanationZh": "在模型处理的较早阶段融合不同模态的信息，本文指文本与图像信息的融合。"
    },
    {
      "term": "native multimodality",
      "briefZh": "原生多模态",
      "explanationZh": "模型本身具备处理多种模态的能力，本文涉及文本和图像输入。"
    },
    {
      "term": "tokens",
      "briefZh": "词元",
      "explanationZh": "模型处理文本等数据时使用的基本单位，不一定对应一个完整的单词。"
    },
    {
      "term": "fine-tuning",
      "briefZh": "微调",
      "explanationZh": "在已训练模型的基础上进一步训练，使其适应特定任务或语言。"
    },
    {
      "term": "on-the-fly",
      "briefZh": "即时处理",
      "explanationZh": "指在加载或使用过程中即时执行处理，而非预先完成；此处用于描述量化方式。"
    },
    {
      "term": "FP8",
      "briefZh": "8位浮点格式",
      "explanationZh": "一种用 8 位表示浮点数的低精度格式，此处用于模型权重，以支持高效部署。"
    },
    {
      "term": "Model Checkpoints",
      "briefZh": "模型检查点",
      "explanationZh": "训练过程中保存的模型状态，通常包含可供加载和使用的模型权重。"
    },
    {
      "term": "instruction tuned variants",
      "briefZh": "指令微调版本",
      "explanationZh": "经过指令数据微调、使模型更善于按用户指令作答的版本。"
    },
    {
      "term": "tensor-parallel",
      "briefZh": "张量并行",
      "explanationZh": "将模型中的张量及相关计算分配到多个设备上并行处理的技术。"
    },
    {
      "term": "automatic device mapping",
      "briefZh": "自动设备映射",
      "explanationZh": "自动决定模型各部分应放置在哪些计算设备上，以利用可用硬件资源。"
    },
    {
      "term": "high-throughput text generation",
      "briefZh": "高吞吐文本生成",
      "explanationZh": "强调单位时间内能够生成大量文本或处理大量生成请求的能力。"
    },
    {
      "term": "storage backend",
      "briefZh": "存储后端",
      "explanationZh": "负责模型文件底层存储及上传、下载的系统。"
    },
    {
      "term": "deduplication",
      "briefZh": "重复数据删除",
      "explanationZh": "识别并避免重复存储或传输相同数据，以节省存储空间和带宽。"
    },
    {
      "term": "finetune",
      "briefZh": "微调",
      "explanationZh": "在已有预训练模型的基础上进一步训练，使其适应特定任务或需求。"
    },
    {
      "term": "quantizations",
      "briefZh": "量化",
      "explanationZh": "使用较低精度表示模型参数等数值，以减少模型的存储和计算开销。"
    },
    {
      "term": "context length",
      "briefZh": "上下文长度",
      "explanationZh": "模型一次处理时可容纳的上下文规模，通常以词元数量衡量。"
    },
    {
      "term": "experts",
      "briefZh": "专家模块",
      "explanationZh": "模型架构中的专门计算模块；文中以专家数量区分两个模型版本。"
    },
    {
      "term": "context lengths",
      "briefZh": "上下文长度",
      "explanationZh": "模型在一次处理中能够容纳的上下文规模，通常以词元数量衡量。"
    },
    {
      "term": "architecture choices",
      "briefZh": "架构选择",
      "explanationZh": "模型结构设计中采用的具体方案或取舍。"
    },
    {
      "term": "No RoPE (NoPE) layers",
      "briefZh": "无旋转位置编码层",
      "explanationZh": "指不使用旋转位置编码（RoPE）的模型层，文中标记为 NoPE。"
    },
    {
      "term": "positional encoding",
      "briefZh": "位置编码",
      "explanationZh": "为模型提供序列中各个位置的信息的编码方式。"
    }
  ],
