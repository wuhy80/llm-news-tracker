    },
    {
      "id": "b0100",
      "kind": "paragraph",
      "sourceHash": "bb9755f32f234100",
      "translationZh": "多语言",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0103",
      "kind": "paragraph",
      "sourceHash": "d5a54fb9a7f48ada",
      "translationZh": "平均值/F1",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0108",
      "kind": "paragraph",
      "sourceHash": "1aa4cb0bcca76e92",
      "translationZh": "图像",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
