    {
      "id": "b0029",
      "kind": "paragraph",
      "sourceHash": "1763aee9a5e2cf6e",
      "translationZh": "AutoRound 仅需 200 个调优步骤和一个小型校准数据集（最少只需 128 个样本），即可实现高精度。与计算密集程度更高的其他 int2 方法相比，这种高效性意味着更短的量化时间和更少的资源消耗。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
