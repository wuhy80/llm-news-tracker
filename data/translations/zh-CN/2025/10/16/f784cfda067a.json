    },
    {
      "id": "b0061",
      "kind": "list-item",
      "sourceHash": "0ae9377ed444a841",
      "translationZh": "设置 max_new_tokens=1024 并测量总延迟，然后计算 throughput=(OUTPUT_TOKENS∗batch_size)/total_latencythroughput = (OUTPUT\\_TOKENS * batch\\_size) / total\\_latencythroughput=(OUTPUT_TOKENS∗batch_size)/total_latency。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0062",
      "kind": "paragraph",
      "sourceHash": "c39152c30fc84f95",
      "translationZh": "对于以下代码，运行 numactl -l python benchmark.py。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0063",
      "kind": "heading",
      "sourceHash": "219c4a6c86a716e9",
