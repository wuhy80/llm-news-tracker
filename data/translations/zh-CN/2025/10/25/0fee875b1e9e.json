    }
  ],
  "wordWise": [
    {
      "term": "live-action filmmaking",
      "briefZh": "实拍电影制作",
      "explanationZh": "通过摄影机拍摄真实演员和场景来制作电影，与生成式影像制作相区别。"
    },
    {
