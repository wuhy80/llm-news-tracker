  "sourceTitle": "🐯 Liger GRPO meets TRL",
  "sourceBodyHash": "c79b939d1206d112e41795f81413e4e7bb7822038861ee707af23c2321c693dc",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
