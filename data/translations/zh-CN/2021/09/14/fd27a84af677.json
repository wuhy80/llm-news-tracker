  "sourceTitle": "Introducing Optimum: The Optimization Toolkit for Transformers at Scale",
  "sourceBodyHash": "8c6768379f370bbf267b7e06616b41a3b3203b411ec8c0c2c74da56c0e738a1d",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "complete",
