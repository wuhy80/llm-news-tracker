  "sourceTitle": "Introducing the Data Measurements Tool: an Interactive Tool for Looking at Datasets",
  "sourceBodyHash": "bc8aa09ac9fe517defe0c500de4f26b584dbe43b35b20b9756c9c92d3ab0c54a",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
