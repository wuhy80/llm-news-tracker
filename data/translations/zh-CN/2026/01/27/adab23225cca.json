  "wordWise": [
    {
      "term": "Modern Standard Arabic",
      "briefZh": "现代标准阿拉伯语",
      "explanationZh": "阿拉伯语的标准书面与正式语体，文中将其与日常使用的地区方言相对照。"
    },
    {
      "term": "phonology",
      "briefZh": "音系",
      "explanationZh": "语言中语音的组织方式与规律，是不同阿拉伯语方言之间存在差异的层面之一。"
    },
    {
      "term": "benchmarks",
      "briefZh": "基准测试",
      "explanationZh": "用于衡量和比较模型能力的标准化评估任务或数据集。"
    },
    {
      "term": "pragmatic usage",
      "briefZh": "语用方式",
      "explanationZh": "表达在具体交流情境中的实际用法及其所传达的意图，而非仅指字面含义。"
    },
    {
      "term": "lexical knowledge",
      "briefZh": "词汇知识",
      "explanationZh": "对词语及其含义的掌握；文中强调评估不应止于这一表层能力。"
    },
    {
      "term": "manual curation",
      "briefZh": "人工整理",
      "explanationZh": "由人工收集、筛选和整理数据，以保留真实的方言表达及其文化含义。"
    },
    {
      "term": "distractor choices",
      "briefZh": "干扰选项",
      "explanationZh": "选择题中看似合理、但并非正确答案的选项。"
    },
    {
      "term": "semantic closeness",
      "briefZh": "语义接近度",
      "explanationZh": "此处指干扰选项与正确答案在含义上的接近程度。"
    },
    {
      "term": "positional bias",
      "briefZh": "位置偏差",
      "explanationZh": "评估结果受到正确答案所在选项位置影响而产生的偏差。"
    },
    {
      "term": "randomized distribution",
      "briefZh": "随机化分布",
      "explanationZh": "此处指通过随机化安排，使正确答案分布在不同的选项位置。"
    },
    {
      "term": "figurative language",
      "briefZh": "比喻性语言",
      "explanationZh": "不按字面含义理解，而是借助比喻等方式表达意思的语言。"
    },
    {
      "term": "Imagery",
      "briefZh": "意象",
      "explanationZh": "通过描述唤起感官体验或心理画面的表达手法。"
    },
    {
      "term": "Figurative Meaning",
      "briefZh": "比喻意义",
      "explanationZh": "超越字面含义，通过比喻等修辞传达的意义。"
    },
    {
      "term": "Etiquette",
      "briefZh": "礼仪",
      "explanationZh": "特定社会或文化中约定俗成的行为规范与礼节。"
    },
    {
      "term": "Creative Expression",
      "briefZh": "创意表达",
      "explanationZh": "运用想象力和独创性表达思想、情感或体验。"
    },
    {
      "term": "Heritage Knowledge",
      "briefZh": "文化遗产知识",
      "explanationZh": "有关代代传承的文化、传统及遗产的知识。"
    },
    {
      "term": "pragmatic understanding",
      "briefZh": "语用理解",
      "explanationZh": "理解话语在具体语境中的意图、作用和恰当用法的能力。"
    },
    {
      "term": "base models",
      "briefZh": "基础模型",
      "explanationZh": "尚未经过指令微调的模型版本，文中用作比较方言表现的基准。"
    },
    {
      "term": "instruction-tuned models",
      "briefZh": "指令微调模型",
      "explanationZh": "通过指令与回答示例进行微调，以提升遵循指令能力的模型。"
    },
    {
      "term": "alignment",
      "briefZh": "对齐",
      "explanationZh": "使模型行为符合人类意图和期望的训练或调整过程。"
    },
    {
      "term": "semantic correctness",
      "briefZh": "语义正确性",
      "explanationZh": "回答在含义上是否正确，而不要求措辞与参考答案一致。"
    },
    {
      "term": "literal overlap",
      "briefZh": "字面重合",
      "explanationZh": "回答与参考答案在文字表达上的相同程度，不一定反映含义是否正确。"
    },
    {
      "term": "subjective annotation",
      "briefZh": "主观标注",
      "explanationZh": "由标注者依据主观判断给出标签；此处指对问题难度的人工判断。"
    },
    {
      "term": "primary metric",
      "briefZh": "主要指标",
      "explanationZh": "评估模型表现时采用的核心衡量标准，此处为选择题准确率。"
    }
  ],
