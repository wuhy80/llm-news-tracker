  "sourceTitle": "NVIDIA Rubin Platform, Open Models, Autonomous Driving: NVIDIA Presents Blueprint for the Future at CES",
  "sourceBodyHash": "c0958e91d6854ec719f37e44c5955a219f99550633842da6ba3a3cf78af3a1e0",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
