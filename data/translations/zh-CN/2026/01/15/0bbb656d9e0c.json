  "sourceTitle": "Open Responses: What you need to know",
  "sourceBodyHash": "da138ff1bde40361519faf8232564eb37283b2dc0c104a46e9bcf71cf3612335",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
