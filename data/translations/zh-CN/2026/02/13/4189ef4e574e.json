  "wordWise": [
    {
      "term": "CUDA kernels",
      "briefZh": "CUDA 内核",
      "explanationZh": "在 GPU 上执行的计算函数，本文关注其编写、优化及与模型库的集成。"
    },
    {
      "term": "PyTorch bindings",
      "briefZh": "PyTorch 绑定",
      "explanationZh": "将底层内核连接到 PyTorch 调用接口的绑定，使其能在 PyTorch 中使用。"
    },
    {
      "term": "memory access patterns",
      "briefZh": "内存访问模式",
