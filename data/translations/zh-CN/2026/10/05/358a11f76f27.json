  "sourceTitle": "k_llama.cpp MoE Optimizations: Expert Residency, Hybrid CPU/GPU Execution, Q2_0 Support",
  "sourceBodyHash": "cde049f1637fd710b878fba92011c76b36502b236297e51b9792b8d447f97a28",
