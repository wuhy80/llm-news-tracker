  "sourceTitle": "How do you control what context your coding agent sends to an LLM? I built a local tool to measure and audit it…",
  "sourceBodyHash": "9ca7ba60b0f6fdbc05b05f6553264ee6d2d5394e10d35ee63a27e93e35844be4",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
