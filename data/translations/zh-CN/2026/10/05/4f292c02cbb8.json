  "wordWise": [
    {
      "term": "ASR",
      "briefZh": "自动语音识别",
      "explanationZh": "将语音转换为文字的技术，全称为 Automatic Speech Recognition。"
    },
    {
      "term": "SOTA",
      "briefZh": "当前最优水平",
      "explanationZh": "指某个领域或任务中目前最先进的性能水平。"
    },
    {
      "term": "WER",
      "briefZh": "词错误率",
      "explanationZh": "评估语音识别结果的指标，衡量替换、删除和插入词所造成的错误，通常越低越好。"
    },
    {
      "term": "log-mel",
      "briefZh": "对数梅尔特征",
      "explanationZh": "以梅尔频率尺度表示音频频谱并取对数，常用作语音模型的输入特征。"
    },
    {
      "term": "gated cross attention",
      "briefZh": "门控交叉注意力",
      "explanationZh": "通过门控机制控制交叉注意力的信息流；此处用于解码器读取音频编码器的输出。"
    },
    {
      "term": "Keyword biasing",
      "briefZh": "关键词偏置",
      "explanationZh": "在识别过程中提高指定关键词的优先级，帮助模型识别用户常说的名字等词语。"
    },
    {
      "term": "beam search",
      "briefZh": "束搜索",
      "explanationZh": "解码时保留多个较优候选序列并逐步扩展，以寻找更合适的识别结果。"
    },
    {
      "term": "open weights",
      "briefZh": "开放权重",
      "explanationZh": "指公开模型的已训练权重，供他人获取和使用，并不等同于开放全部训练代码或数据。"
    }
  ],
