  "sourceTitle": "Infermeld: a Linux kit for running one GGUF across AMD + NVIDIA GPUs with llama.cpp",
  "sourceBodyHash": "5fe968ed2366145268d4bcfaf4baa36c9d27c1b5faedad64d5674e53fc7986f5",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
