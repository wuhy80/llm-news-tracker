  "wordWise": [
    {
      "term": "k-pool",
      "briefZh": "k池",
      "explanationZh": "指一种依赖于状态的图结构模型，用于管理内存池。"
    },
    {
      "term": "graph reallocation",
      "briefZh": "图重分配",
      "explanationZh": "指在模型执行过程中意外重新分配计算图的操作，可能导致性能下降。"
    },
    {
      "term": "inp->cache_safe",
      "briefZh": "缓存安全",
      "explanationZh": "指向输入结构中表示缓存是否安全的成员变量，用于分支判断。"
    },
    {
      "term": "scatter+gather",
      "briefZh": "散射聚集",
      "explanationZh": "一种数据移动操作模式，先分散后聚集，后被替换为 fill+concat。"
    },
    {
      "term": "gather",
      "briefZh": "收集",
      "explanationZh": "指在注意力机制中根据索引从键值张量中提取特定元素的操作。"
    },
    {
      "term": "n_tokens",
      "briefZh": "令牌数",
      "explanationZh": "表示当前序列中的标记（token）数量，用于控制分支条件。"
    },
    {
      "term": "n_kv",
      "briefZh": "键值数",
      "explanationZh": "表示键值缓存中的条目数量，影响 gather 操作的范围。"
    },
    {
      "term": "GGML_SCHED_DEBUG_REALLOC=1",
      "briefZh": "调试重分配",
      "explanationZh": "环境变量，启用 GGML 调度器的重新分配调试模式，用于检测内存分配问题。"
    },
    {
      "term": "pooled keys",
      "briefZh": "汇聚键",
      "explanationZh": "经过汇聚操作后得到的键向量，用于后续注意力计算。"
    },
    {
      "term": "n_ubatch",
      "briefZh": "微批大小",
      "explanationZh": "表示每个微批处理的 token 数量，是批处理的细分单位。"
    },
    {
      "term": "top_k",
      "briefZh": "顶K",
      "explanationZh": "保留得分最高的 K 个元素，常用于稀疏注意力中的截断。"
    },
    {
      "term": "kpool",
      "briefZh": "键池",
      "explanationZh": "存储键向量的池化结构，用于快速检索和重用。"
    },
    {
      "term": "n_sel",
      "briefZh": "选择数",
      "explanationZh": "表示在稀疏注意力中实际选择的键值对数量。"
    },
    {
      "term": "cache_safe",
      "briefZh": "安全缓存",
      "explanationZh": "表示缓存操作是否安全的标志。"
    },
    {
      "term": "get_kpool_cache_safe",
      "briefZh": "获取安全缓存",
      "explanationZh": "用于检查 k-pool 是否使用安全缓存的函数。"
    },
    {
      "term": "scatter target",
      "briefZh": "散射目标",
      "explanationZh": "模型传递的用于散射操作的目标张量或索引。"
    },
