      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0037",
      "kind": "paragraph",
      "sourceHash": "5844d4eda61e2abe",
      "translationZh": "随着增长，因此调度器会根据当前状态重新预留",
      "provider": "openrouter",
