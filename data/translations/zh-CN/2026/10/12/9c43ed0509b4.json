  "wordWise": [
    {
      "term": "bpw",
      "briefZh": "每权重位数",
      "explanationZh": "表示每个模型权重平均占用的比特数，用于描述量化模型的存储精度。"
    },
    {
      "term": "Adapters",
      "briefZh": "适配器",
      "explanationZh": "训练中得到的额外参数模块，可单独保存和加载，也可合并到基础模型中。"
    },
    {
      "term": "LoRA",
      "briefZh": "低秩适配",
      "explanationZh": "通过训练低秩参数矩阵来调整模型的参数高效微调方法。"
    },
    {
      "term": "routed MoE experts",
      "briefZh": "路由式专家",
      "explanationZh": "混合专家模型中，由路由机制为输入选择并激活的专家模块。"
    },
    {
      "term": "DDP",
      "briefZh": "分布式数据并行",
      "explanationZh": "在多个 GPU 上使用不同数据批次进行训练，并同步梯度的数据并行方式。"
    },
    {
      "term": "Sample packing",
      "briefZh": "样本打包",
      "explanationZh": "将多个样本组合到训练序列中，以减少填充并提高计算利用率。"
    },
    {
      "term": "Gradient checkpointing",
      "briefZh": "梯度检查点",
      "explanationZh": "仅保存部分中间结果，并在反向传播时重新计算其余结果，以节省显存。"
    },
    {
      "term": "activation offload",
      "briefZh": "激活卸载",
      "explanationZh": "将中间激活值移出 GPU 显存，在需要时再取回，以降低显存占用。"
    },
    {
      "term": "Real-time training",
      "briefZh": "实时训练",
      "explanationZh": "在模型提供服务的同时进行训练，而非仅在离线阶段训练。"
    },
    {
      "term": "adapter",
      "briefZh": "适配器",
      "explanationZh": "模型中可单独训练的适配组件，此处在聊天服务运行时进行训练。"
    },
    {
      "term": "Eval loss",
      "briefZh": "评估损失",
      "explanationZh": "模型在评估数据上的损失值，用于衡量模型表现，通常越低越好。"
    },
    {
      "term": "Peak VRAM",
      "briefZh": "峰值显存",
      "explanationZh": "运行过程中显存占用的最高值。"
    },
    {
      "term": "training pipeline",
      "briefZh": "训练流水线",
      "explanationZh": "将模型训练所需的各个步骤串联起来的一整套流程。"
    }
  ],
