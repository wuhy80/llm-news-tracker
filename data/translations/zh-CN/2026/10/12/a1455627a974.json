    },
    {
      "id": "b0075",
      "kind": "heading",
      "sourceHash": "acf020e482b1a752",
      "translationZh": "宣布 FrontierCode 上线 Artificial Analysis：AI 模型能编写出维护者愿意合并的代码吗？",
      "provider": "nowcoding",
