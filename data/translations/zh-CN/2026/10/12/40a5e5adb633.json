  "sourceTitle": "Deploy decision models with llama.cpp on Amazon SageMaker AI",
  "sourceBodyHash": "a3714215daa6d462cab6e64cf589c7795924ec7d5d8c620d3c6a6c8ad3e663bd",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
