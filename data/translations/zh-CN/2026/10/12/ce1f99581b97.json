  "sourceTitle": "A Record of the Process of Increasing MFU from 21% to 50% While Pre-training 21B MoE Using a Single GH200 Chip…",
  "sourceBodyHash": "f974e8d21dbb852bea69722160f59314ba220211560be479d904f0e2c50d1266",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
