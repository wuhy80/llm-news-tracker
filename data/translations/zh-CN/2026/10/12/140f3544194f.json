  "sourceTitle": "GitHub Copilot app for Beginners: How to teach Copilot about your codebase",
  "sourceBodyHash": "09a30b7592b0e8b9a58d129804064a9407f37f40315c8239243dec28f7a8a635",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "complete",
  "importanceLevel": 4,
  "provider": "nowcoding",
