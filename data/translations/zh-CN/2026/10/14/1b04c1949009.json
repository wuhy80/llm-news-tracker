  "sourceUrl": "https://openai.com/index/sentinelone",
  "sourceTitle": "SentinelOne cuts malware analysis from weeks to hours",
  "sourceBodyHash": "37c8c79577cb8aa64737b3f51042a93a9762af41c6911083bc12c28ffd1c62cc",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
