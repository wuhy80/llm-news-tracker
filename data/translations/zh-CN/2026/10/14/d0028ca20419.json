      "sourceHash": "935b1fdd4201db0d",
      "translationZh": "在 mod 的 skill.prompt 钩子接收的数据中新增技能的 frontmatter、来源、插件名称和文件路径",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
