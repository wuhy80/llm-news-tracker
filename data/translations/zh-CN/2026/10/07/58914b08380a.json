    },
    {
      "term": "layer splitting",
      "briefZh": "层拆分",
      "explanationZh": "将模型的不同层分配到多张显卡上运行。"
    },
    {
      "term": "asymmetric tensor splits",
      "briefZh": "非对称张量拆分",
