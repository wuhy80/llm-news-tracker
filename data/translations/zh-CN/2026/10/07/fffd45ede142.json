    {
      "id": "b0093",
      "kind": "paragraph",
      "sourceHash": "32f1b24b0126bd44",
      "translationZh": "OpenAI 数学仓库中整数乘法速度快于 n log n (3.1K)",
      "provider": "openrouter",
