  "sourceTitle": "How Cornerstone OnDemand cut database diagnosis by 78% with Amazon Bedrock",
  "sourceBodyHash": "1469ee3a3881bf238306889ba36dd31e703ca777c8d54eb605905f4b24244a81",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
