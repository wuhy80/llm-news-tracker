  "sourceBodyHash": "e20b0e117ca55a7a69cad332a7149721a3118694a3e5a0d016508967d2930d0c",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
