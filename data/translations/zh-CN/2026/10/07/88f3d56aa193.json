    {
      "term": "WER",
      "briefZh": "字错率",
      "explanationZh": "Word Error Rate 的缩写，衡量语音识别准确度的常用指标。"
    },
    {
      "term": "CER",
      "briefZh": "字符错误率",
      "explanationZh": "Character Error Rate 的缩写，衡量文本识别中字符级别错误的指标。"
