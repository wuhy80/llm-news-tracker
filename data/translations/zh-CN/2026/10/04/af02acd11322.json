  "sourceTitle": "Qwen3.8 27B | 1 x R9700: 262K context, half a million tokens of reusable cache, ~180 tok/s. And yes, let's talk about…",
  "sourceBodyHash": "c7c641e063379d1d2b3dbd68cefd9e287e77a50009a0c7c84d7a52c79d012380",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "partial",
