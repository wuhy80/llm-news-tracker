      "briefZh": "检索增强生成",
      "explanationZh": "先检索相关资料，再利用检索结果辅助模型生成回答的方法。"
    },
    {
      "term": "MoE",
      "briefZh": "混合专家",
      "explanationZh": "由多个专家子网络组成、针对输入选择部分专家参与计算的模型结构。"
    },
    {
      "term": "quantization",
      "briefZh": "量化",
      "explanationZh": "以较低精度表示模型数值，以减少存储需求和计算开销。"
    },
    {
      "term": "attention scoring",
      "briefZh": "注意力评分",
      "explanationZh": "计算不同输入位置之间的相关程度，以确定注意力权重的过程。"
    },
    {
      "term": "cache locality",
      "briefZh": "缓存局部性",
      "explanationZh": "对近期或邻近数据的重复访问特性；改善这一特性可提高缓存利用率。"
    },
    {
      "term": "memory-bandwidth bound",
      "briefZh": "受内存带宽限制",
      "explanationZh": "指性能主要由内存传输数据的速度决定，而非计算能力。"
    },
    {
      "term": "quantization layout",
      "briefZh": "量化布局",
      "explanationZh": "指量化后数据的组织与存储方式，会影响数据读取和处理效率。"
    },
    {
      "term": "memory prefetching",
      "briefZh": "内存预取",
      "explanationZh": "在数据实际被使用前提前读取，以减少访问等待。"
    },
    {
      "term": "standard deviations",
      "briefZh": "标准差",
      "explanationZh": "衡量测试结果围绕平均值的离散程度；数值越小，运行表现越稳定。"
    },
    {
      "term": "cold cache",
      "briefZh": "冷缓存",
      "explanationZh": "指缓存尚未存有需要的数据，首次访问时可能产生额外开销。"
    },
    {
      "term": "page cache warmup",
      "briefZh": "页缓存预热",
      "explanationZh": "通过初次访问将数据载入页缓存，使后续访问更稳定或更快。"
    },
    {
      "term": "perceived latency",
      "briefZh": "感知延迟",
      "explanationZh": "指用户实际感受到的响应等待时间，流式输出速度会影响这种体验。"
    }
  ],
