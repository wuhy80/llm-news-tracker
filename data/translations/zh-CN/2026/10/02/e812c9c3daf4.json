  "sourceTitle": "AI is changing developer work. Here are three skills to strengthen.",
  "sourceBodyHash": "cd98abe81edfe1ed80727bde4810aae047d955434b91f8cc88930ddb3f8d7296",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
