  "sourceTitle": "Add secure Web Search to Claude Desktop with Amazon Bedrock AgentCore",
  "sourceBodyHash": "fcfe1bd5795dfa8d4f41e2b71905389d4fa967a42c8aa6b8aace74b0a1f6f179",
  "sourceLanguage": "en",
