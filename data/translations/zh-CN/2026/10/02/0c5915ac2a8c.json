  "sourceTitle": "Chatham scales its capital markets expertise with OpenAI",
  "sourceBodyHash": "bb62d685f73cd10ca078afa971518f5e2b0266d2986eba6d6a303904f73f0717",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "complete",
  "importanceLevel": 5,
