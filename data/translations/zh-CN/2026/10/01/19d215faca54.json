  "sourceTitle": "One year later: Sovereign AI and the fight for choice",
  "sourceBodyHash": "efaa65307acee027c344e610b94bfed4faa6746190dca3332490220183251189",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
