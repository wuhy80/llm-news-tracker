  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "8eb24b5f822b53d9",
      "translationZh": "我们是 Institute of Foundation Models（IFM）的研究人员。这是一家 AI 研究实验室，致力于以开放、独立的方式开发前沿级基础模型。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0002",
      "kind": "paragraph",
      "sourceHash": "7cdd6c6144f72aee",
      "translationZh": "我们最近发布了 K2 Horizon，这是一个由六个相互关联、完全开放的模型组成的系列，规模从 0.9B 到 375B 不等。除了权重，我们还开源了训练数据和训练配方、训练代码、中间检查点、细粒度训练日志及评估结果。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0003",
      "kind": "paragraph",
      "sourceHash": "4b19e05a0e5f942c",
      "translationZh": "欢迎向我们提问，话题包括预训练和数据混合、后训练、端侧小模型、MoVA 和稀疏注意力、部署、目前已发布的内容，以及接下来的计划。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0004",
      "kind": "paragraph",
      "sourceHash": "3a098f5d249c183e",
      "translationZh": "参与本次 AMA（问我任何事）的人员：",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0006",
      "kind": "list-item",
      "sourceHash": "f7c29fb7197e2192",
      "translationZh": "亚历山大·莫雷诺 u/IFMAlex",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0007",
      "kind": "list-item",
      "sourceHash": "3a5ed8c51e3d2a3c",
      "translationZh": "米哈伊尔·尤罗奇金 u/my-moonfolk",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0011",
      "kind": "paragraph",
      "sourceHash": "182efb001e1b7d7d",
      "translationZh": "我们将于太平洋时间10月5日周一晚上8–10点进行实时互动。现在已开放提问，随时留下你的问题吧！",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    }
  ],
  "wordWise": [
    {
      "term": "foundation models",
      "briefZh": "基础模型",
      "explanationZh": "在大规模数据上训练、可作为多种下游任务基础的模型。"
    },
    {
      "term": "weights",
      "briefZh": "模型权重",
      "explanationZh": "模型通过训练学到的参数，用于决定其计算和输出。"
    },
    {
      "term": "intermediate checkpoints",
      "briefZh": "中间检查点",
      "explanationZh": "训练过程中在不同阶段保存的模型状态，可用于恢复训练或分析模型变化。"
    },
    {
      "term": "pre-training",
      "briefZh": "预训练",
      "explanationZh": "模型在大规模数据上进行初始训练、学习通用能力的阶段。"
    },
    {
      "term": "data mixes",
      "briefZh": "数据混合",
      "explanationZh": "训练时不同来源或类型数据的组合及其配比。"
    },
    {
      "term": "post-training",
      "briefZh": "后训练",
      "explanationZh": "预训练之后进一步调整模型，使其能力和行为更适合实际使用的训练阶段。"
    },
    {
      "term": "small models on-device",
      "briefZh": "端侧小模型",
      "explanationZh": "直接在用户设备上运行的小规模模型，而非依赖远程服务器执行。"
    },
    {
      "term": "sparse attention",
      "briefZh": "稀疏注意力",
      "explanationZh": "仅计算部分位置之间注意力关系的机制，用于减少计算和内存开销。"
    },
    {
      "term": "live",
      "briefZh": "实时互动",
      "explanationZh": "此处指在指定时段上线，与参与者实时交流。"
    },
    {
      "term": "PT",
      "briefZh": "太平洋时间",
      "explanationZh": "Pacific Time 的缩写，表示美国西海岸等地区使用的太平洋时区时间。"
    }
  ],
