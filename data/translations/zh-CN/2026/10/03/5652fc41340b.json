    },
    {
      "id": "b0105",
      "kind": "paragraph",
      "sourceHash": "486c3b8c1b7aaa35",
      "translationZh": "OpenAI 改进 COBOL、Fortran 和 VB 的构建与迁移（5.7K）",
      "provider": "nowcoding",
