    },
    {
      "id": "b0104",
      "kind": "paragraph",
      "sourceHash": "a7d6de6441862cf4",
      "translationZh": "前沿模型在一次攻击期间拒绝帮助 OpenCode（6.3K）",
      "provider": "nowcoding",
