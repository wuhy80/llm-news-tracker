    },
    {
      "id": "b0102",
      "kind": "paragraph",
      "sourceHash": "68a070cb437eeaab",
      "translationZh": "Anthropic 推出面向关键开源项目的 OSS Scanner（8.7K）",
      "provider": "nowcoding",
