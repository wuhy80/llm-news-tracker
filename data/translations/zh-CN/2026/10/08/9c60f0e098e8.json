  "wordWise": [
    {
      "term": "Latent Factorization",
      "briefZh": "潜在因子分解",
      "explanationZh": "将权重矩阵分解为潜在因子的表示，是文中实现超低比特压缩的核心方法。"
    },
    {
      "term": "Sub-1-Bit",
      "briefZh": "低于1比特",
      "explanationZh": "指模型权重的平均表示位数低于每个权重 1 比特。"
    },
    {
      "term": "Spectral Energy Gain",
      "briefZh": "谱能量增益",
      "explanationZh": "指谱能量的提升，是 LittleBit-2 标题中提出的最大化目标。"
    },
    {
      "term": "Latent Geometry Alignment",
      "briefZh": "潜在几何对齐",
      "explanationZh": "指对齐潜在表示的几何结构，文中将其用于提高谱能量增益。"
    },
    {
      "term": "Quantization",
      "briefZh": "量化",
      "explanationZh": "用较少的比特表示模型数值，以降低模型存储需求。"
    },
    {
      "term": "low-rank latent factors",
      "briefZh": "低秩潜在因子",
      "explanationZh": "由稠密权重矩阵分解得到的低秩表示，文中随后对其进行二值化。"
    },
    {
      "term": "binarizing",
      "briefZh": "二值化",
      "explanationZh": "将潜在因子的取值转换为两种值，以实现极低比特表示。"
    },
    {
      "term": "bits-per-weight",
      "briefZh": "每权重比特数",
      "explanationZh": "衡量模型压缩程度的指标，表示平均每个权重所需的比特数。"
    },
    {
      "term": "latent geometry misalignment",
      "briefZh": "潜在几何错位",
      "explanationZh": "指潜在空间中的几何结构未与量化所需的结构对齐，是此处初始化阶段要解决的问题。"
    },
    {
      "term": "Joint Iterative Quantization",
      "briefZh": "联合迭代量化",
      "explanationZh": "文中用于初始化的量化方法，与内部潜在空间旋转结合，使潜在因子与二值超立方体对齐。"
    },
    {
      "term": "binary hypercube",
      "briefZh": "二值超立方体",
      "explanationZh": "各维度取二值所形成的高维几何结构，是潜在因子在量化前的对齐目标。"
    },
    {
      "term": "inference overhead",
      "briefZh": "推理开销",
      "explanationZh": "模型执行推理时额外消耗的计算等资源；文中说明该初始化不会增加这类开销。"
    },
    {
      "term": "Quantization-Aware Training",
      "briefZh": "量化感知训练",
      "explanationZh": "在训练过程中考虑量化影响的训练方式，文中简称 QAT。"
    },
    {
      "term": "residual factorization",
      "briefZh": "残差因子分解",
      "explanationZh": "对残差进行因子分解，文中将其列为可选的训练支持功能。"
    },
    {
      "term": "SVD-only initialization",
      "briefZh": "仅用SVD初始化",
      "explanationZh": "仅使用奇异值分解（SVD）进行初始化的方式。"
    },
    {
      "term": "Multi-GPU",
      "briefZh": "多GPU",
      "explanationZh": "使用多个 GPU 执行计算任务，这里指模型训练。"
    },
    {
      "term": "checkpoint",
      "briefZh": "检查点",
      "explanationZh": "保存的模型状态，可用于恢复训练或进行评估。"
    },
    {
      "term": "CLI arguments",
      "briefZh": "命令行参数",
      "explanationZh": "通过命令行显式传入的参数，在这里具有最高加载优先级。"
    },
    {
      "term": "fallback",
      "briefZh": "回退方案",
      "explanationZh": "首选配置不可用时采用的备用配置来源，这里指较旧检查点的 config.json。"
    },
    {
      "term": "CC BY-NC 4.0 license",
