  "sourceTitle": "GPU - Vulkan llama.cpp benchmarks sorted by price to performance",
  "sourceBodyHash": "ad1045cd246ddb53535697e245c73d1c2a87130f87e9827be0d82aab1a402e96",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "partial",
