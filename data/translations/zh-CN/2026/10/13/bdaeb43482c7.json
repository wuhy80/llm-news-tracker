      "model": "gpt-6.1-sol"
    }
  ],
  "wordWise": [
    {
      "term": "decision models",
      "briefZh": "决策模型",
      "explanationZh": "文中对 d3 系列模型的称呼，作者询问了其量化敏感性及显存需求。"
    },
    {
      "term": "quantization",
      "briefZh": "量化",
      "explanationZh": "以较低精度表示模型权重等数值的方法，可减小存储和内存占用，但可能影响模型质量。"
    },
    {
      "term": "FIM",
      "briefZh": "中间填充",
      "explanationZh": "Fill-in-the-Middle 的缩写，指根据前后文补全中间缺失内容的任务或能力。"
    },
    {
      "term": "VRAM",
      "briefZh": "显存",
      "explanationZh": "GPU 使用的存储空间，可用于存放模型权重及运行时数据。"
    },
    {
      "term": "MoE",
      "briefZh": "混合专家",
      "explanationZh": "一种包含多个专家模块、每次计算仅激活其中部分专家的模型架构。"
    },
    {
      "term": "active experts",
      "briefZh": "激活的专家",
      "explanationZh": "MoE 模型在当前计算中实际选中并使用的专家模块。"
    },
    {
