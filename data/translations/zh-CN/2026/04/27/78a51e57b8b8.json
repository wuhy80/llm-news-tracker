    },
    {
      "id": "b0035",
      "kind": "paragraph",
      "sourceHash": "56cbd975d48b0948",
      "translationZh": "anonymize_screenshot — OCR、检测、文本区段 → 像素边界框",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0036",
      "kind": "paragraph",
      "sourceHash": "2a3587c819bc6503",
      "translationZh": "GET / + GET /examples/* 提供画布 UI 和预加载的示例",
      "provider": "nowcoding",
