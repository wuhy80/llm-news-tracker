    },
    {
      "term": "middleware",
      "briefZh": "中间件",
      "explanationZh": "在请求与响应的处理流程中执行通用逻辑的软件层。"
    },
    {
      "term": "SSE streaming",
      "briefZh": "SSE 流式传输",
      "explanationZh": "通过服务器发送事件机制，由服务器向客户端持续推送数据。"
    },
    {
      "term": "concurrency control",
      "briefZh": "并发控制",
      "explanationZh": "控制同时执行的请求或任务，避免后端资源过载。"
    },
    {
      "term": "concurrency management",
      "briefZh": "并发管理",
      "explanationZh": "控制多个请求同时执行的方式，避免它们争抢 GPU 等资源。"
    },
    {
      "term": "queuing engine",
      "briefZh": "排队引擎",
      "explanationZh": "将请求放入队列并安排其执行的机制，用于控制处理顺序和并发。"
    },
    {
      "term": "serialized",
      "briefZh": "串行处理",
      "explanationZh": "指请求依次执行，而不是同时执行。"
    },
    {
      "term": "bundler",
      "briefZh": "打包工具",
      "explanationZh": "将前端代码及其依赖整合为可部署文件的工具。"
    },
    {
      "term": "CSS z-index",
      "briefZh": "层叠顺序",
      "explanationZh": "用于控制元素的前后叠放顺序，此处用于排列背景、文字和前景三层。"
    },
    {
      "term": "pointer events",
      "briefZh": "指针事件",
      "explanationZh": "用于处理鼠标、触控或触控笔等指针输入的事件，此处用于拖放文字。"
    },
    {
      "term": "CSS perspective transforms",
      "briefZh": "透视变换",
      "explanationZh": "通过 CSS 变换呈现带有远近透视效果的三维视觉外观。"
    },
