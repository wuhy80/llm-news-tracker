  "sourceTitle": "Safetensors is Joining the PyTorch Foundation",
  "sourceBodyHash": "d6506b5fc567e0e69e7abad51ac29b9e7a45469e1179455a139aca5ba65a4dbc",
  "sourceLanguage": "en",
