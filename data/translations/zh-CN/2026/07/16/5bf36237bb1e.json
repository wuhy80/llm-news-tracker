  "sourceTitle": "Security incident disclosure — July 2026",
  "sourceBodyHash": "a195e5d49d0fbbf5668426cdf9e582caf0c8a17444e371d7065e0ca01bb70e4f",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
