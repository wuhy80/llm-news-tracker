    },
    {
      "term": "Native loading",
      "briefZh": "原生加载",
      "explanationZh": "通过框架自身提供的支持直接加载模型。"
    },
    {
      "term": "Benchmarks",
      "briefZh": "基准测试",
      "explanationZh": "用于评估和比较模型或实现性能的测试。"
    },
    {
      "term": "Quantizing",
