    },
    {
      "id": "b0121",
      "kind": "heading",
      "sourceHash": "c9015d53b9084645",
      "translationZh": "致谢",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0122",
      "kind": "paragraph",
      "sourceHash": "551ee2b256e8d7ba",
      "translationZh": "感谢 Diffusers 维护者在整个集成过程中提供的审阅和指导，也感谢 MIT HAN Lab / Nunchaku 团队开展的 SVDQuant 原始工作。感谢 Marc Sun 对这篇博客文章提供反馈。感谢 Álvaro Somoza 试用 nunchaku-lite 并提供反馈。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0123",
      "kind": "paragraph",
      "sourceHash": "2dd18659c9e1cae6",
