  "wordWise": [
    {
      "term": "data pipeline",
      "briefZh": "数据流水线",
      "explanationZh": "将原始数据经过汇集、处理等步骤，转化为可用于模型训练的数据的一整套流程。"
    },
    {
      "term": "VLM",
      "briefZh": "视觉语言模型",
      "explanationZh": "能够处理视觉与语言信息的模型，文中用于为图像重新生成文字描述。"
    },
    {
      "term": "streamable corpus",
      "briefZh": "可流式读取语料库",
      "explanationZh": "支持在训练过程中逐步读取数据、无需一次性加载全部内容的语料库。"
    },
    {
      "term": "pre-training",
      "briefZh": "预训练",
      "explanationZh": "通过大规模数据让模型学习广泛基础知识的训练阶段，文中强调其目标是视觉内容的覆盖面与多样性。"
    },
    {
      "term": "fine-tuning",
      "briefZh": "微调",
      "explanationZh": "在预训练之后使用特定数据进一步训练模型，文中用于提升生成结果的精致程度与审美表现。"
    },
    {
      "term": "preference alignment",
      "briefZh": "偏好对齐",
      "explanationZh": "调整模型，使其输出更符合期望偏好的训练过程，文中将其用于改善生成图像的审美。"
    },
    {
      "term": "Over-filtering",
      "briefZh": "过度筛选",
      "explanationZh": "对数据施加过于严格的筛选，文中指因过分追求美感而损失数据覆盖面和多样性。"
    },
    {
      "term": "deduplicated",
      "briefZh": "已去重",
      "explanationZh": "指数据源已经移除重复内容，避免对相同数据进行重复处理或训练。"
    },
    {
      "term": "NSFW content",
      "briefZh": "不宜公开内容",
      "explanationZh": "通常指不适合在工作场合或公共环境中查看的敏感内容，是数据过滤的对象之一。"
    },
