  "wordWise": [
    {
      "term": "post-training",
      "briefZh": "后训练",
      "explanationZh": "模型完成预训练后，通过进一步训练来调整其能力或行为的阶段。"
    },
    {
      "term": "abstraction",
      "briefZh": "抽象",
      "explanationZh": "在软件设计中提取共性、隐藏实现细节，以便用统一接口组织不同方法。"
    },
    {
      "term": "policy",
      "briefZh": "策略",
      "explanationZh": "强化学习中决定如何采取行动的机制，在这里对应生成输出的模型。"
    },
    {
      "term": "reference model",
      "briefZh": "参考模型",
      "explanationZh": "训练过程中用作比较基准的模型。"
    },
    {
      "term": "sampled rollouts",
      "briefZh": "采样轨迹",
      "explanationZh": "通过策略采样得到的生成过程或交互轨迹，用于后续评估和训练。"
    },
    {
      "term": "preference optimization",
      "briefZh": "偏好优化",
      "explanationZh": "利用对不同输出的偏好信息来优化模型的方法。"
    },
    {
      "term": "online RL",
      "briefZh": "在线强化学习",
      "explanationZh": "在训练过程中持续采集当前策略产生的数据，并据此更新策略的强化学习方式。"
    },
    {
      "term": "deterministic checks",
      "briefZh": "确定性检查",
      "explanationZh": "依照固定规则进行的检查，相同输入会得到相同的检查结果，可用于提供奖励。"
    },
    {
      "term": "Reward models",
      "briefZh": "奖励模型",
      "explanationZh": "对模型输出进行评价并提供奖励信号的模型；文中讨论了其在不同训练方法中的地位变化。"
    },
    {
      "term": "verifiers",
      "briefZh": "验证器",
      "explanationZh": "用于检查输出是否满足要求的机制，可以是确定性函数，而不一定是学习得到的模型。"
    },
    {
      "term": "breaking change",
      "briefZh": "破坏性变更",
      "explanationZh": "可能使依赖旧接口或旧行为的下游代码无法正常工作的变更。"
    },
    {
      "term": "semantic versioning",
      "briefZh": "语义化版本控制",
      "explanationZh": "通过版本号表达变更类型及兼容性影响的版本管理约定。"
    },
    {
      "term": "contracts",
      "briefZh": "契约",
      "explanationZh": "库向使用者明确提供的接口行为、兼容性和稳定性承诺。"
    },
    {
      "term": "downstream project",
      "briefZh": "下游项目",
      "explanationZh": "依赖当前库或组件构建的项目，可能受到其接口或行为变更的影响。"
    },
    {
      "term": "maintenance cost",
      "briefZh": "维护成本",
      "explanationZh": "为使方法或代码持续可用而投入的修复、适配和维护资源。"
    },
    {
      "term": "Reward modeling",
      "briefZh": "奖励建模",
      "explanationZh": "训练模型来评估输出并提供奖励信号，为后续优化提供依据。"
    },
    {
      "term": "breaking changes",
      "briefZh": "破坏性变更",
      "explanationZh": "不兼容既有用法、可能要求使用者修改代码的变更。"
    },
    {
      "term": "abstractions",
      "briefZh": "抽象",
      "explanationZh": "将具体实现中的共同结构提炼为可复用接口或机制的设计方式。"
    },
    {
      "term": "generic class hierarchies",
      "briefZh": "通用类层次结构",
      "explanationZh": "为覆盖多种使用情形而设计的通用类继承层级。"
    },
    {
      "term": "explicit implementations",
      "briefZh": "显式实现",
      "explanationZh": "将具体行为直接写明的实现方式，而不是依赖隐式机制或统一抽象。"
    },
    {
      "term": "base class",
      "briefZh": "基类",
      "explanationZh": "供其他类继承、用于共享接口或行为的类。"
    },
    {
      "term": "indirection",
      "briefZh": "间接层",
      "explanationZh": "通过中间抽象访问具体实现的机制；文中指增加复杂度却未带来价值的层次。"
    },
    {
      "term": "code duplication",
      "briefZh": "代码重复",
      "explanationZh": "在不同实现中保留相同或相近的代码；本文将其视为换取显式性和可修改性的可接受代价。"
    },
    {
      "term": "anti-pattern",
      "briefZh": "反模式",
      "explanationZh": "通常被认为会造成设计或维护问题、应当避免的做法。"
    }
