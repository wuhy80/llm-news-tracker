    },
    {
      "id": "b0061",
      "kind": "paragraph",
      "sourceHash": "ace91f0ae25e60b5",
      "translationZh": "🟡 仅支持 LoRA",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
