  "sourceTitle": "Introducing Storage Buckets on the Hugging Face Hub",
  "sourceBodyHash": "e5873eb5b4ed3754c461c42234b62081c1585e89976eaf0e6c776437953b2abe",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
