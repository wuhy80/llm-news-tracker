  "sourceTitle": "How Cooley is accelerating IPO work with ChatGPT",
  "sourceBodyHash": "981564a42bf110e3a603b221387d792fad2d8eb5b9e4674d4bc3f892586489d0",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
