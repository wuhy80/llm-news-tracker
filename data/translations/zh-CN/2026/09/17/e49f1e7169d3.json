  "sourceTitle": "How MRH Trowe enabled secure self-service AI agents in financial services",
  "sourceBodyHash": "3eb635633e799fa1b56dc2401f355b23f2348a908e5234b71970170b436dda81",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
