  "sourceTitle": "Enhancing industrial safety AI with synthetic data on Amazon SageMaker AI",
  "sourceBodyHash": "d8df9d0e3458bda4912724447a73798ea8bd96d2cd32571648c7785d3ee3ad68",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
