  "blocks": [
    {
      "id": "b0001",
      "kind": "list-item",
      "sourceHash": "445671224219a1f3",
      "translationZh": "在多个权限请求堆叠时，在权限提示中添加了类似“2/5”的计数",
      "provider": "groq",
      "model": "openai/gpt-oss-120b"
    },
    {
      "id": "b0002",
      "kind": "list-item",
      "sourceHash": "ae7ad15b06ef3957",
      "translationZh": "为全屏模式下列表的“还有 N 行”添加了鼠标支持：点击任意一行即可跳转到该列表的末尾，并具备悬停和按下状态。",
      "provider": "groq",
      "model": "openai/gpt-oss-120b"
    },
    {
      "id": "b0003",
      "kind": "list-item",
      "sourceHash": "82bb80c399a715eb",
      "translationZh": "修复了多个 Claude Code 进程和 IDE 扩展在 gcpAuthRefresh 或 awsAuthRefresh 凭证过期时会打开登录浏览器的问题",
      "provider": "groq",
      "model": "openai/gpt-oss-120b"
    },
    {
      "id": "b0004",
      "kind": "list-item",
      "sourceHash": "d4a43243ed1347db",
      "translationZh": "固定了 claude 的 --resume 和 --continue 参数在一批并行工具调用后有时会在早期会话崩溃或被终止后丢失每一次回合",
      "provider": "groq",
      "model": "openai/gpt-oss-120b"
    },
    {
      "id": "b0005",
      "kind": "list-item",
      "sourceHash": "f25676cac27a2b3b",
      "translationZh": "在工具或钩子返回对象、数字或布尔值而非文本时（包括在恢复的会话中），已修复 API 400 错误",
      "provider": "groq",
      "model": "openai/gpt-oss-120b"
    },
    {
      "id": "b0006",
      "kind": "list-item",
      "sourceHash": "b6e18adf20b48f32",
      "translationZh": "已修复云会话在历史记录非常庞大时无法唤醒的问题，因为在转录仍在加载时容器被停止",
      "provider": "groq",
      "model": "openai/gpt-oss-120b"
    },
    {
      "id": "b0007",
      "kind": "list-item",
      "sourceHash": "6934e9d41c276026",
      "translationZh": "将 Claude 应用网关的消费计量器的 1 小时提示缓存写入费用调整为更便宜的 5 分钟费率，并且在运行服务器端工具（例如网络搜索）的流式回合中，仅计算首次模型调用的输入令牌。",
      "provider": "groq",
      "model": "openai/gpt-oss-120b"
    },
    {
      "id": "b0008",
      "kind": "list-item",
      "sourceHash": "c7f19bc196d6964c",
      "translationZh": "当残留的 ~/.claude/.credentials.json 文件存在时，即使在另一个 Claude Code 窗口中 /login 已成功，固定的 macOS 会话仍会显示“未登录”或“登录已过期”。",
      "provider": "groq",
      "model": "openai/gpt-oss-120b"
    },
    {
      "id": "b0009",
      "kind": "list-item",
      "sourceHash": "f66439ea55d282b9",
      "translationZh": "修复了每当 Anthropic API 拒绝模型（无论是默认模型还是模型别名解析到的模型）时导致的回合失败问题：Claude Code 现在会在同一层级的前一个模型上重试一次",
      "provider": "groq",
      "model": "openai/gpt-oss-120b"
    },
    {
      "id": "b0010",
      "kind": "list-item",
      "sourceHash": "3a280ab77d7ce5ed",
      "translationZh": "固定的远程控制会话（包括 Claude 远程控制）在组织的策略关闭远程控制后仍保持连接；现在它们会在出现通知时断开",
      "provider": "groq",
      "model": "openai/gpt-oss-120b"
    },
    {
      "id": "b0011",
      "kind": "list-item",
      "sourceHash": "3756abcbcacd3099",
      "translationZh": "固定的拒绝和--fallback-model 重试在回退模型无法快速运行时会失败；现在它们将在标准速度下运行，并在交互式会话中提供一次性通知",
      "provider": "groq",
      "model": "openai/gpt-oss-120b"
    },
    {
      "id": "b0013",
      "kind": "list-item",
      "sourceHash": "c8c63fa8081fe853",
      "translationZh": "修复了 Claude 授权状态报告，将控制台登录的存储 API 密钥显示为 claude.ai；现在显示为 api_key，且 VS Code 扩展将该会话视为 API 密钥会话",
      "provider": "groq",
      "model": "openai/gpt-oss-120b"
    },
    {
      "id": "b0015",
      "kind": "list-item",
      "sourceHash": "2270e0541f295873",
      "translationZh": "修复了远程控制发送的消息中附加的文件未到达时未通知 Claude 的问题，以及文件有时仅获得 10 秒进行最后一次下载尝试的情况。",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0016",
      "kind": "list-item",
      "sourceHash": "fbba810c38b64814",
      "translationZh": "修复了 Claude Code 退出时到达的远程控制消息被标记为已送达但从未被回答的问题；现在它会保持在队列中，等待会话的下次运行。",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0017",
      "kind": "list-item",
      "sourceHash": "aba6b3402d9ad18d",
      "translationZh": "修复了当 \"Bearer\" 或 \"Basic\" 出现在其键名之前时，MCP 错误消息显示凭据值的问题。",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0018",
      "kind": "list-item",
      "sourceHash": "303ce7aec44a640e",
      "translationZh": "修复了错误消息中百分号编码的 Bearer 令牌仅被部分遮蔽的问题。",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0019",
      "kind": "list-item",
      "sourceHash": "86cd874364b29429",
      "translationZh": "修复了已屏蔽的日志和记录显示包含不可见字符（如零宽空格）的密钥名称的机密的问题。",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0020",
      "kind": "list-item",
      "sourceHash": "e290bf7559d13f60",
      "translationZh": "修复了日志和记录显示 URL 密码部分包含标点符号（如 ) , 引号, ] , & 或第二个 @），或显示在 ssh URL 中跨越 / 到括号主机（如 [::1]）的问题。",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0021",
      "kind": "list-item",
      "sourceHash": "adae6fab988c66ce",
      "translationZh": "修复了 /feedback 保存到磁盘的 zip 文件中的会话记录在屏蔽机密后包含无效 JSON 行的问题。",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0022",
      "kind": "list-item",
      "sourceHash": "ecd2bdd55d529125",
      "translationZh": "修复了 MCP 连接器在其服务器放弃旧 MCP 握手后长达一天不列出工具的问题。",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0023",
      "kind": "list-item",
      "sourceHash": "f922f95f2f767030",
      "translationZh": "修复了 Claude 发出的重复 MCP 登录请求，该请求替换了待处理的登录链接，导致该链接无法工作",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0024",
      "kind": "list-item",
      "sourceHash": "6f69755a03b225e0",
      "translationZh": "修复了在使用 /usage 时，对于在 MCP 服务器仍在连接或刚刚连接后（例如重启后立即）进行的工具调用，未向该 MCP 服务器计费的问题",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0025",
      "kind": "list-item",
      "sourceHash": "a4623740541ef822",
      "translationZh": "修复了在瞬态服务器错误后，在 claude.ai 上启用的插件有时会在 Claude Code 的一个会话中消失的问题",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0026",
      "kind": "list-item",
      "sourceHash": "974696f102f0fab1",
      "translationZh": "修复了在子代理读取消息后，在正在运行的子代理中输入的消息在其记录中显示两次的问题",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0027",
      "kind": "list-item",
      "sourceHash": "971e8cad1c82f27a",
      "translationZh": "修复了当子代理没有注册名称时，子代理移交消息显示原始任务 ID 而不是代理名称的问题",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0028",
      "kind": "list-item",
      "sourceHash": "9f26394f60bb7cb6",
      "translationZh": "修复了在启用了这些工具的会话中，前台子代理有时会缺少任务跟踪工具（TaskCreate/Get/Update/List, TodoWrite）的问题",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0029",
      "kind": "list-item",
      "sourceHash": "6aa7f43a89147639",
      "translationZh": "修复了使用工作树隔离生成的子代理在首次文件读取时，从工作树副本加载项目 CLAUDE.md 及其导入内容两次的问题",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0030",
      "kind": "list-item",
      "sourceHash": "48e6c8eb145ccce0",
      "translationZh": "修复了在响应中途连接停滞几分钟时，工作流工具子代理从其原始提示重新启动的问题",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    }
  ],
