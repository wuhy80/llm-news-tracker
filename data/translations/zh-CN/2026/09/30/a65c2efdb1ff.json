  "sourceTitle": "Disrupting a coordinated model-distillation campaign",
  "sourceBodyHash": "706bd08e394e2a1f3b86f97f14cb4590d03ee5bb9a44dca9636c22a043f0691d",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
