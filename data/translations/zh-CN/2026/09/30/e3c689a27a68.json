  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "a68dc4cefc9585aa",
      "translationZh": "我们在实验室里使用了一台 Dell B300 几周，并用它为 Qwen Flash Next 创建了两个微调版本。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0002",
      "kind": "paragraph",
      "sourceHash": "6ee5450122ca59b4",
      "translationZh": "Victoria（编程与智能体）",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0003",
      "kind": "list-item",
      "sourceHash": "c439e6bb47d3abc6",
      "translationZh": "使用一种名为 REAP 的论文/技术，将 Qwen3.8-Flash-Next 削减了 44%：每层从 512 降至 288。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0004",
      "kind": "list-item",
      "sourceHash": "eab0287f08f4c475",
      "translationZh": "随后以 4-bit (NVFP4) 进行重新训练，因此它是针对其交付格式进行训练的，而不仅仅是在事后进行量化。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0005",
      "kind": "list-item",
      "sourceHash": "dee095e9b651e701",
      "translationZh": "Terminal-Bench 2.1：70.0%，这是在每个任务 8 小时超时限制下，3 次运行的平均值。我们之前的 NVFP4 版本得分为 62.5%。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0006",
      "kind": "list-item",
      "sourceHash": "be530fc167b16bcd",
      "translationZh": "48.0 GiB 的权重，包括草稿头（draft head）。95.4 GiB 的 n-gram 表是独立的，不计入该数值中。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0007",
      "kind": "list-item",
      "sourceHash": "3bac88b3d2a106e9",
      "translationZh": "在单台 B300 上使用草稿头时，单流速度为 280 tok/s，而不使用草稿头时为 135 tok/s。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0008",
      "kind": "list-item",
      "sourceHash": "00bc6ea263594300",
      "translationZh": "GGUF Q4_K_M 为 49.17 GiB。它在 Terminal-Bench 上得分为 75.3%（单次运行，因此视为有噪声），在 HumanEval 上得分为 93.2%（5 次运行的平均值）。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    }
  ],
