  "sourceTitle": "Two open-weights releases: Victoria (Qwen3.8-Flash-Next with 44% of experts cut, 70% Terminal-Bench 2.1, GGUF included) and Maple (a Canada-first fine-tune)",
  "sourceBodyHash": "a199f2403aee81c1c6199c6e037f0d2412b043d41d77009f2699900093cae02a",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "complete",
  "importanceLevel": 5,
  "provider": "groq",
