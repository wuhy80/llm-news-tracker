  "sourceTitle": "7900 XTX — two \"low-thinking\" Qwen 3.8 27B quants (Swift + ThinkingCap) vs the regular quant",
  "sourceBodyHash": "19512991c50a6e18257b00f5ca0f79e4bc148d9f1ea435c00a1fe9bcff804140",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
