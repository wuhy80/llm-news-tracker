  "sourceTitle": "When chat is the wrong UI",
  "sourceBodyHash": "9533f4d12fb5e33c2cac76f817866386be238e3f0df1e6a1c1f1c53e3bf9dc75",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
