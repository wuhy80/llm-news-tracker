      "provider": "gemini",
      "model": "gemini-3.5-flash-lite"
    },
    {
      "id": "b0014",
      "kind": "paragraph",
      "sourceHash": "cd0db7db8fe2b2d6",
      "translationZh": "隐藏状态投影",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0015",
      "kind": "paragraph",
