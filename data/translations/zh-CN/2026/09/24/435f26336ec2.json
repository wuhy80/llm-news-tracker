    },
    {
      "id": "b0016",
      "kind": "paragraph",
      "sourceHash": "5627036a52c4d50a",
      "translationZh": "马尔可夫头",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0017",
      "kind": "paragraph",
      "sourceHash": "e5e6dbb9c2c2c81d",
