  "sourceBodyHash": "25aaee8e6e47cafb7a242a82d8107f69e04058942f88d847feda4f463ceee9c3",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
