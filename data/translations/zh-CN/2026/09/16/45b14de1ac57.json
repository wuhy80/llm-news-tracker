    {
      "id": "b0017",
      "kind": "list-item",
      "sourceHash": "0f0bce8b51baaa54",
      "translationZh": "从 Rust 获取 Hugging Face 模型、分词器和数据集",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0018",
      "kind": "list-item",
