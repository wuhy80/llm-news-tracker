  "sourceTitle": "Hex turns complex analysis into visual reports with GPT‑6 Astra",
  "sourceBodyHash": "df3cc9290e566ba9e949172e89046fef298b90283df7199f2fe47e345336075a",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
