  "wordWise": [
    {
      "term": "inference engine",
      "briefZh": "推理引擎",
      "explanationZh": "加载并运行训练好的模型，根据输入计算输出的软件。"
    },
    {
      "term": "hybrid sliding-window attention",
      "briefZh": "混合滑窗注意力",
      "explanationZh": "结合滑动窗口内的局部注意力与全注意力的机制。"
    },
    {
      "term": "RoPE",
      "briefZh": "旋转位置编码",
      "explanationZh": "通过旋转变换将位置信息引入注意力计算的位置编码方法。"
    },
    {
      "term": "BPE tokenizer",
      "briefZh": "BPE 分词器",
      "explanationZh": "使用字节对编码，将文本拆分为模型可处理的 token 的分词器。"
    },
    {
      "term": "GEMM/GEMV kernels",
      "briefZh": "矩阵运算内核",
      "explanationZh": "执行通用矩阵乘矩阵和矩阵乘向量运算的底层计算实现。"
    },
    {
      "term": "W8A8 quantization",
      "briefZh": "权重激活八位量化",
      "explanationZh": "将权重和激活值都量化为 8 位表示；这里权重按通道量化，激活值按 token 量化。"
    },
    {
      "term": "pan & scan",
      "briefZh": "平移与扫描",
      "explanationZh": "对图像的不同区域进行裁剪和处理，以适配宽高比较大的图像。"
    },
    {
      "term": "mmap",
      "briefZh": "内存映射",
      "explanationZh": "将文件映射到进程地址空间的机制，此处用于加载模型权重。"
    },
    {
      "term": "KV-cache",
      "briefZh": "键值缓存",
      "explanationZh": "缓存注意力计算中的键和值，供后续生成复用，避免重复计算。"
    },
    {
      "term": "chunked prefill",
      "briefZh": "分块预填充",
      "explanationZh": "将输入文本分成多个块进行预填充处理，而非一次处理全部输入。"
    },
    {
      "term": "top-k",
      "briefZh": "前 k 项采样",
      "explanationZh": "将下一词元的采样候选限制为概率最高的 k 个词元。"
    },
    {
      "term": "top-p",
      "briefZh": "核采样",
      "explanationZh": "从累计概率达到阈值 p 的高概率词元集合中采样。"
    },
    {
      "term": "repetition penalty",
      "briefZh": "重复惩罚",
      "explanationZh": "对已出现词元施加惩罚，以减少生成内容中的重复。"
    },
    {
      "term": "dtype",
      "briefZh": "数据类型",
      "explanationZh": "指定权重等数值数据的表示类型；此处在编译时选择，作者计划改为运行时分派。"
    },
    {
      "term": "checkpoints",
      "briefZh": "检查点",
      "explanationZh": "保存的模型参数文件，可用于加载模型或转换为其他格式。"
    },
    {
      "term": "vision tower",
      "briefZh": "视觉塔",
      "explanationZh": "模型中负责处理图像并提取视觉特征的组件。"
    },
    {
