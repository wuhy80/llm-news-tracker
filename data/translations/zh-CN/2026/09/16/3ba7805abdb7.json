  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "beaa3a61575cc200",
      "translationZh": "我在单个 .c 文件中从零编写了一个用于 Google 的 Gemma 系列的推理引擎，包括多模态支持。没错，你可以发送图片 :D",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0002",
      "kind": "paragraph",
      "sourceHash": "de488867ac24d1f8",
      "translationZh": "不用 llama.cpp，不用 ggml，没有外部依赖，transformer、混合滑动窗口注意力、RoPE、int8 量化、BPE 分词器、SigLIP 视觉编码器、图像解码器/缩放器以及平移与扫描全部手动实现（图像解码器和缩放器是 stb_image.h 和 stb_image_resize2.h 的压缩/精简版本，基本上就是嵌在源代码里的一大块代码）。灵感来自 karpathy/llama2.c，但面向整个 Gemma 1/2/3 系列（包括多模态）。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0003",
      "kind": "paragraph",
      "sourceHash": "cbefdfa4c3aa8ba8",
      "translationZh": "Gemma 1 / 2 / 3，支持纯文本和多模态（包含 SigLIP 视觉塔）",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0004",
      "kind": "paragraph",
      "sourceHash": "a04cec5360e07e54",
      "translationZh": "单个 .c 文件，纯 C，用一条 gcc/clang/msvc 命令即可构建",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "00c35b735bf0bb55",
      "translationZh": "手写 GEMM/GEMV 内核（fp32/fp16/bf16 + W8A8），采用分块处理和 OpenMP",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0006",
      "kind": "paragraph",
      "sourceHash": "f848ba8a30111e20",
      "translationZh": "W8A8 量化（逐通道权重、逐 token 激活值）",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0007",
      "kind": "paragraph",
      "sourceHash": "5a3a203bf9916861",
      "translationZh": "混合滑动窗口注意力 + 全注意力（Gemma 2/3），采用 FlashAttention 风格的因果分块",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0008",
      "kind": "paragraph",
      "sourceHash": "6b791fd6d436846a",
      "translationZh": "完整的 SigLIP 视觉编码器 + 针对高宽高比图像的平移与扫描",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0009",
      "kind": "paragraph",
      "sourceHash": "af539d384b8bad84",
