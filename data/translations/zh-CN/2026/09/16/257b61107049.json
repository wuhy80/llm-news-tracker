    },
    {
      "id": "b0044",
      "kind": "list-item",
      "sourceHash": "6762720c6cf57df6",
      "translationZh": "/dream 将近期笔记整理到主题文件中，例如 topics/testing.md 。Dream 也会定期在后台自行运行。",
      "provider": "nowcoding",
