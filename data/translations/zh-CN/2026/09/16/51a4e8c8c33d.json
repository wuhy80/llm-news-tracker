  "sourceTitle": "Reimagining advertising with AI",
  "sourceBodyHash": "15719fbe29edaf8b3ea8856c544771e8703213b755a3a52accb6c66fc9713a8a",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
