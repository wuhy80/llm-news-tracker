      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "09082b448763ea39",
      "translationZh": "运行 Qwen3.8-next-flash Autoround W4A16 时，解码功耗为 500-600w",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
