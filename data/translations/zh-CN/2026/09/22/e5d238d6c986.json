  "sourceTitle": "Better prompt caching for GPT-6",
  "sourceBodyHash": "1629b281b48e62a13242b0c4094b3724ba2fa8ac00f73685d033fd7a588e5c9a",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
