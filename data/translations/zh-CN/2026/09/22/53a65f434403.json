  "sourceTitle": "Right-size generative AI endpoints with concurrency sweeps on Amazon SageMaker AI",
  "sourceBodyHash": "86eff64bc95a9d98dd7f3ad634d962c8961905ad2b7246cdfdd25631b9f4a170",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "partial",
  "importanceLevel": 4,
  "provider": "nowcoding",
