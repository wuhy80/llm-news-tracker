    }
  ],
  "wordWise": [
    {
      "term": "quants",
      "briefZh": "量化模型",
      "explanationZh": "指经过量化处理以减少模型参数大小和计算复杂度的模型版本。"
    },
    {
      "term": "checkpoints",
      "briefZh": "检查点",
      "explanationZh": "指保存模型训练状态或权重的文件。"
    },
    {
