    },
    {
      "term": "quantization kernel",
      "briefZh": "量化内核",
      "explanationZh": "专门用于处理量化数据计算的优化算子。"
    },
    {
      "term": "dequantizing",
      "briefZh": "反量化",
      "explanationZh": "将量化后的低精度数据还原为高精度数据的过程。"
    },
    {
      "term": "chat template",
      "briefZh": "聊天模板",
      "explanationZh": "用于将对话历史格式化为模型可理解输入的预定义模板。"
    },
    {
      "term": "OpenAI-compatible provider",
      "briefZh": "OpenAI 兼容提供商",
      "explanationZh": "指能够使用与 OpenAI API 相同的接口协议的服务提供方。"
    },
    {
      "term": "dense model",
      "briefZh": "稠密模型",
      "explanationZh": "指模型中所有参数在每次推理时都会被激活的模型架构。"
    },
    {
      "term": "mixture-of-experts model",
      "briefZh": "混合专家模型",
      "explanationZh": "一种通过仅激活部分参数来提高计算效率的模型架构（MoE）。"
    },
    {
      "term": "token-generation rate",
      "briefZh": "Token 生成率",
      "explanationZh": "衡量模型每秒能够生成多少个 token 的速度指标。"
    },
    {
      "term": "prefill",
      "briefZh": "预填充",
      "explanationZh": "在生成式推理中，处理输入提示词（prompt）并将其转换为 KV 缓存的过程。"
    },
    {
      "term": "decode-only throughput",
      "briefZh": "仅解码吞吐量",
      "explanationZh": "指在处理完输入后，仅针对生成阶段（解码阶段）的每秒处理能力。"
    },
    {
      "term": "model definition",
      "briefZh": "模型定义",
      "explanationZh": "指通过代码描述模型的架构、层级结构和参数配置的过程。"
    },
    {
      "term": "intermediate activations",
      "briefZh": "中间激活值",
      "explanationZh": "神经网络在处理输入数据时，各层神经元输出的中间计算结果。"
    }
