  "sourceTitle": "Introducing GPT-6 Sol and Luna",
  "sourceBodyHash": "f9fac0d3d41df138805098a1bc552724f2878dbe4c62d026cbb904ca54945002",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "partial",
  "importanceLevel": 5,
