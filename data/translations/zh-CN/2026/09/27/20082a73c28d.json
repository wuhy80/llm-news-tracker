      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0021",
      "kind": "list-item",
      "sourceHash": "27e62a7cfc3c738d",
      "translationZh": "Q5_K_M — 19 GiB 以下的折中方案",
      "provider": "bigmodel",
