    },
    {
      "id": "b0022",
      "kind": "list-item",
      "sourceHash": "4f34b9539b3ea861",
      "translationZh": "IQ1_M — 最小的已发布工件",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0023",
      "kind": "list-item",
      "sourceHash": "d1b813e7b09ada1d",
      "translationZh": "IQ2_S — 低占用选项，Mean KLD 略低",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0024",
      "kind": "paragraph",
      "sourceHash": "51659dab08f847ab",
      "translationZh": "最小的发布版本是 VeriLoop-E2-IQ1_M.gguf：",
      "provider": "bigmodel",
      "model": "glm-4.7-flash"
    },
    {
      "id": "b0025",
      "kind": "list-item",
