  "sourceTitle": "Fine-tuning a 350M Model for Better Structured Outputs in 100 GRPO Steps",
  "sourceBodyHash": "22cd2994363b7f2231ba62f637cc6efbc49678d64cb80bc38c2db6825f3822c0",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
