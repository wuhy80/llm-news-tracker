  "sourceTitle": "AI Agents in Customer Service Compared",
  "sourceBodyHash": "dfffb9181352178a969ee48af89fe7828d4240769747c8df8eee7199eaeb1398",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
