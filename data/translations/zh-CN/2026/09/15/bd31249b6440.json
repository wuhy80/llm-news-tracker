  "totalBlocks": 27,
  "translatedBlocks": 13,
  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "e49d60b0cf5efabc",
      "translationZh": "今天，我们正式推出 Meta One：这是一项全新的订阅服务，旨在为数十亿人已经在使用的应用程序和体验带来更多价值——并针对个人、创作者和企业推出了相应的计划。",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0002",
      "kind": "paragraph",
      "sourceHash": "9219eb51b7b6ddab",
      "translationZh": "Meta One 为订阅者提供了更多的自我表达功能和 AI 使用权限，帮助创作者将更多时间花在创作上，减少猜测的时间，并为商家提供了旨在帮助其增长的新工具。我们应用和 Meta AI 的核心体验一直是免费的，这一点不会改变。订阅解锁了更专业的功能和扩展的 AI 使用权限，这些超出了为数十亿人打造的免费体验所能提供的范围。",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0003",
      "kind": "paragraph",
      "sourceHash": "d09c975cb6e95656",
      "translationZh": "我们正以超过50项功能在Instagram、Facebook、WhatsApp和Meta AI上推出，并将在未来逐步扩展至Edits、AI眼镜等更多平台。",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0004",
      "kind": "heading",
      "sourceHash": "a22db52551159741",
      "translationZh": "面向个人用户和 AI 重度用户的方案",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "47aed54ece0bd677",
      "translationZh": "今年早些时候，我们推出了 Meta One 单产品计划——Instagram Plus、Facebook Plus 和 WhatsApp Plus——提供独家新功能，让用户在 Instagram 和 Facebook 上实现更多的连接与创意，在 WhatsApp 上实现更多的整理与个性化。",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0014",
      "kind": "paragraph",
      "sourceHash": "3b16e568cc189a62",
      "translationZh": "Meta One 方案现已在全球范围内推出，单项产品每月仅需 2.99 美元起，个人组合包每月 7.99 美元起，创作者和商业组合包每月 14.99 美元起。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0015",
      "kind": "list-item",
      "sourceHash": "938b7e91e50704a4",
      "translationZh": "Instagram Plus (3.99/月)：表达自我，与朋友进行更深层次的联系，并以全新的方式定制您的体验。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0016",
      "kind": "list-item",
      "sourceHash": "c9f094abc7d4b6e4",
      "translationZh": "WhatsApp Plus (2.99/月)：通过专属主题、图标、特效贴纸以及置顶更多聊天记录的功能，保持井然有序并展现您的个性。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0017",
      "kind": "list-item",
      "sourceHash": "f8305527cee1960a",
      "translationZh": "Facebook Plus (3.99/月)：让 Facebook 成为您的专属，并通过自定义应用图标、超级爱心等功能大幅提升您的体验。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0018",
      "kind": "paragraph",
      "sourceHash": "43f1d783618c5fa8",
      "translationZh": "面向个人和 AI 高级用户的组合方案",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0019",
      "kind": "list-item",
      "sourceHash": "5efd7e44709d99fe",
      "translationZh": "Core (7.99/月)：为 Instagram 上的更多 Story 进行重新设计，更频繁地使用语音效果和创意工具，并使用 Meta AI 生成更多的图像和视频。此外，还可以通过我们的个人应用功能（Instagram Plus、WhatsApp Plus、Facebook Plus）以更多方式表达自我。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0020",
      "kind": "list-item",
      "sourceHash": "f3e17db272812fcb",
      "translationZh": "Premium (19.99/月)：包含 Core 方案的所有内容，并为使用 Meta AI 以及在我们系列应用中创作内容提供最大的空间。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0021",
      "kind": "paragraph",
      "sourceHash": "18758a009962ca30",
      "translationZh": "面向企业和创作者的组合方案",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    }
  ],
