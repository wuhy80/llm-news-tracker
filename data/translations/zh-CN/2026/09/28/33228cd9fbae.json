      "sourceHash": "2e53f8cf72b3fcb3",
      "translationZh": "测试 Qwen HyperQwen 快速 Swift 1.0 Swift 1.5 INT8 头 Swift 1.5 INT4 头",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
