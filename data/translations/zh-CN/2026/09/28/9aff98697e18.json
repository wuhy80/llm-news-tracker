  "sourceTitle": "The road to the agentic browser: A Kitesurf update",
  "sourceBodyHash": "f8d080edbe5e808d855ab85a0366b008bafc510c61fd86d16926ef9985fb0605",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
