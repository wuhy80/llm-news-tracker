  "wordWise": [
    {
      "term": "quota",
      "briefZh": "配额",
      "explanationZh": "指 AWS 服务中可用的资源数量限制，如实例类型的使用配额。"
    },
    {
      "term": "instance-types",
      "briefZh": "实例类型",
      "explanationZh": "指 SageMaker 端点池中可选择的 EC2 实例规格，如 ml.g6.xlarge 等。"
    },
    {
      "term": "endpoint",
      "briefZh": "端点",
      "explanationZh": "指 SageMaker 提供的用于推理的 HTTP 接口，可创建和调用。"
    },
