    },
    {
      "id": "b0045",
      "kind": "list-item",
      "sourceHash": "9031216192a2639e",
      "translationZh": "在 SageMaker AI 上使用 vLLM-Omni 生成图像和视频 – 第二部分。",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
