  "sourceTitle": "Education Report: How educators use Claude",
  "sourceBodyHash": "14404ed9f2866927ec426de2fddc3608a379b113945f116537d549b7845415ff",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
