  "wordWise": [
    {
      "term": "LoRA adapter",
      "briefZh": "LoRA 适配器",
      "explanationZh": "一种低秩自适应参数，用于高效微调大型语言模型。"
    },
    {
      "term": "rank-1",
      "briefZh": "秩为1",
      "explanationZh": "指 LoRA 矩阵的秩（rank）极低，仅为 1。"
    },
    {
