  "blocks": [
    {
      "id": "b0001",
      "kind": "list-item",
      "sourceHash": "3ae442adff0eefba",
      "translationZh": "已添加到 Claude 应用网关：通过 gateway.yaml 中设置的定价，已登录的 Claude Code 客户端将通过托管设置接收相同的费率，因此 /cost 和遥测数据与支出计量保持一致",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0002",
      "kind": "list-item",
      "sourceHash": "4d14260f8ddc1eab",
      "translationZh": "当 access_control.allow_cidrs 为空时，为网关添加了启动警告；并在首次收到来自公共地址的请求时，添加了一次性警告。",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0003",
      "kind": "list-item",
      "sourceHash": "9aedf0d9fc898af8",
      "translationZh": "新增了 gatewayInternalNetworks 托管设置，允许管理员将 /login 指向其组织自有公共 IPv4 地址块上的 Claude 应用网关。",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0004",
      "kind": "list-item",
      "sourceHash": "eb38102de0c4c6f0",
      "translationZh": "新增 claude self-hosted-runner --remove-session-state（默认关闭）：会话结束时删除 <base-dir>/_sessions/ 下每个会话的专属目录",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0005",
      "kind": "list-item",
      "sourceHash": "57e81dac420a10db",
      "translationZh": "在 claude auth status --json 的输出中添加了 configDirectory",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0006",
      "kind": "list-item",
      "sourceHash": "020fe251aaf9ce93",
      "translationZh": "为 claude plugin install、uninstall、update、enable 和 disable 命令添加了 --json 参数，并在 claude plugin list --json 的每一行中添加了 errorDetails / noteDetails 字段",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0007",
      "kind": "list-item",
      "sourceHash": "c43ae57a1282cc58",
      "translationZh": "为已发布的工件添加了浏览器标签页图标，由 Claude 选择以匹配每个页面",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0008",
      "kind": "list-item",
      "sourceHash": "df91171eb2b00de4",
      "translationZh": "修复了自 2.1.265 版本以来，在第三方 Anthropic 兼容端点（ANTHROPIC_BASE_URL）上每轮对话均因 HTTP 400 错误而失败的问题：原因是 Artifact 工具的输入模式中包含一个正则表达式，而这些端点会拒绝该表达式",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0009",
      "kind": "list-item",
      "sourceHash": "7fd7770d11c6a33f",
      "translationZh": "修复了 WebFetch 在服务器保持响应打开但不结束的情况下无限挂起的问题；现在请求会在 300 秒后失败。设置 CLAUDE_CODE_WEBFETCH_DEADLINE_MS 可覆盖超时时间（设为 0 可关闭）",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0010",
      "kind": "list-item",
      "sourceHash": "f93aada5ae13b07e",
      "translationZh": "修复了重生后的进程内队友从您未信任的文件夹中同名代理文件获取工具或系统提示的问题",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0011",
      "kind": "list-item",
      "sourceHash": "c6d2f38ee572611a",
      "translationZh": "修复了持续高 CPU 占用问题：长时间空闲会话中的忙循环不再占用 CPU 核心，且会话回顾期间的快速终端焦点报告不再导致 CPU 保持高负载",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0012",
      "kind": "list-item",
      "sourceHash": "5749e94652b9b2aa",
      "translationZh": "修复了 Claude 在 MCP 工具调用后有时回复“您的消息内容为空”的问题",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0013",
      "kind": "list-item",
      "sourceHash": "df1407c9083450f7",
      "translationZh": "修复了符号链接目录（macOS 上的 /etc、/tmp、/var；Linux 上的 /bin）的固定拒绝和请求权限规则在路径以真实位置给出时未生效的问题，以及 Bash 命令忽略以符号链接路径拼写编写的拒绝规则的问题",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0014",
      "kind": "list-item",
      "sourceHash": "2945e5446734a527",
      "translationZh": "修复了当同一行包含权限检查器无法分析的 env -C、eval 或类似命令时，Read 或 Edit 拒绝规则未生效的问题",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0015",
      "kind": "list-item",
      "sourceHash": "920b9f6d7784eb7b",
      "translationZh": "修复了插件和市场中显示来自 git 源 URL 的令牌或密码的错误",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0016",
      "kind": "list-item",
      "sourceHash": "09692b95a51847c6",
      "translationZh": "修复了 /mcp 和 /plugin 服务器详情、claude mcp list / get 命令，以及 MCP 配置中从 VAR 占位符解析密钥时出现的 MCP 登录错误",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0017",
      "kind": "list-item",
      "sourceHash": "d67c45b7c1c0ba7f",
      "translationZh": "修复了使用 excludeDynamicSections 的 SDK 会话中，提示词缓存和扩展思考在会话中途失效的问题：第一条消息不再在每次请求时重新渲染",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0018",
      "kind": "list-item",
      "sourceHash": "e8e0349fb55792c1",
      "translationZh": "修复了拥有授权的用户在重启后或在桌面代码选项卡中，因缓存的模型访问拒绝信息已过时而被告知模型受限的问题",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0019",
      "kind": "list-item",
      "sourceHash": "9762466244a8ed6c",
      "translationZh": "修复了当另一个 Claude Code 进程刷新过期的模型访问条目时，正在运行的会话会静默切换到组织默认模型的问题",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0020",
      "kind": "list-item",
      "sourceHash": "8c3fc8950d005f86",
      "translationZh": "修复了 Fable 模型在长上下文场景下返回 429 错误的问题，此前在 Pro 和 Team 套餐中，该错误会显示使用额度同意提示，而非 1M 上下文消息。",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0021",
      "kind": "list-item",
      "sourceHash": "efa79c44da7ec5c2",
      "translationZh": "通过配置文件固定工作负载身份联合（如 claude-code-action 所配置的那样）：共享该配置文件的进程可能在运行中途因 401 … jti 重用而失败",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0022",
      "kind": "list-item",
      "sourceHash": "bc64626654bf10f5",
      "translationZh": "修复了当本地回调端口范围无法绑定时，MCP 服务器 OAuth 登录失败并报错“没有可用于 OAuth 重定向的端口”的问题",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0023",
      "kind": "list-item",
      "sourceHash": "a31fc032c4884097",
      "translationZh": "修复了 /compact 和自动压缩生成的对话摘要中，包含序列的文本被错误处理的问题",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0024",
      "kind": "list-item",
      "sourceHash": "bc1181b2167bc92f",
      "translationZh": "修复了以 /compact 命令结束对话后恢复会话的问题：其恢复文件备注现在在每次恢复时都会按相同顺序加载",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0025",
      "kind": "list-item",
      "sourceHash": "d4a23d116f32f027",
      "translationZh": "修复了 SDK 提示建议、侧边问题以及 /rename 命令发送压缩前对话的问题",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0026",
      "kind": "list-item",
      "sourceHash": "730f7a10dde84516",
      "translationZh": "修复了使用向上箭头键调出并编辑之前的提示词后，@ 文件和 / 命令建议不再显示的问题",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0027",
      "kind": "list-item",
      "sourceHash": "80d11f6984ee83b9",
      "translationZh": "修复了 claude agents：以自然节奏再次按下 ← 键返回代理列表时，不再被忽略直到暂停超过一秒",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    },
    {
      "id": "b0028",
      "kind": "list-item",
      "sourceHash": "7dcf8699d5db32c8",
      "translationZh": "修复了当 worktree 无法移除时 claude agents 会话删除卡住的问题：该消息会指明原因和下一步操作，并且对于 git worktree，再次按 ctrl+x 会直接删除该目录",
      "provider": "groq",
      "model": "qwen/qwen3.8-27b"
    }
  ],
