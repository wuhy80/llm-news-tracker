  "sourceTitle": "Introducing the Agents API",
  "sourceBodyHash": "d5b8b230aea86196fc884c0740860ad823c5f1f82ae751cc4be05b9e8aead514",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "partial",
  "importanceLevel": 5,
  "provider": "openrouter",
