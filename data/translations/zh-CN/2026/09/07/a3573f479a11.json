  "wordWise": [
    {
      "term": "SOTA",
      "briefZh": "当前最优",
      "explanationZh": "指当前最先进的技术水平，此处用于描述检索性能。"
    },
    {
      "term": "nDCG@10",
      "briefZh": "前十排序质量",
      "explanationZh": "归一化折损累积增益，衡量前 10 个检索结果的相关性及排序质量。"
    },
    {
      "term": "per-token multi-vector embeddings",
      "briefZh": "逐词元多向量嵌入",
      "explanationZh": "为各词元保留向量表示，而非将整份文档压缩成单一向量，以保留细粒度信息。"
    },
    {
      "term": "margin distillation",
      "briefZh": "间隔蒸馏",
      "explanationZh": "将教师模型对相关与不相关结果之间分数间隔的知识传递给轻量级模型。"
    },
    {
      "term": "linear projection",
      "briefZh": "线性投影",
      "explanationZh": "通过线性变换将表示映射到目标向量空间，此处用于生成 2048D 表示。"
    },
    {
      "term": "Hierarchical Agglomerative Clustering",
      "briefZh": "层次凝聚聚类",
      "explanationZh": "逐步合并相近簇的聚类方法，此处用于减少每页保留的向量数量。"
    },
    {
      "term": "GiB",
      "briefZh": "吉比字节",
      "explanationZh": "二进制存储容量单位，1 GiB 等于 2 的 30 次方字节。"
    },
    {
      "term": "Anchor-preserving",
      "briefZh": "保留锚点",
      "explanationZh": "指在蒸馏过程中保留作为参照的锚点。"
    },
    {
      "term": "capacity-aware",
      "briefZh": "考虑容量",
      "explanationZh": "指蒸馏方法会考虑模型的容量及其学习能力。"
    },
    {
      "term": "relation distillation",
      "briefZh": "关系蒸馏",
      "explanationZh": "指将教师模型所学的关系信息传递给学生模型的蒸馏方法。"
    }
