  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "5fa82c32c578d753",
      "translationZh": "Qwen3.5 0.8B 模型很适合用来做小规模的专项微调，因此我很好奇它在 CPU 上能跑多快。为什么是 CPU？主要是因为，当我用 GPU 做其他事情时，我想把它用作本地的听写文本清理模型。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0002",
      "kind": "paragraph",
      "sourceHash": "e1b2853229559603",
      "translationZh": "周末，我让 Codex 构建了一个小型 C++ 引擎和一种自定义的 4 位格式 H128/Q4-G32-DOT4，采用了基于激活值的校准和分块误差补偿。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0003",
      "kind": "paragraph",
      "sourceHash": "c3b00fa4f9d2411b",
      "translationZh": "最终模型的权重数据大小为 425 MB，比 Unsloth 的混合精度 Q4_0 小约 71 MB，实测困惑度和 KL 散度则相近。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0004",
      "kind": "paragraph",
      "sourceHash": "dd4f22d0b7c9aac6",
      "translationZh": "在我的 Ryzen 9 9955HX3D 上进行的对比，运行 Linux，使用八个带 V-Cache 的物理核心：",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "2c279dd2293fbdbd",
      "translationZh": "引擎 / 量化格式 权重 MB 预填充 解码 B1 解码 B16 PPL ↓ KL ↓",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0008",
      "kind": "paragraph",
      "sourceHash": "602d0b7a31935003",
      "translationZh": "与运行 Unsloth Q4_0 的 llama.cpp 相比，预填充速度约为其 2.9×，单请求解码速度约为其 1.3×，批量大小为 16 时的吞吐量约为其 1.7×。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0009",
      "kind": "paragraph",
      "sourceHash": "37a60ba4d96b4708",
      "translationZh": "与运行相同 GGUF 的 IK 相比，预填充性能基本持平，单请求解码速度快 18%，批量大小为 16 时的吞吐量高 53%。IK 更小的 IQ4_KS_R4 在单请求解码方面胜出，但我的引擎在批量大小为 16 时的吞吐量高 41%。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0011",
      "kind": "paragraph",
      "sourceHash": "59c74608e24dfdb6",
      "translationZh": "由 /u/Danmoreng 提交",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    }
  ],
  "wordWise": [
    {
      "term": "activation-based calibration",
      "briefZh": "激活值校准",
      "explanationZh": "根据模型运行时的激活值来校准量化参数，以减小量化造成的误差。"
    },
    {
      "term": "blockwise error compensation",
      "briefZh": "分块误差补偿",
      "explanationZh": "按数据块补偿量化误差，以降低低精度表示对模型输出的影响。"
    },
    {
      "term": "mixed-precision",
      "briefZh": "混合精度",
      "explanationZh": "在模型的不同部分使用不同数值精度，兼顾存储大小与模型质量。"
    },
    {
      "term": "perplexity",
      "briefZh": "困惑度",
      "explanationZh": "衡量语言模型预测文本能力的指标，通常数值越低，预测表现越好。"
    },
    {
      "term": "KL divergence",
      "briefZh": "KL 散度",
      "explanationZh": "衡量两个概率分布差异的指标，此处用于比较量化后模型与参考模型的输出分布。"
    },
    {
      "term": "prefill",
      "briefZh": "预填充",
      "explanationZh": "模型处理输入提示并建立后续生成所需缓存的阶段。"
    },
    {
      "term": "single-request decode",
      "briefZh": "单请求解码",
      "explanationZh": "模型为单个请求逐步生成输出词元的过程。"
    },
    {
      "term": "batch-16 throughput",
      "briefZh": "批量吞吐量",
      "explanationZh": "批量大小为 16 时，模型在单位时间内完成的处理或生成量。"
    },
    {
      "term": "GGUF",
      "briefZh": "模型文件格式",
      "explanationZh": "用于存储和加载模型的文件格式；这里比较的是运行相同 GGUF 时的性能。"
    }
  ],
