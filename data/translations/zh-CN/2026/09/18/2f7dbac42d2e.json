      "sourceHash": "210d971957874327",
      "translationZh": "更新：多语言支持已添加，地址： https://github.com/NandhaKishorM/laya",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
