  "blocks": [
    {
      "id": "b0001",
      "kind": "heading",
      "sourceHash": "f404fca7437f827a",
      "translationZh": "AuK-Flash：快速的 4 步语音生成与编辑",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0003",
      "kind": "list-item",
      "sourceHash": "65d58ed7c1fd935b",
      "translationZh": "论文全文：https://arxiv.org/pdf/2609.08936",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0005",
      "kind": "list-item",
      "sourceHash": "789b4666223cd9d7",
      "translationZh": "项目：https://auk-project.github.io/",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0006",
      "kind": "paragraph",
      "sourceHash": "13778a558e0fd608",
      "translationZh": "AuK 是一个用于语音生成与编辑的 1.5B 基础模型。AuK 使用数百万小时的多样化音频数据进行训练，通过统一的自然语言指令接口，支持零样本和基于指令的文本转语音（TTS）、内容与声学编辑、副语言编辑、语音增强以及声源分离。AuK 有两个变体：",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0007",
      "kind": "paragraph",
      "sourceHash": "6477bcbfaf720433",
      "translationZh": "模型 描述 权重",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0008",
      "kind": "paragraph",
      "sourceHash": "d75741e3e0a7debb",
      "translationZh": "用于高质量生成的基础模型",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0010",
      "kind": "paragraph",
      "sourceHash": "7a5d0f898a62f23b",
      "translationZh": "用于快速 4 步推理的蒸馏模型",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0011",
      "kind": "paragraph",
      "sourceHash": "b57db8deddd94eeb",
      "translationZh": "本仓库包含 AuK-Flash 的官方权重，这是一个支持快速 4 步推理的蒸馏变体。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0012",
      "kind": "paragraph",
      "sourceHash": "4906a707ec1a7b01",
      "translationZh": "AuK 通过统一的自然语言指令接口提供所有任务。下表按类别对支持的任务进行分组，并附有简短描述及指向 Cookbook 中相应章节的链接；Cookbook 提供了指令模板以及 CLI 和 Python 示例。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0013",
      "kind": "paragraph",
      "sourceHash": "fdf99985acaf28a9",
      "translationZh": "类别 任务 描述 Cookbook",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0014",
      "kind": "paragraph",
      "sourceHash": "ecb5b596cbb756f1",
      "translationZh": "使用参考音频中的声音说出目标文本。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0015",
      "kind": "paragraph",
      "sourceHash": "86beb22434a1afbc",
      "translationZh": "仅根据声音描述生成语音，无需参考音频。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0016",
      "kind": "paragraph",
      "sourceHash": "2394f563b9e102c1",
      "translationZh": "改写所说的内容——替换、插入或删除文本。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0017",
      "kind": "paragraph",
      "sourceHash": "99d7b35a9aa473e2",
      "translationZh": "改写歌唱录音中的歌词，同时保留旋律和嗓音。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0018",
      "kind": "paragraph",
      "sourceHash": "f1c7c41ce6f3c250",
      "translationZh": "以半音为单位升高或降低音高。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0019",
      "kind": "paragraph",
      "sourceHash": "b95719fec91150d1",
      "translationZh": "调整语速；输出时长随速度系数变化。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0020",
      "kind": "paragraph",
      "sourceHash": "2bf0709babe4e029",
      "translationZh": "以分贝为单位提高或降低音量。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0021",
      "kind": "paragraph",
      "sourceHash": "8c43512446901535",
      "translationZh": "改变情绪，同时保留内容和嗓音。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0022",
      "kind": "paragraph",
      "sourceHash": "f93010277fd03bb5",
      "translationZh": "根据描述改变音色，同时保持内容不变。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0023",
      "kind": "paragraph",
      "sourceHash": "aa55fd4243292860",
      "translationZh": "去除地域口音，同时保留说话者的嗓音和内容。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0024",
      "kind": "paragraph",
      "sourceHash": "3f5a4bf522f584fc",
      "translationZh": "移除或添加呼吸声、笑声或咳嗽声等非言语声音。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0025",
      "kind": "paragraph",
      "sourceHash": "b0ccc69040d1eb42",
      "translationZh": "在正常说话与耳语之间转换，同时保留说话人的身份和内容。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0026",
      "kind": "paragraph",
      "sourceHash": "ecffe6362740b51b",
      "translationZh": "增强与分离",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0027",
      "kind": "paragraph",
      "sourceHash": "b17ffee1c8df1924",
      "translationZh": "降噪、去混响，或恢复自然、清晰的语音。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0028",
      "kind": "paragraph",
      "sourceHash": "f17586e72cfdd6b9",
      "translationZh": "按发言顺序保留一位说话人的声音，并移除其他人的声音。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0029",
      "kind": "paragraph",
      "sourceHash": "0ab133c761a393ef",
      "translationZh": "从混合音频中提取歌声，或保留所有人声。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0030",
      "kind": "paragraph",
      "sourceHash": "c2de1dd9667c1fe4",
      "translationZh": "目标说话人提取",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0031",
      "kind": "paragraph",
      "sourceHash": "ef2205045fd77740",
      "translationZh": "保留通过所说内容识别出的目标说话人的声音。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    }
  ],
  "wordWise": [
    {
      "term": "foundation model",
      "briefZh": "基础模型",
      "explanationZh": "在大规模数据上训练、可支持多种下游任务的模型；此处用于语音生成与编辑。"
    },
    {
      "term": "zero-shot",
      "briefZh": "零样本",
      "explanationZh": "无需针对目标场景提供专门的训练样本，即可执行相应任务。"
    },
