    },
    {
      "id": "b0039",
      "kind": "paragraph",
      "sourceHash": "07f116c0f52ac774",
      "translationZh": "解码 128K |72 tok/s |202 tok/s | 2.8x",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0040",
      "kind": "paragraph",
      "sourceHash": "a6424df6fdc7fd90",
      "translationZh": "预填充 1K |1,545 tok/s |7,265 tok/s | 4.7x",
