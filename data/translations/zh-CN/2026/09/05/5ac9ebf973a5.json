    },
    {
      "term": "JIT compilation",
      "briefZh": "即时编译",
      "explanationZh": "在运行时按需编译内核，而非预先完成编译；首次编译会消耗额外资源。"
    },
    {
      "term": "OOM-kill",
      "briefZh": "内存不足终止",
      "explanationZh": "因可用内存不足，进程被系统终止。"
    },
    {
      "term": "CUDA graph capture",
      "briefZh": "CUDA 图捕获",
      "explanationZh": "将 GPU 操作序列捕获为可重放的执行图；这里其额外开销限制了最大上下文长度。"
    },
    {
      "term": "Draft tokens",
      "briefZh": "草稿词元",
      "explanationZh": "推测解码中先行生成、再交由验证步骤判断是否接受的 token。"
    },
    {
      "term": "Acceptance",
      "briefZh": "接受率",
