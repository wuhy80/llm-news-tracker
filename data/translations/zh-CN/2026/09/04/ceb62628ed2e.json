  "sourceTitle": "Even Qwen3.8 followed the instruction inside my translation data, and Gemma 4 beat the translation specialists I tested",
  "sourceBodyHash": "a2e0b3f20e5aa246adc1ee9cb7c0037e2cb86b0346f237b68fbe52a310e46e02",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "partial",
