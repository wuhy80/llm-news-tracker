  "blocks": [
    {
      "id": "b0001",
      "kind": "list-item",
      "sourceHash": "eeb8468f022a6f05",
      "translationZh": "在 /status 和 claude doctor 中添加了\"组织策略\"行，说明为何无法加载组织的策略（例如代理未将端点透传）"
    },
    {
      "id": "b0002",
      "kind": "list-item",
      "sourceHash": "0b2e05133af9dc51",
      "translationZh": "添加了 bashOutputMaxChars 和 taskOutputMaxChars 设置，用于提高 Claude 在保存到文件前内联接收的命令和后台任务输出量，最高可达 128K 字符"
    },
    {
      "id": "b0003",
      "kind": "list-item",
      "sourceHash": "d2a567ae0548acbe",
      "translationZh": "添加了 --append-subagent-system-prompt-file，用于从文件读取子代理系统提示，以支持无法通过命令行传递的超长提示"
    },
    {
      "id": "b0004",
      "kind": "list-item",
      "sourceHash": "41e806f9d65459b0",
      "translationZh": "添加了 /skill-doctor，用于显示哪些已加载的技能未被使用及其上下文开销，以便你进行清理"
    },
    {
      "id": "b0005",
      "kind": "list-item",
      "sourceHash": "680a20a449a2f56f",
      "translationZh": "修复了快速输入或按键重复时，键入或粘贴的字符偶尔出现顺序错乱或丢失的问题"
    },
    {
      "id": "b0006",
      "kind": "list-item",
      "sourceHash": "cc47c9991c8a030b",
      "translationZh": "修复了当工作目录位于 /net 自动挂载点上时，/add-dir <子目录> 错误地显示\"无法解析\"的问题"
    },
    {
      "id": "b0007",
      "kind": "list-item",
      "sourceHash": "00e0e30fef28e1a3",
      "translationZh": "修复了 Bedrock 设置向导在 AWS 或 AWS 凭据助手无响应时挂起的问题（现在会超时并给出明确错误），以及其在 TLS 检测代理后模型检查失败的问题"
    },
    {
      "id": "b0008",
      "kind": "list-item",
      "sourceHash": "82e24ee29586bbfb",
      "translationZh": "修复了云会话在托管设置强制启用 enabledPlugins 中的插件时，丢弃了从 claude.ai 同步的插件，然后回退到可能失败的市场克隆的问题"
    },
    {
      "id": "b0009",
      "kind": "list-item",
      "sourceHash": "4357aea6755969d2",
      "translationZh": "修复了在提示输入中无法删除内联 [Image #N] 芯片前一个字符的问题"
    },
    {
      "id": "b0010",
      "kind": "list-item",
      "sourceHash": "b11ea1189c604561",
      "translationZh": "修复了恢复会话时丢失钩子输出及并行工具调用周围上下文的问题，这改变了恢复后的请求"
    },
    {
      "id": "b0011",
      "kind": "list-item",
      "sourceHash": "c2676752c5b2da1d",
      "translationZh": "修复了 Remote Control 在手机、浏览器或 claude.ai 应用连接到终端会话后，或终端模式更改后显示过时的权限模式的问题"
    },
    {
      "id": "b0012",
      "kind": "list-item",
      "sourceHash": "a0112735f2ff3daa",
      "translationZh": "修复了从已连接的手机或浏览器停止一轮操作后，或执行 /clear 等本地斜杠命令后，Remote Control 会话仍显示为正在运行（旋转图标和停止按钮卡住）的问题"
    },
    {
      "id": "b0013",
      "kind": "list-item",
      "sourceHash": "af71dcb1dd0e5076",
      "translationZh": "修复了 SDK 和云会话忽略在第一条提示后、轮次开始前发送的 Stop 或中断信号的问题；现在轮次会停止而非运行至完成"
    },
    {
      "id": "b0014",
      "kind": "list-item",
      "sourceHash": "5757aca1d73b19e7",
      "translationZh": "修复了 Remote Control 将通过 /teleport 拉取的会话上传到已连接会话，导致在手机和网页端显示为追加到原始会话的问题"
    },
    {
      "id": "b0015",
      "kind": "list-item",
      "sourceHash": "de1d6264d6305bca",
      "translationZh": "修复了 Remote Control 在原生 Windows 上位于 TLS 检测企业代理后入站事件流失败的问题"
    },
    {
      "id": "b0016",
      "kind": "list-item",
      "sourceHash": "a6c980755a35ed28",
      "translationZh": "修复了 Remote Control 会话在 claude.ai 上显示默认努力级别的问题（当努力级别来自设置时）"
    },
    {
      "id": "b0017",
      "kind": "list-item",
      "sourceHash": "945ef00a3ed4c6dc",
      "translationZh": "修复了 gcpAuthRefresh 在 Google 凭据检查缓慢时于启动时打开浏览器的问题，尽管凭据仍然有效"
    },
    {
      "id": "b0018",
      "kind": "list-item",
      "sourceHash": "c85a2660d6a8be95",
      "translationZh": "修复了启动连接器获取超时时，claude.ai 连接器在整个会话期间缺失的问题——CLI 现在会在后台重试"
    },
    {
      "id": "b0019",
      "kind": "list-item",
      "sourceHash": "45ae228b75241101",
      "translationZh": "修复了后台代理无法恢复且其唤醒在紧凑循环中重试时持续高 CPU 使用率的问题"
    },
    {
      "id": "b0020",
      "kind": "list-item",
      "sourceHash": "41b8722dbfe52694",
      "translationZh": "修复了限定于新版本的特性标志偶尔应用于同一台机器上运行的旧版 Claude Code 的问题"
    }
  ],
