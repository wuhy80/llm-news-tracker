      "term": "benchmark",
      "briefZh": "基准测试",
      "explanationZh": "用实际代码任务测试并比较不同模型的表现。"
    },
    {
      "term": "GPU",
      "briefZh": "图形处理器",
      "explanationZh": "运行模型的计算硬件，其显存容量限制了可容纳的模型大小。"
    },
    {
      "term": "quants",
      "briefZh": "量化版本",
      "explanationZh": "量化模型的简称，通过降低数值精度减少模型的存储和显存需求。"
    },
    {
      "term": "uncensored",
      "briefZh": "无审查",
      "explanationZh": "指减少或移除了部分内容限制、拒答行为的模型版本。"
    },
    {
      "term": "context",
      "briefZh": "上下文",
      "explanationZh": "这里指模型运行时可容纳的输入及生成内容的空间。"
    },
    {
      "term": "Mean KLD",
      "briefZh": "平均散度",
      "explanationZh": "平均 Kullback–Leibler 散度，用于衡量两个概率分布之间的差异。"
    },
    {
      "term": "GGUF size",
      "briefZh": "模型文件大小",
      "explanationZh": "以 GGUF 格式存储的模型文件所占的空间。"
    },
    {
      "term": "can't fit",
      "briefZh": "装不下",
      "explanationZh": "这里表示可用显存空间不足以容纳所列模型版本。"
    },
    {
      "term": "VRAM",
      "briefZh": "显存",
      "explanationZh": "显卡用于存储模型权重等数据的内存；这里指运行模型时紧缺的显存资源。"
    }
