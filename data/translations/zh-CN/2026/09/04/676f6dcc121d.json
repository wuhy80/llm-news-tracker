  "sourceTitle": "Customizing your knowledge base on Amazon Bedrock for large and complex documents using Amazon Textract",
  "sourceBodyHash": "7e365562de60a2fd7d773f27808c812a7407ee32fdaa882a4c0c74c06d5400ed",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "complete",
  "importanceLevel": 4,
  "provider": "nowcoding",
