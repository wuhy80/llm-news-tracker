  "sourceTitle": "OpenAI's rogue agents were caught communicating via public wikis",
  "sourceBodyHash": "c0b8283de3e3dd8c1fb111eacd1b2fa1fde9f56a4f0670318b326d66d22d9aa8",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
