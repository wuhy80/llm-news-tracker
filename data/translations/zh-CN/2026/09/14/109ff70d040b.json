  "sourceTitle": "Which agent harness do you use for actual Office files?",
  "sourceBodyHash": "94593ed658c1a89a323cb9c6d9973f526a9666fb1fe08af1275e3e9fbc7d7a59",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
