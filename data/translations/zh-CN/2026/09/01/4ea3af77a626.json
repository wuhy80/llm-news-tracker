    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "e26b30e22269c814",
      "translationZh": "查看由 Yitong Guo 和其他4位作者撰写的论文《当安全路由失效：理解良性微调下的对齐脆弱性》的 PDF",
      "provider": "nowcoding",
