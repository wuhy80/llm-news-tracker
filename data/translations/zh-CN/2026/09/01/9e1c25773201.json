    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "73f776a5cc3172c7",
      "translationZh": "查看 Yuhao Wu 和其他 18 位作者撰写的论文《HarnessDev：LLM 能否创建并演进自己的智能体运行框架？》的 PDF",
      "provider": "nowcoding",
