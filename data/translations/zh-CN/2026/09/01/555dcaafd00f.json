      "id": "b0004",
      "kind": "paragraph",
      "sourceHash": "74be2d83f41c7e8e",
      "translationZh": "作者：Yiming Huang , Ziche Liu , Zhuohang Wu , Yiqian Wang , Junxia Cui , Xinkai Zou , Linjun Mao , Nan Huang , Naicheng Yu , Kaijie Zhu , Yue Ma , Kun Zhou , Letian Peng , Jingbo Shang",
      "provider": "nowcoding",
