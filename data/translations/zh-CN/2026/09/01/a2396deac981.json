    {
      "id": "b0004",
      "kind": "paragraph",
      "sourceHash": "f0f8ea516cc326f6",
      "translationZh": "作者：Yingwen Zhang、Meng Wang、Liqiang He、Shiqi Wang",
      "provider": "nowcoding",
