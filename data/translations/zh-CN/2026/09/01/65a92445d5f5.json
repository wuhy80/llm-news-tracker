  "sourceTitle": "From theory to delivery: How Atos upskilled 400 engineers in agentic AI",
  "sourceBodyHash": "a9dfe534a6f64ba8ac06b7ff5260b13b3dfb66c29924ac37d7b250ca65122365",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
