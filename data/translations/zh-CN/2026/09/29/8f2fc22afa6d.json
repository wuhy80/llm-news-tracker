  "sourceTitle": "Prompt engineering by Quick component: Patterns and pitfalls",
  "sourceBodyHash": "6204281ebb7b319074f937840e9b870ef85d5f4b23a97b067573da1d63a75e06",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
