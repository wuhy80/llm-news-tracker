  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "3c14aaeadffc62c3",
      "translationZh": "Ollama 现已通过 /v1/systemone 支持决策模型，该接口基于 TypeSafe 的 Jev API。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0002",
      "kind": "paragraph",
      "sourceHash": "07ffaf9b2e4008d9",
      "translationZh": "决策模型返回选项、概率和分数，而不是文本。可将它们用于工单分流、模型路由和内容分类等任务。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0003",
      "kind": "list-item",
      "sourceHash": "6e913763fd3113f4",
      "translationZh": "来自 Bespoke Labs 的 Nimble",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0004",
      "kind": "paragraph",
      "sourceHash": "d61db0d0f0f4aadd",
      "translationZh": "发送上下文以及一个或多个问题：",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "395af67da16f4841",
      "translationZh": "该 API 支持三种问题类型：",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0006",
      "kind": "list-item",
      "sourceHash": "ccc191c18b21623e",
      "translationZh": "choice：选择一个选项，并返回每个选项的概率。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0007",
      "kind": "list-item",
      "sourceHash": "0a2b6725afa54876",
      "translationZh": "noul：返回某个条件为真的概率。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0008",
      "kind": "list-item",
      "sourceHash": "1d572bbc5eeaa0ed",
      "translationZh": "score：根据一组有序的标准返回分数",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0009",
      "kind": "list-item",
      "sourceHash": "2017f5138aaecc25",
      "translationZh": "现在打开设置无需等待模型发现完成。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0010",
      "kind": "list-item",
      "sourceHash": "adeecc33b16ca315",
      "translationZh": "修复了 macOS 更新菜单和图标在启动时未显示可用更新的问题。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0011",
      "kind": "list-item",
      "sourceHash": "ddc4bb7fdbff6cdd",
      "translationZh": "修复了 MLX 模型下载停滞后无限期挂起的问题。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0012",
      "kind": "list-item",
      "sourceHash": "1406840902fd0ee3",
      "translationZh": "包含已弃用的 typical_p 参数的请求现在会记录警告，而不再失败。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0013",
      "kind": "paragraph",
      "sourceHash": "24d9589ba58c7a25",
      "translationZh": "完整更新日志：v0.34.4...v0.35.0",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    }
  ],
