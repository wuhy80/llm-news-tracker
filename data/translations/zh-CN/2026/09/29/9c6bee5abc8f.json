      "translationZh": "对齐得分",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0030",
      "kind": "paragraph",
      "sourceHash": "1ea442a134b2a184",
