  "sourceTitle": "Prompt engineering fundamentals for Amazon Quick",
  "sourceBodyHash": "5577029ff4c10b666c8365657c00d5a3128231846e790e3a60b7fb819c6b74fb",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
