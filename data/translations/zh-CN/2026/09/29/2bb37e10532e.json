    },
    {
      "id": "b0046",
      "kind": "paragraph",
      "sourceHash": "9df69005e500ae74",
      "translationZh": "Auto Mode 如何检查智能体的操作是否确实符合用户授予的权限",
      "provider": "nowcoding",
