      "translationZh": "量化模型：https://huggingface.co/ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0018",
