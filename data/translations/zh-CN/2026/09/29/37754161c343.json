  "wordWise": [
    {
      "term": "bpw",
      "briefZh": "每位权重",
      "explanationZh": "bits per weight，表示每个参数使用的比特数。"
    },
    {
      "term": "zero-shot",
      "briefZh": "零样本",
      "explanationZh": "在未见过的任务上直接进行推理，无需额外训练。"
    },
    {
      "term": "RCO",
      "briefZh": "路由优化",
      "explanationZh": "Route‑Based Compression Optimization，用于选择哪些专家保留。"
    },
    {
      "term": "KL divergence",
      "briefZh": "KL散度",
      "explanationZh": "Kullback‑Leibler 散度，衡量两个概率分布的差异。"
    },
    {
      "term": "Transformer",
      "briefZh": "变换器",
      "explanationZh": "一种基于自注意力的深度学习模型架构。"
    },
    {
      "term": "Quantized models",
      "briefZh": "量化模型",
      "explanationZh": "指通过降低权重精度来减小模型大小并加速推理的模型。"
    },
    {
      "term": "GSQ",
      "briefZh": "稀疏量化",
