      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0021",
      "kind": "list-item",
      "sourceHash": "dff98eb6923e84c7",
      "translationZh": "修复了 claude plugin validate 会通过那些 outputStyles、themes、monitors 或 lspServers 路径缺失或指向插件目录之外的插件的问题",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
      "id": "b0022",
      "kind": "list-item",
      "sourceHash": "ba0efb97084b33ac",
