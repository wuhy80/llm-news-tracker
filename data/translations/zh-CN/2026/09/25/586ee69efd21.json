  "sourceTitle": "Mica v0.1 4B: open Jev-style decision model (yes/no, choice, score) that runs on an 8 GB GPU — trained for under $30 of GPU time",
  "sourceBodyHash": "c820f9e174a5ae59a0b005c5c5121ce63579e848facca172335dac725bc5a78c",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
