  "sourceTitle": "Runway’s WorldPrompt and the Engineering of Real-Time Worlds",
  "sourceBodyHash": "27ad5a4679fef362fa828898095d1f2deaf26ff1c0af7e4d20220aff03cac76e",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
