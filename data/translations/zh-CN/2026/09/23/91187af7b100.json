  "sourceTitle": "[AINews] Claude Opus 5.5, the new default model for AINews — and everybody cuts prices 40-50%",
  "sourceBodyHash": "e3f7444be9f9047a7856b883b0a88ec4209e09dc125fe283ea6334d4eca63d1e",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
