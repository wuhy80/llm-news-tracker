  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "7f7f71bc84bba025",
      "translationZh": "2026年9月23日 责任与安全",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0002",
      "kind": "heading",
      "sourceHash": "87fa4a69b4d6fc49",
      "translationZh": "通过安全的服务器端内存推进 Private AI Compute",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0003",
      "kind": "paragraph",
      "sourceHash": "e42dc5369d0efc53",
      "translationZh": "Google Private AI Compute 团队",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0004",
      "kind": "paragraph",
      "sourceHash": "1c8b1f142125ba3d",
      "translationZh": "我们对 Private AI Compute 架构的技术更新，将实现具备持久性、跨设备的 AI 内存，并符合设备端隐私标准。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "be5c2d890f6af42e",
      "translationZh": "AI 正变得更加强大和直观 — — 记住重要内容，理解你周围的世界，并按照你的指示行动。隐私和信任是实现这一点的核心，确保你的数据保持私密和受保护，因为 AI 系统正在发展以在你的设备之间提供更连续的帮助。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0006",
      "kind": "paragraph",
      "sourceHash": "599c88440acfb12a",
      "translationZh": "今天，我们将分享如何在我们的 Private AI Compute 平台上引入私有的服务器端内存。这一突破解决了现代 AI 中长期存在的两难问题：如何在跨设备为助手提供长期连续性，同时维持通常仅限于设备端处理的严格隐私标准。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0007",
      "kind": "heading",
      "sourceHash": "aa582eeee7f2656b",
      "translationZh": "将设备端隐私带入云端规模内存",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0008",
      "kind": "paragraph",
      "sourceHash": "2747929878f85088",
      "translationZh": "凭借这一新技术能力，全新的持久内存层能够像云端的安全数字金库一样运作。在此模型下，为助你所需的信息被封存于专用的加密存储中，而解锁所需的加密密钥仅存储在你的个人设备上 — — 确保你的数据对任何人（甚至 Google）都不可访问。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    }
  ],
  "wordWise": [
    {
      "term": "server-side memory",
      "briefZh": "服务器端内存",
      "explanationZh": "指在服务器端保存的内存，用于跨设备保持AI状态。"
    },
    {
      "term": "cross-device AI memory",
      "briefZh": "跨设备AI内存",
      "explanationZh": "指能够在多个设备之间共享并保持的AI记忆。"
    },
    {
      "term": "on-device privacy",
      "briefZh": "设备端隐私",
      "explanationZh": "指数据仅在用户设备上处理，确保不离开本地。"
    },
    {
      "term": "persistent memory",
      "briefZh": "持久内存",
      "explanationZh": "指能够长期保存数据且不易丢失的内存层。"
    },
    {
      "term": "cryptographic keys",
      "briefZh": "加密密钥",
      "explanationZh": "用于加密和解密数据的密钥，仅由用户设备持有。"
    },
    {
      "term": "encrypted storage",
      "briefZh": "加密存储",
      "explanationZh": "经过加密保护的存储空间，防止未授权访问。"
    }
  ],
