  "blocks": [
    {
      "id": "b0001",
      "kind": "heading",
      "sourceHash": "70d482221fed8fb8",
      "translationZh": "Gemini 3.8 text-to-speech 说你好",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0002",
      "kind": "paragraph",
      "sourceHash": "ad6c5c0c41be462b",
      "translationZh": "Gemini 3.8 Flash TTS 和 Gemini 3.8 Flash-Lite TTS 是我们目前最具表现力的音频生成模型。生成自定义角色语音并直接在 Google AI Studio、Gemini API、Gemini Enterprise、Gemini Notebook 和 Google Vids 中控制场景对话。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0003",
      "kind": "paragraph",
      "sourceHash": "8d7da4fae5b159e1",
      "translationZh": "研究科学总监，代表 Gemini Audio Team",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0004",
      "kind": "list-item",
      "sourceHash": "2dede789e85dccd9",
      "translationZh": "查看 \"Gemini 3.8 text-to-speech 说你好\" 以了解我们的新模型如何工作。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0005",
      "kind": "list-item",
      "sourceHash": "44f74365fe4402a0",
      "translationZh": "从头创建自定义语音或使用简单的自然语言提示复制现有语音。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0006",
      "kind": "list-item",
      "sourceHash": "3e6dac27eab093d0",
      "translationZh": "逐行控制您的音频，以调节节奏、情感，甚至逼真的对话声音。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0007",
      "kind": "list-item",
      "sourceHash": "f8c8488ab81c1450",
      "translationZh": "使用这些模型大规模制作高质量有声书、播客或实时语音代理。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0008",
      "kind": "list-item",
      "sourceHash": "42eb0bc340605258",
      "translationZh": "我们内置了像 watermarking 这样的安全工具，以保持生成的音频安全。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0017",
      "kind": "paragraph",
      "sourceHash": "52ea033a36c9c755",
      "translationZh": "从 30 个原始声音扩展到无限库。无论您需要完全原创的角色声音还是一致的品牌代言人，我们的 3.8 Flash TTS 模型赋能完整的声乐工作室。这使您能够为每一刻创建和使用富有表现力、自然听感的声音，同时让开发者和企业轻松构建自定义音频体验。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0018",
      "kind": "list-item",
      "sourceHash": "901ede60c4cb7ea3",
      "translationZh": "生成式声音设计：使用 Gemini 3.8 Flash TTS，通过自然语言提示在超过 100 种语言和方言中自定义角色、口音和声音特征，从零开始打造专属声音——无论是让戏剧性的喷火龙栩栩如生，还是塑造具有独特地区韵律的魅力旁白。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0019",
      "kind": "paragraph",
      "sourceHash": "8b135807559d4371",
      "translationZh": "听听 Gemini 3.8 Flash TTS 如何生成来自墨尔本的高能量 DJ 声音。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0020",
      "kind": "paragraph",
      "sourceHash": "4cc2ad8f20f7785d",
      "translationZh": "听听 Gemini 3.8 Flash TTS 如何生成超尖锐、单调的机器人声音。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0021",
      "kind": "paragraph",
      "sourceHash": "eb4efa3ba8c61d29",
      "translationZh": "听听 Gemini 3.8 Flash TTS 如何让日本龙栩栩如生。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0022",
      "kind": "list-item",
      "sourceHash": "ecb32564814fd894",
      "translationZh": "庞大的声音库：访问 2,000+ 种即用型声音，语言覆盖广泛——包括墨西哥西班牙语、魁北克法语和苏格兰英语等地区变体。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0023",
      "kind": "list-item",
      "sourceHash": "ff0c11f37933e02f",
      "translationZh": "声音复制：仅凭您声音或您拥有使用权的声音的 30 秒音频样本，即可重建一致的声纹档案，内置同意验证、SynthID 水印和 C2PA 凭据提供保护，以保障开发者及其声音人才的权益。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    },
    {
      "id": "b0024",
      "kind": "list-item",
      "sourceHash": "253d8ccb1f36d688",
      "translationZh": "保存与扩展：保存并管理您设计的自定义声音，以确保在持续项目中表现一致且漂移最小。",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-super-120b-a12b:free"
    }
  ],
