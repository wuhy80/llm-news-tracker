  "sourceTitle": "Introducing MentalHealthBench",
  "sourceBodyHash": "16c0976edf326aede543a60cd4da93e075eadc1093c022302c931f328addca75",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "partial",
  "importanceLevel": 5,
  "provider": "groq",
