  "sourceTitle": "xAI’s Grok 4.6 is now available in Amazon Bedrock",
  "sourceBodyHash": "5d502ff996e03a8f43b5f139a350c223c8989f194bd19fd2f2c6ce64c363e086",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "partial",
  "importanceLevel": 5,
  "provider": "openrouter",
