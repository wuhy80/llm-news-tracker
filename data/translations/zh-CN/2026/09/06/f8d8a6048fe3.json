  "sourceTitle": "Qwen 3.8-27B NVFP4 actually beats Q5_K_M and touches official BF16 levels, but only if you change 2 sampling params. Also almost 3x faster.",
  "sourceBodyHash": "2864c6d109f57b0160e0ecc4618677ff12b9ebea4e1c1b0ef1e15da03b78501b",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
