  "translatedBlocks": 16,
  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "699fb06f2882edc7",
      "translationZh": "我一直在尝试使用滑动窗口注意力（SWA），以降低长上下文大语言模型推理时 KV 缓存的内存开销。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0002",
      "kind": "paragraph",
      "sourceHash": "0064032d4153adca",
      "translationZh": "该实现不保留完整的 KV 缓存，而是保留：",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0003",
      "kind": "list-item",
      "sourceHash": "00e502f1adeadbd9",
      "translationZh": "少量注意力汇聚 token",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0004",
      "kind": "list-item",
      "sourceHash": "c9d128eeec0abcce",
      "translationZh": "一个大小有界的近期 token 窗口",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0005",
      "kind": "list-item",
      "sourceHash": "f821fe2db9e4d23f",
      "translationZh": "一个循环／环形缓冲区 KV 缓存",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0006",
      "kind": "list-item",
      "sourceHash": "6d0a304173a7dec0",
      "translationZh": "流式／分块预填充",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0007",
      "kind": "list-item",
      "sourceHash": "84b05ed095f47429",
      "translationZh": "常规自回归解码",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0008",
      "kind": "paragraph",
      "sourceHash": "ac694bd2d45ed23c",
      "translationZh": "我把这个实验做成了一个可复用的项目，方便你使用 Hugging Face 的因果大语言模型进行测试：",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0010",
      "kind": "paragraph",
      "sourceHash": "c9b79bb987d10141",
      "translationZh": "在我使用 L40S 进行的 Qwen2.5-7B 实验中：",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0011",
      "kind": "list-item",
      "sourceHash": "534e8931af6fae56",
      "translationZh": "32K KV 缓存：全注意力约为 1.84 GB，而 SWA-64 约为 3.5 MB",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0012",
      "kind": "list-item",
      "sourceHash": "c944cce5539dd6a5",
      "translationZh": "64K：全注意力出现了内存不足（OOM），而 SWA 的内存占用仍保持有界",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0013",
      "kind": "list-item",
      "sourceHash": "e070f2c90f2fa778",
      "translationZh": "随着上下文增加，解码延迟保持近似恒定",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0014",
      "kind": "list-item",
      "sourceHash": "4fd3c4ee1a741592",
      "translationZh": "当信息落在窗口之外时，长距离检索自然就成为一个弱项",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0015",
      "kind": "paragraph",
      "sourceHash": "2e220ac8b81f7b22",
      "translationZh": "我的目的并不是宣称 SWA 在所有情况下都更好。我感兴趣的是上下文保留、KV 内存、TTFT 和解码速度之间的工程权衡。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0016",
      "kind": "paragraph",
      "sourceHash": "c53a41798f260d70",
      "translationZh": "我尤其希望听到那些尝试过将 SWA 用于 Llama、Mistral、Gemma、Qwen 或其他 HF 模型的人的经验。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0017",
      "kind": "paragraph",
      "sourceHash": "1e472195fac6541c",
      "translationZh": "如果你在其他架构上尝试运行这个代码仓库，我会非常感谢你分享运行结果或发现的任何兼容性问题。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    }
  ],
  "wordWise": [
    {
      "term": "Sliding Window Attention",
      "briefZh": "滑动窗口注意力",
      "explanationZh": "将注意力范围限制在滑动的 token 窗口内，以减少长上下文推理的缓存开销。"
    },
    {
      "term": "KV cache",
      "briefZh": "键值缓存",
      "explanationZh": "缓存注意力机制中的键和值，供后续 token 的推理复用。"
    },
    {
      "term": "attention sink tokens",
      "briefZh": "注意力汇聚词元",
      "explanationZh": "容易汇聚注意力的 token；此实现会保留少量此类 token。"
    },
    {
      "term": "bounded recent-token window",
      "briefZh": "有界近期词元窗口",
      "explanationZh": "仅保留近期 token，且窗口大小有明确上限。"
    },
    {
      "term": "circular/ring-buffer KV cache",
      "briefZh": "环形键值缓存",
      "explanationZh": "以环形缓冲区存储键值缓存，循环复用存储空间。"
    },
    {
      "term": "streaming/chunked prefill",
      "briefZh": "流式分块预填充",
      "explanationZh": "以流式或分块方式处理输入上下文，完成生成前的预填充阶段。"
    },
    {
      "term": "autoregressive decoding",
      "briefZh": "自回归解码",
      "explanationZh": "根据已有 token 逐步生成下一个 token 的解码方式。"
    },
    {
      "term": "causal LLMs",
      "briefZh": "因果大语言模型",
      "explanationZh": "预测下一个 token 时仅使用此前上下文的大语言模型。"
    },
    {
      "term": "full attention",
      "briefZh": "全注意力",
      "explanationZh": "让当前位置关注所有可用上下文位置的注意力方式，与仅关注局部窗口的方式相对。"
    },
    {
      "term": "SWA",
      "briefZh": "滑动窗口注意力",
      "explanationZh": "将注意力范围限制在滑动窗口内，以控制 KV 缓存占用的注意力机制。"
    },
    {
      "term": "OOMed",
      "briefZh": "内存不足",
      "explanationZh": "指运行时因所需内存超过可用容量而失败；此处是全注意力在 64K 时出现该问题。"
    },
    {
      "term": "Decode latency",
      "briefZh": "解码延迟",
      "explanationZh": "模型在解码生成阶段产生输出所需的时间。"
    },
    {
      "term": "Long-range retrieval",
      "briefZh": "长距离检索",
      "explanationZh": "从距离当前位置较远的上下文中找回信息的能力。"
    },
    {
      "term": "TTFT",
      "briefZh": "首个词元耗时",
      "explanationZh": "从提交请求到模型生成第一个 token 所需的时间。"
    },
    {
      "term": "engineering trade-off",
      "briefZh": "工程权衡",
