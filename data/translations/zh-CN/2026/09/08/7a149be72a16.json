  "sourceTitle": "Automated agent evaluation with Amazon Bedrock AgentCore and GitHub Actions",
  "sourceBodyHash": "109efeb76fcea3298a962d6b99554fab94036716568648abe8866a2fb2868c90",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
