  "sourceTitle": "Benchmarking small LLM inference on SageMaker AI: G7 vs G5 and G6",
  "sourceBodyHash": "496854db0f1764814f24072fe7ba7084794833a33c5c1bb82230bc5e14b30012",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
