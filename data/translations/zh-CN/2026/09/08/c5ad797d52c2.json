  "sourceTitle": "An open-source context layer for building AI on top of company data",
  "sourceBodyHash": "197d56ca57816c748434555aaba2501f4f54d664a6b5979fbadcc1c6227fbcb0",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "partial",
  "importanceLevel": 5,
