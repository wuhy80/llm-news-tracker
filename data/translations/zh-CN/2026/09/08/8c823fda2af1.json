  "sourceTitle": "The Work Now Within Reach",
  "sourceBodyHash": "43b9007595d7ad641721aaee5114aaca624f8fcbd7112a722d57b47cd61e1a16",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
