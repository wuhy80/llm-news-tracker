    },
    {
      "term": "weights",
      "briefZh": "模型权重",
      "explanationZh": "模型训练得到的参数，推理时用于计算输出。"
    },
    {
      "term": "on-device apps",
      "briefZh": "设备端应用",
      "explanationZh": "在手机等终端设备上运行的应用。"
    },
    {
