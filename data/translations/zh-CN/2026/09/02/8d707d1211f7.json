  "sourceTitle": "Claude's new system prompt really doesn't want to reproduce song lyrics",
  "sourceBodyHash": "8694c2bd885678b811cc3515b2a93b6571f02ac6748d6ac35e9ae74a08968c2a",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
