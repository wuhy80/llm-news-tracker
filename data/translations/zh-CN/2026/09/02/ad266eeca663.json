  "sourceTitle": "From code to diagrams: Agentic architecture documentation with Amazon Bedrock AgentCore",
  "sourceBodyHash": "13bdcffaed83fccf791081fedc4ba6c488fadf5130b0d8ab5ebcce886073b760",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "partial",
  "importanceLevel": 5,
  "provider": "groq",
