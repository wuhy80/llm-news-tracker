  "wordWise": [
    {
      "term": "trajectories",
      "briefZh": "执行轨迹",
      "explanationZh": "智能体执行任务过程中形成的行动与结果序列，可用于提取经验。"
    },
    {
      "term": "agentic memory",
      "briefZh": "智能体记忆",
      "explanationZh": "将智能体过往执行经验保存下来，并在后续任务中复用的机制。"
    },
    {
      "term": "inference time",
      "briefZh": "推理时",
      "explanationZh": "模型实际处理输入、生成输出的阶段，文中在此阶段反馈经验而不更新权重。"
    },
    {
      "term": "playbook",
      "briefZh": "行动手册",
      "explanationZh": "ACE 用于集中组织和持续积累智能体经验的条目式指南。"
    },
    {
      "term": "brevity bias",
      "briefZh": "简短偏差",
      "explanationZh": "优化过程倾向于产生简短、泛泛的指令，从而损失有用细节的现象。"
    },
    {
      "term": "context collapse",
      "briefZh": "上下文坍缩",
      "explanationZh": "反复重写和总结全部上下文，导致其中细节逐渐丢失的现象。"
    },
    {
      "term": "support count",
      "briefZh": "支持计数",
      "explanationZh": "记录有多少次独立执行过程产生了某条指导原则的计数。"
    },
    {
      "term": "support counts",
      "briefZh": "支持计数",
      "explanationZh": "记录有多少经验为某条准则提供支持；合并经验时，这些计数会相加保留。"
    },
    {
      "term": "incremental delta updates",
      "briefZh": "增量差量更新",
      "explanationZh": "每次只应用新增或发生变化的内容，而非整体重建行动手册。"
    },
    {
      "term": "embedding",
      "briefZh": "嵌入表示",
      "explanationZh": "将内容表示为向量，以便比较相似程度；此处用于去重。"
    },
    {
      "term": "causal attribution",
      "briefZh": "因果归因",
      "explanationZh": "识别导致结果的原因，使提取出的准则包含对因果关系的判断。"
    },
    {
      "term": "provenance",
      "briefZh": "来源追溯",
      "explanationZh": "记录准则的出处，使其能够追溯到产生该经验的源轨迹。"
    },
    {
      "term": "subtask granularity",
      "briefZh": "子任务粒度",
      "explanationZh": "以子任务而非整个任务为单位提取经验，有助于跨应用迁移。"
    },
    {
      "term": "inference",
      "briefZh": "推理",
      "explanationZh": "模型接收输入并生成输出的运行阶段；此处关注该阶段向模型提供哪些准则。"
    },
    {
      "term": "Tokens/task",
      "briefZh": "每任务词元数",
      "explanationZh": "表示每个任务所使用的词元数量。"
    },
    {
      "term": "Tokens",
      "briefZh": "词元",
      "explanationZh": "语言模型处理文本的基本单位，可以是一个词、词的一部分或其他文本片段。"
    },
    {
      "term": "K",
      "briefZh": "千位数量后缀",
      "explanationZh": "数字后的数量级后缀，表示千；此处用于标示词元数量。"
    },
    {
      "term": "inference cost",
      "briefZh": "推理成本",
      "explanationZh": "模型执行任务、生成结果时产生的计算或调用成本。"
    },
    {
      "term": "run-to-run noise",
      "briefZh": "运行间噪声",
      "explanationZh": "同一基准测试在多次运行之间出现的随机结果波动。"
    },
    {
      "term": "context",
      "briefZh": "上下文",
      "explanationZh": "提供给模型、供其完成当前任务时参考的信息。"
    },
    {
      "term": "per-task selection",
      "briefZh": "逐任务选择",
      "explanationZh": "针对每个任务选择相关指导内容，而非每次提供整套内容。"
    },
    {
      "term": "no-memory baseline",
      "briefZh": "无记忆基线",
      "explanationZh": "系统不使用记忆机制时的表现，用于对比引入记忆后的提升。"
    },
    {
      "term": "instruction-following",
      "briefZh": "指令遵循",
      "explanationZh": "模型理解并按照给定指令执行任务的能力。"
    },
    {
      "term": "curated retrieval",
      "briefZh": "筛选式检索",
      "explanationZh": "有选择地检索适用经验，而非将所有经验一并提供给模型。"
    }
  ],
