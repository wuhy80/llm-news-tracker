    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "de9b024764d05cb4",
      "translationZh": "| oQ4e-mtp | 36.6 tokens/秒 | 86.8 ✅ 最佳平衡点 |"
    },
    {
      "id": "b0006",
      "kind": "paragraph",
      "sourceHash": "f98d2c146ca5ff9f",
      "translationZh": "| oQ6e-mtp | 29.0 tokens/秒 | 85.7 ✅ |"
