    {
      "id": "b0006",
      "kind": "paragraph",
      "sourceHash": "215d3f17e4b9e713",
      "translationZh": "查看 PDF HTML（实验性）",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
