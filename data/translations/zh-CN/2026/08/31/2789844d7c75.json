    {
      "id": "b0006",
      "kind": "paragraph",
      "sourceHash": "86cd65caf134c910",
      "translationZh": "启动了 docker 镜像，在里面安装了 git 和 cmake，因为它们似乎没有预装。从 github 拉取了最新版 llama.cpp。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0007",
      "kind": "paragraph",
      "sourceHash": "75512b4465499ac6",
      "translationZh": "按照 https://github.com/ggml-org/llama.cpp/blob/master/docs/build.md#hip 编译了 llama。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
