    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "8e62f28d6e85d348",
      "translationZh": "查看由 Gengxu Li 及另外 2 位作者撰写的论文《OCR-MetaReasoning 基准：评估 MLLMs 在富文本图像理解中的元推理能力》的 PDF",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0006",
      "kind": "paragraph",
      "sourceHash": "215d3f17e4b9e713",
      "translationZh": "查看 PDF HTML（实验性）",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
