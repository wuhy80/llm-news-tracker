  "sourceTitle": "Introducing Claude for Nonprofits",
  "sourceBodyHash": "dd8b0246cd42a866d6c84f7b3ae9fe5b520c2e1e1686ded46cab7619e1051c92",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
