  "sourceTitle": "LLM self-learning needs governance, and we don't have it.",
  "sourceBodyHash": "1f1bcad5421069eb9453ca5e088e83a4d7a7d99218ef1457806d1eff8c85d74a",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
