  "wordWise": [
    {
      "term": "ctx-size",
      "briefZh": "上下文大小",
      "explanationZh": "用于设置模型上下文容量的参数，文中指出较小的设置会使问题更频繁发生。"
    },
    {
      "term": "MTP",
      "briefZh": "多词元预测",
      "explanationZh": "指多词元预测技术，文中提到启用它时问题发生得更频繁。"
    },
    {
      "term": "RPC server",
      "briefZh": "远程调用服务器",
      "explanationZh": "通过远程过程调用接收任务的服务器，此处用于参与分布式模型运行。"
    },
    {
      "term": "vram",
      "briefZh": "显存",
      "explanationZh": "显卡上的内存，用于存放模型权重及运行时数据。"
    },
    {
      "term": "Dockerfile",
      "briefZh": "镜像构建文件",
      "explanationZh": "定义 Docker 镜像构建步骤的文件，文中用于构建使用 cuda12.6 的运行环境。"
    },
    {
      "term": "KV cache",
      "briefZh": "键值缓存",
      "explanationZh": "缓存模型注意力计算中的键和值，以避免生成时重复计算；文中将其设置为 q4_0。"
    },
    {
      "term": "batch size",
      "briefZh": "批次大小",
      "explanationZh": "一次批处理的数据规模，此处列出的测试范围为 512 - 2048。"
    },
    {
      "term": "ubatch size",
      "briefZh": "微批次大小",
      "explanationZh": "将批次拆分后实际执行计算的子批次大小，此处测试范围为 128 - 1024。"
    },
    {
      "term": "cache-reuse",
      "briefZh": "缓存复用",
      "explanationZh": "控制缓存复用的设置，此处比较设为 256 与关闭时的情况。"
    },
    {
      "term": "Vision Projector",
      "briefZh": "视觉投影器",
      "explanationZh": "将视觉特征映射到语言模型可处理的表示空间的组件。"
    },
    {
      "term": "Multimodal",
      "briefZh": "多模态",
      "explanationZh": "指能够处理文本、图像等不同类型信息的能力。"
    },
    {
      "term": "Speculative Decoding",
      "briefZh": "推测解码",
      "explanationZh": "先生成候选词元，再由主模型验证，以加速文本生成的解码方法。"
    }
