  "sourceTitle": "Speeds of a local Qwen3.8-27B on an M4 Max with 5 runtime/quant stacks and context from 32K to 256K",
  "sourceBodyHash": "cb6dc2f285501e0cf14daabc57ffcd5c386e659f635267b33a8648d6779ef35b",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
