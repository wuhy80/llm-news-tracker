  "wordWise": [
    {
      "term": "Mixture-of-Experts",
      "briefZh": "混合专家",
      "explanationZh": "由多个专家子网络组成的模型架构；此处通过路由为每个 token 选择部分专家参与计算。"
    },
    {
      "term": "active parameters",
      "briefZh": "激活参数",
      "explanationZh": "处理输入时实际参与计算的参数，区别于模型的总参数。"
    },
    {
      "term": "Pareto frontier",
      "briefZh": "帕累托前沿",
      "explanationZh": "质量与效率之间的最优权衡边界，在该边界上无法不牺牲一项而进一步改善另一项。"
    },
    {
      "term": "quantization-aware training",
      "briefZh": "量化感知训练",
      "explanationZh": "在训练过程中考虑量化影响，以帮助模型适应低精度表示。"
    },
    {
      "term": "FFN hidden dim",
      "briefZh": "前馈隐藏维度",
      "explanationZh": "前馈网络隐藏层的维度；此处路由专家为 640，共享专家为 2560。"
    },
    {
      "term": "top-k sigmoid routing",
      "briefZh": "专家路由机制",
      "explanationZh": "使用 sigmoid 路由分数选择得分最高的 k 个专家；此处每个 token 选择 4 个专家，并进行归一化。"
    },
    {
      "term": "tied input/output embeddings",
      "briefZh": "嵌入权重共享",
      "explanationZh": "输入嵌入与输出层使用同一组权重，而不是分别存储两组权重。"
    },
    {
      "term": "Context Length",
      "briefZh": "上下文长度",
      "explanationZh": "模型在一次处理过程中可容纳的上下文规模，通常以词元数衡量。"
    },
    {
      "term": "tokens",
      "briefZh": "词元",
      "explanationZh": "模型处理文本时使用的基本单位，可以是单词、单词的一部分或字符。"
    },
    {
      "term": "License",
      "briefZh": "许可证",
      "explanationZh": "规定模型使用、修改和分发等行为所需遵守的条款。"
    }
  ],
