  "sourceTitle": "Exploring a NORD × RHEA hybrid: a spiking/event-driven alternative to a fixed Transformer stack",
  "sourceBodyHash": "1a114cb63d8ec100628704c0f0489da3b6419d4f8bf6edd72627d3525eebc22a",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
