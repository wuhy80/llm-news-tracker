  "sourceTitle": "Understanding ChatGPT Work",
  "sourceBodyHash": "6d3dc45bea7d36155b20636c0a4d73db7454605b3a1cd28bfd6cdb0995945c4e",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
