  "sourceTitle": "Here my pretty good qwen3.8 27B setup, hope it helps",
  "sourceBodyHash": "a9f127c8805c4d797f47fd95ee0b0888a0d4abd2573523a3ce31f6c0bfb14bfb",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
