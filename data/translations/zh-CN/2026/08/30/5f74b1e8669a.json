    },
    {
      "id": "b0012",
      "kind": "list-item",
      "sourceHash": "6f8a07513cb91fe8",
      "translationZh": "4 个同时进行的智能体对话（示例见下文）",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0013",
      "kind": "paragraph",
      "sourceHash": "d0f4fe80afec57fa",
      "translationZh": "外部评测（lm-evaluation-harness，使用实际提供服务的量化检查点；- = Qwen 未公布 3.8-27B 的数值）",
      "provider": "nowcoding",
