    },
    {
      "id": "b0002",
      "kind": "list-item",
      "sourceHash": "a9a37105b0e4d0dd",
      "translationZh": "仅适用于 Blackwell 的方案，可在单张 RTX 5090 上运行 Qwen3.8-27B。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0003",
      "kind": "list-item",
      "sourceHash": "2f29e5bc88eecf49",
      "translationZh": "使用原生 sglang、NVFP4 模型（相当于 Q6）以及 DFLASH2 推测解码。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0004",
      "kind": "list-item",
      "sourceHash": "643b5dae5150d499",
      "translationZh": "提供可直接下载的检查点，无需构建步骤。非常适合 Hermes 和 Opencode。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "a146a562aae6e005",
      "translationZh": "完整方案 + 检查点",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0006",
      "kind": "paragraph",
      "sourceHash": "272207167688c2e3",
      "translationZh": "工作负载 单路 并行 x2",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0007",
      "kind": "paragraph",
      "sourceHash": "cd38803f43b775e8",
      "translationZh": "预填充（首个 token 耗时，3 次冷启动运行的平均值）：",
      "provider": "nowcoding",
