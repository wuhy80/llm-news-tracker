  "sourceTitle": "MindTopo reveals VLMs’ spatial reasoning abilities",
  "sourceBodyHash": "efca5400dbef5a34722a226ec14bc265c509967b6d3c5742cd2a5b544b9a136f",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
