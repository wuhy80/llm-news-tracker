  "wordWise": [
    {
      "term": "dense",
      "briefZh": "稠密",
      "explanationZh": "指采用稠密架构的模型，与每次仅激活部分专家的混合专家架构相区别。"
    },
    {
      "term": "decoder-only",
      "briefZh": "仅解码器架构",
      "explanationZh": "指模型仅使用解码器结构，按序生成后续 token。"
    },
    {
      "term": "context window",
      "briefZh": "上下文窗口",
      "explanationZh": "模型一次能够处理的上下文长度，文中以 token 数量衡量。"
    },
    {
      "term": "chain-of-thought",
      "briefZh": "思维链",
      "explanationZh": "通过中间推理步骤逐步得出答案的过程，文中用作监督微调数据。"
    },
    {
      "term": "agentic-trajectory data",
      "briefZh": "智能体轨迹数据",
      "explanationZh": "记录智能体执行任务时一系列行动及其过程的数据。"
    },
    {
      "term": "reinforcement learning",
      "briefZh": "强化学习",
      "explanationZh": "利用奖励信号优化模型行为的训练方法，文中用于多阶段后训练。"
    },
    {
      "term": "sandboxed environments",
      "briefZh": "沙箱环境",
      "explanationZh": "具有隔离和约束的执行环境，文中供模型学习使用工具执行操作。"
    },
    {
      "term": "native tool calling",
      "briefZh": "原生工具调用",
      "explanationZh": "模型自身具备的发起工具调用的能力。"
    },
    {
      "term": "chain of thought",
      "briefZh": "思维链",
      "explanationZh": "模型在给出答案前生成的中间推理过程。"
    },
    {
      "term": "multi-stage RL",
      "briefZh": "多阶段强化学习",
      "explanationZh": "分多个阶段开展的强化学习训练，用于提升模型的推理等能力。"
    },
    {
      "term": "supervised fine-tuning",
      "briefZh": "监督微调",
      "explanationZh": "使用带有目标回答的训练数据进一步训练模型，使其更好地遵循指令。"
    },
    {
      "term": "decoder-only dense transformer architecture",
      "briefZh": "仅解码器稠密架构",
      "explanationZh": "仅使用 Transformer 解码器组件、而非稀疏专家结构的模型架构。"
    },
    {
      "term": "Grouped Query Attention",
      "briefZh": "分组查询注意力",
      "explanationZh": "让多组查询头共享键和值头的注意力机制；文中配置为 40 个注意力头和 8 个 KV 头。"
    },
    {
      "term": "Rotary Position Embedding",
      "briefZh": "旋转位置嵌入",
      "explanationZh": "通过旋转变换将位置信息编码到注意力计算中的方法。"
    },
    {
      "term": "SwiGLU activation",
      "briefZh": "SwiGLU 激活",
      "explanationZh": "用于前馈网络 MLP 的门控激活机制。"
    },
    {
      "term": "RMSNorm",
      "briefZh": "均方根归一化",
      "explanationZh": "使用均方根对激活值进行缩放的归一化方法。"
    },
    {
      "term": "not tied",
      "briefZh": "不共享权重",
      "explanationZh": "指输入嵌入与输出嵌入使用独立的权重参数。"
    },
    {
      "term": "bfloat16",
      "briefZh": "脑浮点格式",
      "explanationZh": "一种16位浮点数格式，常用于模型训练和推理，具有与32位浮点数相同的指数位数。"
