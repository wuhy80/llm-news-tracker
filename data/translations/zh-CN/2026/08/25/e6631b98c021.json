  "wordWise": [
    {
      "term": "MoE LLM",
      "briefZh": "混合专家大模型",
      "explanationZh": "采用混合专家架构的大语言模型；处理每个 token 时，路由机制选择相应专家参与计算。"
    },
    {
      "term": "VRAM",
      "briefZh": "显存",
      "explanationZh": "GPU 使用的内存，用于存放模型数据、缓存及计算所需的数据。"
    },
    {
      "term": "parallel PCI-E transfers",
      "briefZh": "并行总线传输",
      "explanationZh": "通过 PCI-E 并行传输数据，文中用于在显存有限的多 GPU 系统中获取所需专家数据。"
    },
    {
      "term": "sparse KV offloading",
      "briefZh": "稀疏KV卸载",
      "explanationZh": "以稀疏方式将注意力机制的键值缓存卸载到显存之外，以减少显存占用并支持更长上下文。"
    },
    {
      "term": "lock-free",
      "briefZh": "无锁",
      "explanationZh": "指并发通信或数据操作不依赖锁机制，文中用于描述 Python 与 C++ 之间的快速通信。"
    },
    {
      "term": "IPC",
      "briefZh": "进程间通信",
      "explanationZh": "不同进程之间交换数据的机制，文中用于 Python 与 C++ 组件之间的通信。"
    },
    {
      "term": "DMA",
      "briefZh": "直接内存访问",
      "explanationZh": "允许硬件直接进行内存数据传输的机制，文中结合水位线队列用于降低传输延迟。"
    },
    {
      "term": "NUMA",
      "briefZh": "非统一内存访问",
      "explanationZh": "不同处理器访问不同内存区域时，延迟和带宽可能不同的内存架构；相关优化旨在改善内存访问效率。"
    },
    {
      "term": "KV compression",
      "briefZh": "KV 压缩",
      "explanationZh": "压缩注意力机制中的键和值数据，以降低缓存占用。"
    },
    {
      "term": "TP",
      "briefZh": "张量并行",
      "explanationZh": "指张量并行；此处 TP > 1 表示并行度大于 1。"
    },
    {
      "term": "KV Cache Sharding",
      "briefZh": "KV 缓存分片",
      "explanationZh": "将键值缓存拆分到多个设备上存储或处理。"
    },
    {
      "term": "Model Weight Sharding",
      "briefZh": "模型权重分片",
      "explanationZh": "将模型权重拆分到多个设备上，分摊存储需求。"
    },
    {
      "term": "Custom Kernel Optimizations",
      "briefZh": "自定义内核优化",
      "explanationZh": "针对底层计算内核进行定制优化，以改善执行效率。"
    },
    {
      "term": "Speculative Decoding",
      "briefZh": "推测解码",
      "explanationZh": "先生成候选 token，再进行验证，以加速生成的解码方法。"
    },
