      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0023",
      "kind": "paragraph",
      "sourceHash": "a05850391e73dcf3",
      "translationZh": "修复了钩子错误消息显示字面量 ${CLAUDE_PLUGIN_ROOT} 而非解析后的插件路径的问题。",
