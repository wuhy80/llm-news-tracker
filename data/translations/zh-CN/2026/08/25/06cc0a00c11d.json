      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0022",
      "kind": "paragraph",
      "sourceHash": "13e8acb9cee013fa",
      "translationZh": "修复了 /reload-plugins 对于在 skills/*/SKILL.md 下定义技能的插件报告技能数量为 0 的问题。",
