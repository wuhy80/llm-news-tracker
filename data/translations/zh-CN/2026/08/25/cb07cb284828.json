    },
    {
      "id": "b0021",
      "kind": "paragraph",
      "sourceHash": "56cd443b3d9da923",
      "translationZh": "tool_use - 141,389，涵盖 48 个子领域（函数调用，单步与多步）",
      "provider": "nowcoding",
