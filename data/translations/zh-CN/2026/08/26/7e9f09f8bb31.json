      "translationZh": "专家中间维度：2048",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0025",
      "kind": "paragraph",
      "sourceHash": "7f06eafbc59a2b60",
