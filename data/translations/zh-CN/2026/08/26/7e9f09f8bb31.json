  "wordWise": [
    {
      "term": "Fine-Tunes",
      "briefZh": "微调",
      "explanationZh": "在已有模型基础上继续训练，以适配特定任务、数据或行为偏好。"
    },
    {
      "term": "Abliterations",
      "briefZh": "拒绝机制消除",
      "explanationZh": "通过修改模型内部表示来削弱或移除拒绝回答行为的技术，通常不需要重新训练整个模型。"
    },
    {
      "term": "natively multimodal",
      "briefZh": "原生多模态",
      "explanationZh": "模型在自身架构与训练中直接支持多种模态，而非仅靠外接组件实现。"
    },
    {
      "term": "open-weight",
      "briefZh": "开放权重",
      "explanationZh": "公开提供模型权重；这并不必然意味着训练数据、训练代码等也全部开放。"
    },
    {
      "term": "agentic benchmarks",
      "briefZh": "智能体基准",
      "explanationZh": "用于评估模型以智能体方式执行任务的测试，例如规划步骤、调用工具和完成多步工作。"
    },
    {
      "term": "Linear Attention",
      "briefZh": "线性注意力",
      "explanationZh": "旨在使计算开销随序列长度近似线性增长的注意力机制，用于降低长序列处理成本。"
    },
    {
      "term": "top-k budget",
      "briefZh": "前k项预算",
      "explanationZh": "限定注意力机制选取多少个最高评分的词元；此处上限为 2048 个词元。"
    },
    {
      "term": "Manifold-Constrained Hyper-Connections",
      "briefZh": "流形约束超连接",
      "explanationZh": "一种加宽残差流并对层间混合施加流形约束的连接机制，此处用于提高规模扩展效率。"
    },
    {
      "term": "ViT",
      "briefZh": "视觉变换器",
      "explanationZh": "将图像划分为图像块并进行编码的 Transformer 架构，此处用作视觉编码器。"
    },
    {
      "term": "temporal patching",
      "briefZh": "时序分块",
      "explanationZh": "沿时间维度对视频内容进行分块，以编码跨帧信息。"
    },
    {
      "term": "MTP head",
      "briefZh": "多词元预测头",
      "explanationZh": "用于预测多个后续 token 的输出模块，此处随模型权重一同提供。"
    },
    {
      "term": "speculative tokens",
      "briefZh": "推测词元",
      "explanationZh": "推测解码中提前生成、随后需要验证的候选 token。"
    },
    {
      "term": "dynamic activation scaling",
      "briefZh": "动态激活缩放",
      "explanationZh": "根据激活值动态调整缩放系数，以适配低精度数值表示。"
    },
    {
      "term": "Causal Language Model",
      "briefZh": "因果语言模型",
      "explanationZh": "根据此前的 token 预测后续 token 的语言模型。"
    },
    {
      "term": "Vision Encoder",
      "briefZh": "视觉编码器",
      "explanationZh": "将图像或视频输入转换为模型可处理的特征表示的模块。"
    },
    {
      "term": "MoE",
      "briefZh": "混合专家",
      "explanationZh": "通过路由机制选择部分专家网络参与计算的架构，使每次计算只激活部分参数。"
    },
    {
      "term": "Sparse Attention",
      "briefZh": "稀疏注意力",
      "explanationZh": "仅对选定位置计算注意力的机制，此处用于 11 层。"
    },
    {
      "term": "Attention Heads",
      "briefZh": "注意力头",
      "explanationZh": "注意力机制中并行处理不同表示的计算单元。"
    },
    {
      "term": "Indexer",
      "briefZh": "索引器",
      "explanationZh": "用于选择需要关注的位置的组件，此处配置为 32 个头。"
    },
    {
      "term": "routed",
      "briefZh": "路由专家",
      "explanationZh": "指由路由机制选择并激活的专家，与共享专家相对。"
    },
    {
      "term": "shared",
      "briefZh": "共享专家",
      "explanationZh": "指共享使用、不依赖路由选择的专家。"
    },
    {
      "term": "Expert Intermediate Dimension",
      "briefZh": "专家中间维度",
      "explanationZh": "专家网络中间层表示的维度，此处为 2048。"
    },
    {
      "term": "Dense Intermediate Dimension",
      "briefZh": "稠密中间维度",
