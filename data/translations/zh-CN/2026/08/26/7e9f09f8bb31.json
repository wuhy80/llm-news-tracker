    },
    {
      "id": "b0026",
      "kind": "paragraph",
      "sourceHash": "760556750fcc4a48",
      "translationZh": "上下文长度：1,048,576 个 token（ max_position_embeddings ）；评估时使用 300K 文本 / 164K 视觉 token",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0027",
      "kind": "paragraph",
      "sourceHash": "4a1be53a3a68f893",
      "translationZh": "深度：24 层，隐藏维度 1024，16 个注意力头",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0028",
      "kind": "paragraph",
      "sourceHash": "15802a8c056dce76",
      "translationZh": "图像尺寸：448 x 448，图像块大小：14",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0029",
      "kind": "paragraph",
      "sourceHash": "200b947ed7c32c29",
      "translationZh": "空间合并：2 x 2，时间块：2（视频）",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0030",
      "kind": "paragraph",
      "sourceHash": "2415a0cb727a4316",
      "translationZh": "输出投影：4096（语言模型隐藏维度）",
