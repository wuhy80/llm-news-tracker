  "sourceTitle": "GitHub Copilot app for Beginners: Automate Dependabot pull request triage",
  "sourceBodyHash": "55d40b323f0a915e28bd2ee115cadd1fa6cc5551c7ece7966ff9c62a61824e8a",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
