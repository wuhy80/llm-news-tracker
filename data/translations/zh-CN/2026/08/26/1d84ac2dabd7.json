  "wordWise": [
    {
      "term": "Abliterations",
      "briefZh": "去拒绝化",
      "explanationZh": "指通过修改模型内部表示等方式，削弱或移除模型拒绝回答的行为。"
    },
    {
      "term": "open-weight",
      "briefZh": "开放权重",
      "explanationZh": "指公开模型权重，使他人能够获取并运行模型；不一定意味着训练数据或全部代码也已公开。"
    },
    {
      "term": "Hybrid Attention",
      "briefZh": "混合注意力",
      "explanationZh": "指组合不同注意力机制；此处将 Gated DeltaNet 与 QSA 配对使用。"
    },
    {
      "term": "agentic workloads",
      "briefZh": "智能体工作负载",
