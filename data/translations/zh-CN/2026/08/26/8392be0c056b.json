  "sourceTitle": "Strix 128 + eGPU 32 or 48, thoughts/concerns please",
  "sourceBodyHash": "1426a5efd6314c0d34133be0f8af3b5ebcd53b98199cfa7f64785db6e7cbbb4e",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
