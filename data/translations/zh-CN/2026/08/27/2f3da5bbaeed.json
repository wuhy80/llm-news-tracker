  "sourceTitle": "OpenCode Senses: The most advanced Local Vision Plugin for OpenCode That Actually Understands Images",
  "sourceBodyHash": "ffb3ce528089108a58b607bf26db3a8ed0c1c3f0d0247953ee3112abb39689f4",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
