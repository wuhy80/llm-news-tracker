    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "772f8f68a64f31c0",
      "translationZh": "查看由 Kuan-Hao Tseng 及另外 5 位作者撰写的论文《FaulT-Bench：面向不可靠用户工单下的网络故障排查 LLM 智能体基准评测》的 PDF",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0006",
      "kind": "paragraph",
      "sourceHash": "215d3f17e4b9e713",
      "translationZh": "查看 PDF HTML（实验性）",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
