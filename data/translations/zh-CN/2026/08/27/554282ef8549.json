  "wordWise": [
    {
      "term": "TTS",
      "briefZh": "文本转语音",
      "explanationZh": "Text-to-Speech 的缩写，指将文本转换为语音的技术。"
    },
    {
      "term": "zero-shot voice cloning",
      "briefZh": "零样本声音克隆",
      "explanationZh": "无需针对目标说话人专门训练，仅凭参考音频即可模仿其声音生成语音。"
    },
    {
      "term": "reference audio",
      "briefZh": "参考音频",
      "explanationZh": "用于提供目标说话人声音特征的音频片段。"
    },
    {
      "term": "Streaming",
      "briefZh": "流式输出",
      "explanationZh": "在语音生成过程中逐段输出音频，而不必等待整段生成完毕。"
