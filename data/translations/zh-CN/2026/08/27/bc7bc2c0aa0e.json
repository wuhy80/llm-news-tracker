  "sourceTitle": "Closed-Loop Cooling Explained: The Plumbing Behind Meta’s AI",
  "sourceBodyHash": "8783c5406c9446207f0f5dcaaea7ce5a85d71db3b3717ad75bff5d1c7cfba6f0",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
