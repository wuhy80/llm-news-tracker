  "sourceTitle": "Build agentic creative workflows with Amazon Quick and fal",
  "sourceBodyHash": "67d9f4e079ce82aee13a1909e43e9c46534054d5ebc979451be5aadb770322f8",
  "sourceLanguage": "en",
