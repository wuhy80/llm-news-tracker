  "totalBlocks": 13,
  "translatedBlocks": 12,
  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "6ece60a60ca8be8b",
      "translationZh": "在这里潜水很久了。每次有新模型发布，我都要手动计算 VRAM 需求，于是就做了一个静态网站计算器来代劳：",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0002",
      "kind": "list-item",
      "sourceHash": "721433cf9af61f07",
      "translationZh": "选择你的 GPU（或笔记本 GPU 及其实际 TGP，或 Mac Studio / DGX Spark / Ryzen AI Max+ 这类统一内存硬件），即可查看哪些模型能装得下、需要采用哪种量化方式，以及预估运行速度",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0003",
      "kind": "list-item",
      "sourceHash": "7f985abfc63b8c10",
      "translationZh": "也可以先选模型，再获取按预算、全新/二手、形态规格和功耗筛选的 GPU 推荐",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0004",
      "kind": "list-item",
      "sourceHash": "596584d136a56a45",
      "translationZh": "涵盖生成式 LLM、嵌入、重排序器、OCR、文档/通用 VLM、图像/视频生成、数字人/唇形同步、STT/TTS，而不只是聊天模型",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0005",
      "kind": "list-item",
      "sourceHash": "6ced6c6ee7dc67e5",
      "translationZh": "如果你要将多个模型分配到多张显卡上，还有多 GPU 模型组合规划工具",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0006",
      "kind": "list-item",
      "sourceHash": "f5269a2496713d1b",
      "translationZh": "每项规格都标注了来源（模型官方页面、产品系列官方页面、第三方参考资料或社区实测），让你一眼就能分辨哪些可靠、哪些只是粗略估计",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0007",
      "kind": "list-item",
      "sourceHash": "da14f2523f87d492",
      "translationZh": "可通过 GitHub Issue 模板提交社区基准测试结果——如果你有目前测试覆盖较少的硬件，非常欢迎提供实测数据",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0008",
      "kind": "list-item",
      "sourceHash": "93ae44b65ced10d7",
      "translationZh": "没有后端，无需账号，也没有遥测——这就是一个静态 GitHub Pages 网站",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0009",
      "kind": "paragraph",
      "sourceHash": "da79c8ca0bbe9215",
      "translationZh": "刚刚新增：MLX 作为第 4 种运行时选项（与 llama.cpp/Ollama、vLLM、Transformers 并列），仅限 Apple Silicon GPU 使用。我不想编造速度数据，所以这个倍数是根据一份已发布的 llama.cpp 与 MLX 基准测试对比表校准的（M4 Max 64GB + M3 Pro 36GB，Q4_K_M 对比 MLX 4-bit），而不是根据我自己的测试；我还根据观察到的提升幅度，保守地向下取整。如果这里有人真的在自己的 Mac 上对 MLX 和 llama.cpp 做了基准测试，我很希望能得到一个真实数据点，用来替换这个估算值，或让它更准确。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0011",
      "kind": "paragraph",
      "sourceHash": "f928396f3f14268f",
      "translationZh": "在线版：https://jaeseok614.github.io/llm-gpu-checker-ko/（右上角有 EN 切换按钮）",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0012",
      "kind": "paragraph",
      "sourceHash": "6237d6daa1dcf803",
      "translationZh": "很希望听听本版大家的反馈，看看哪些数据不准确——这个社区实际使用的硬件种类，比我自己能测试的丰富得多。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0013",
      "kind": "paragraph",
      "sourceHash": "f561e67099b9e98c",
      "translationZh": "由 /u/jaeseok614 提交",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    }
  ],
  "wordWise": [
    {
      "term": "VRAM",
      "briefZh": "显存",
      "explanationZh": "GPU 用来存放模型权重及运行中数据的内存，其容量会影响能运行哪些模型。"
    },
    {
      "term": "TGP",
      "briefZh": "总图形功耗",
      "explanationZh": "显卡的总功耗指标；文中要求填写笔记本 GPU 的实际 TGP，以便估算性能。"
    },
    {
      "term": "unified-memory",
      "briefZh": "统一内存",
      "explanationZh": "CPU 与 GPU 等处理单元共享内存的硬件架构。"
    },
    {
      "term": "quantization",
      "briefZh": "量化",
      "explanationZh": "用较低精度表示模型数值，以降低内存需求；不同量化方式会影响模型能否装入显存。"
    },
    {
      "term": "reranker",
      "briefZh": "重排序器",
      "explanationZh": "对初步检索得到的候选结果重新评分、排序的模型。"
    },
    {
      "term": "VLM",
      "briefZh": "视觉语言模型",
      "explanationZh": "处理视觉与语言信息的模型，文中包括文档专用和通用类型。"
    },
    {
      "term": "STT/TTS",
      "briefZh": "语音转文/文转语音",
      "explanationZh": "分别指将语音转换为文本，以及将文本转换为语音。"
    },
    {
      "term": "telemetry",
      "briefZh": "遥测",
      "explanationZh": "自动收集并发送使用情况或运行数据的机制；作者表示该网站不包含此机制。"
    },
    {
      "term": "runtime option",
      "briefZh": "运行时选项",
      "explanationZh": "指可选择的模型执行框架或后端。"
    },
    {
      "term": "multiplier",
      "briefZh": "倍率",
      "explanationZh": "此处指根据基准测试结果估算的速度提升倍数。"
    },
    {
      "term": "calibrated",
      "briefZh": "校准",
      "explanationZh": "依据已发布的测试数据调整估算值，使其更贴近实际表现。"
    },
    {
      "term": "benchmark table",
      "briefZh": "基准测试表",
      "explanationZh": "汇总不同软硬件配置下性能测试结果的对比表。"
    },
    {
      "term": "Q4_K_M",
      "briefZh": "量化格式",
      "explanationZh": "llama.cpp 使用的一种模型量化格式，此处与 MLX 4-bit 的测试表现进行比较。"
    },
    {
      "term": "rounded down",
      "briefZh": "向下取整",
      "explanationZh": "将观察到的提升倍数向较小的整数取整，以避免高估。"
    },
    {
      "term": "data point",
      "briefZh": "数据点",
      "explanationZh": "一次实际测试得到的结果，可用于替换或改进当前估算。"
    }
  ],
