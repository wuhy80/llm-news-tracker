    },
    {
      "id": "b0046",
      "kind": "paragraph",
      "sourceHash": "268bbf794c296bcc",
      "translationZh": "gpt-oss-120b（117B 混合专家模型）",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0047",
      "kind": "paragraph",
      "sourceHash": "ba332b4b5d31cfab",
      "translationZh": "弱 / 选择性",
      "provider": "nowcoding",
