    },
    {
      "id": "b0050",
      "kind": "paragraph",
      "sourceHash": "f4e0083fd58e5298",
      "translationZh": "精选检索",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0054",
      "kind": "paragraph",
      "sourceHash": "1369efd87bf92701",
      "translationZh": "表现强劲，仍有提升空间",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0057",
      "kind": "paragraph",
      "sourceHash": "192888c9e6ff386b",
      "translationZh": "完整指南集",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0061",
      "kind": "paragraph",
      "sourceHash": "1369efd87bf92701",
      "translationZh": "表现强劲，仍有提升空间",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0064",
      "kind": "paragraph",
      "sourceHash": "192888c9e6ff386b",
      "translationZh": "完整指南集",
      "provider": "nowcoding",
