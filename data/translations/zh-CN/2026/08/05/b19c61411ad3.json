  "sourceTitle": "Cloudflare OS: an open platform for agents, apps, and work",
  "sourceBodyHash": "2f3fac8ec1ab7b42dce64c650c0a2ffd1c9d37a7255ac4535aafdb716383d406",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
