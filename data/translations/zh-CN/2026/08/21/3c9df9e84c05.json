    },
    {
      "id": "b0079",
      "kind": "paragraph",
      "sourceHash": "97de7adc733b569e",
      "translationZh": "音频中说的内容",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0080",
      "kind": "paragraph",
      "sourceHash": "ff9c14d110155ca0",
      "translationZh": "在预算委员会，我们就 ⟨已静音⟩ 预算草案的超过一千六百项修正案进行了投票……在……进行了投票……",
      "provider": "nowcoding",
