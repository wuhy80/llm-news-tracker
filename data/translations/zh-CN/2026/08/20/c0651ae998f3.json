  "wordWise": [
    {
      "term": "draft model",
      "briefZh": "草稿模型",
      "explanationZh": "用于快速生成候选词元的轻量级模型，生成结果随后由目标模型验证。"
    },
    {
      "term": "speculative decoding",
      "briefZh": "推测解码",
      "explanationZh": "先生成候选词元，再由目标模型批量验证，以加快解码且不改变输出质量。"
    },
    {
      "term": "throughput",
      "briefZh": "吞吐量",
      "explanationZh": "推理系统单位时间内能够处理或生成的词元数量。"
    },
    {
      "term": "function-calling latency",
      "briefZh": "函数调用延迟",
      "explanationZh": "模型生成函数调用所需的时间延迟。"
    },
    {
      "term": "memory-bound",
      "briefZh": "内存带宽受限",
      "explanationZh": "性能主要受内存数据传输速度限制，而非计算能力限制。"
    },
    {
      "term": "forward pass",
      "briefZh": "前向传播",
      "explanationZh": "输入经过模型各层计算并产生输出的一次过程。"
    },
    {
      "term": "hidden states",
      "briefZh": "隐藏状态",
      "explanationZh": "模型内部为词元计算出的中间表示，用于后续预测。"
    },
    {
      "term": "Markov chain",
      "briefZh": "马尔可夫链",
      "explanationZh": "一种序列概率模型，此处用于建模相邻词元之间的依赖关系。"
    },
    {
      "term": "acceptance rate",
      "briefZh": "接受率",
      "explanationZh": "草稿模型提出的词元通过验证并被接受的比例。"
    },
    {
      "term": "survival probability",
      "briefZh": "存活概率",
      "explanationZh": "此处指某个词元通过验证并被保留的概率。"
    },
    {
      "term": "suffixes",
      "briefZh": "后缀序列",
      "explanationZh": "词元序列中从某个位置起直到末尾的部分，此处可因置信度低而被剪除。"
    },
    {
      "term": "SFT",
      "briefZh": "监督微调",
      "explanationZh": "利用带有目标输出的示例对模型进行微调，此处指用于此类训练的数据。"
    },
    {
      "term": "ablations",
      "briefZh": "消融实验",
      "explanationZh": "通过移除或改变模型组件、配置来评估其作用的实验。"
    },
    {
      "term": "draft models",
      "briefZh": "草稿模型",
      "explanationZh": "先生成候选词元、再交由验证器检查的模型。"
    },
    {
      "term": "epochs",
      "briefZh": "训练轮次",
      "explanationZh": "每个轮次表示模型遍历整个训练数据集一次。"
    },
    {
      "term": "Decoder stack",
      "briefZh": "解码器堆栈",
      "explanationZh": "由多个解码器层堆叠而成的模型结构。"
    },
    {
      "term": "layers",
      "briefZh": "网络层",
      "explanationZh": "神经网络中逐层处理信息的计算单元；此处解码器堆栈包含 5 层。"
    },
    {
      "term": "Hidden-state projection",
      "briefZh": "隐藏状态投影",
      "explanationZh": "将模型内部的隐藏状态映射到目标表示空间的操作。"
    },
    {
      "term": "Markov head",
      "briefZh": "马尔可夫头",
      "explanationZh": "采用马尔可夫建模方式的模型输出头。"
    },
    {
      "term": "Norms",
      "briefZh": "归一化层",
      "explanationZh": "在模型组件语境中，指用于归一化处理的层。"
    },
    {
      "term": "confidence head",
      "briefZh": "置信度头",
      "explanationZh": "用于输出模型预测置信度的模块。"
    },
    {
      "term": "greedy decoding",
      "briefZh": "贪心解码",
      "explanationZh": "每一步都选择模型认为概率最高的词元的解码方式。"
    },
    {
      "term": "draft token",
      "briefZh": "草稿词元",
      "explanationZh": "预先提出、等待目标模型验证是否接受的候选词元。"
    },
    {
      "term": "target model",
      "briefZh": "目标模型",
      "explanationZh": "负责验证草稿词元，并在拒绝时提供替代词元的模型。"
    }
  ],
