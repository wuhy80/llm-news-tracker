  "sourceTitle": "Qwen3.8-27b q8 KV cache does seem to actually hurt model performance",
  "sourceBodyHash": "5c39ffe34ea4848d6f4f2ab4318849683c7eafd6aafc1f281c6e9778ba48e56f",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
