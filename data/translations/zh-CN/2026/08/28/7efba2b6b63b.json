    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "54165a112d69ac39",
      "translationZh": "查看由 Yupei Liu、Yuqi Jia、Neil Zhenqiang Gong 和 Jinyuan Jia 撰写的论文《LongPIBench：面向提示注入的长上下文基准》的 PDF",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0006",
      "kind": "paragraph",
      "sourceHash": "215d3f17e4b9e713",
