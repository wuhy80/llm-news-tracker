  "sourceTitle": "Qwen3.8-Flash on RTX3090 + 64GB RAM (but you only need 12GB VRAM)",
  "sourceBodyHash": "731fcdcbe4465b0ee41a888af074c5d8d72a1944678f9307a15628c6a34e8931",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
