  "sourceTitle": "How canvases make agentic workflows visible, steerable, and cost-efficient",
  "sourceBodyHash": "82e8b5006c4b177aa4e8d756c5dc6ffab88c850d61fc17f40e4dd0e9a1b6aefa",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
