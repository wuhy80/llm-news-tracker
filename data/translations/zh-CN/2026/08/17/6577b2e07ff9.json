    },
    {
      "id": "b0043",
      "kind": "paragraph",
      "sourceHash": "dee34f535f3e9041",
      "translationZh": "利用率",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0044",
