    },
    {
      "id": "b0108",
      "kind": "list-item",
      "sourceHash": "d246635a332b6531",
      "translationZh": "专用化胜过规模：大多数 AI 采购决策忽视的战略变量",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0109",
      "kind": "list-item",
      "sourceHash": "012a6e1697e1eec8",
      "translationZh": "文本退化：大多数基准测试未追踪的生产环境故障模式",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0110",
      "kind": "list-item",
      "sourceHash": "d0fc6324598eb407",
      "translationZh": "聊天机器人之外的直接偏好优化",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0112",
      "kind": "paragraph",
      "sourceHash": "47bd05ab5b306d0f",
      "translationZh": "在 Hugging Face 上探索 Dharma AI，试用我们的交互式演示，下载我们的开源模型，并了解专用 AI 系统如何在真实的企业应用中超越通用模型。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    }
  ],
  "wordWise": [
    {
      "term": "constraint-aware GPU allocator",
      "briefZh": "约束感知分配器",
      "explanationZh": "在决定如何分配 GPU 时，将作业的资源需求、运行连续性等约束纳入考虑的分配器。"
    },
    {
      "term": "FIFO scheduler",
      "briefZh": "先进先出调度器",
      "explanationZh": "按照作业到达的先后顺序进行调度的调度器，文中用作性能比较的基准。"
    },
    {
      "term": "percentage points",
      "briefZh": "百分点",
      "explanationZh": "两个百分比数值之间的绝对差值，用于表示利用率的提升，区别于百分比增幅。"
    },
    {
      "term": "priority-weighted output",
      "briefZh": "优先级加权产出",
      "explanationZh": "根据作业优先级对产出赋予不同权重后计算的指标，用于衡量调度带来的价值。"
    },
    {
      "term": "timestep",
