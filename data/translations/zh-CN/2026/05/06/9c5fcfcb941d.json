  "sourceTitle": "vLLM V0 to V1: Correctness Before Corrections in RL",
  "sourceBodyHash": "b2b05cb65d5ea9dde1660aca0d5747d7bdc2a2388989f1ab91ee53923b988ee5",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
