    {
      "id": "b0004",
      "kind": "paragraph",
      "sourceHash": "154216598310b680",
      "translationZh": "你现有的订阅可让你访问 Grok 模型，包括为 Grok Build 提供支持的模型 grok-build-0.1。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
