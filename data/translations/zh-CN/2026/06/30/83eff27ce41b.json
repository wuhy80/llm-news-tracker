    },
    {
      "id": "b0102",
      "kind": "list-item",
      "sourceHash": "09000a1e65e9b4e3",
      "translationZh": "开源代码",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0103",
      "kind": "paragraph",
      "sourceHash": "1d8999dd9e59d036",
      "translationZh": "研究人员可以比较智能体架构和技术。实践者可以使用 ScarfBench 评估现代化改造解决方案，然后再将其部署到生产环境中。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
