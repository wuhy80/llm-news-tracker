  "sourceTitle": "ScarfBench: Benchmarking AI Agents for Enterprise Java Framework Migration",
  "sourceBodyHash": "f103f32a2509ff7e2eddf8695a4a24cbfd3bdcb6875f30860376acece8a59bd8",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
