  "sourceTitle": "We got local models to triage the OpenClaw repo for FREE!*",
  "sourceBodyHash": "86b57dfe6fa59d4452d6d5790341d64f7fe147fc49fe5d05e715d3b2fc2ecb5d",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
