  "sourceTitle": "Using Local Coding Agents",
  "sourceBodyHash": "e46de75d8676eb4976ffe6231607d780d1554cd2bb5c61ba7a27a1d449afb224",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
