    },
    {
      "id": "b0050",
      "kind": "list-item",
      "sourceHash": "a54cbc1a95c4bd5c",
      "translationZh": "🤖 JAT 模型",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
