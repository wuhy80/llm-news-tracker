  "sourceTitle": "The Open Medical-LLM Leaderboard: Benchmarking Large Language Models in Healthcare",
  "sourceBodyHash": "025c02d29649005e5ca7cee5d5c09edeadb6149f0e37bedf4707546cfe0094ee",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
