    },
    {
      "term": "Integration",
      "briefZh": "集成",
      "explanationZh": "将模型或工具与其他平台、服务连接起来，使其协同工作。"
    },
    {
      "term": "Code benchmarks",
      "briefZh": "代码基准测试",
      "explanationZh": "用于衡量模型代码相关能力的标准化测试。"
    },
    {
      "term": "Evaluation Results",
      "briefZh": "评估结果",
      "explanationZh": "模型在评估任务或测试中得到的表现结果。"
