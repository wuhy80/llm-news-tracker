    },
    {
      "term": "code completion",
      "briefZh": "代码补全",
      "explanationZh": "根据已有代码上下文预测并补充后续或缺失的代码。"
    },
    {
      "term": "Code Infilling",
      "briefZh": "代码填充",
      "explanationZh": "依据缺失位置前后的代码上下文，生成中间缺失的代码片段。"
    },
    {
      "term": "latency",
      "briefZh": "延迟",
      "explanationZh": "从发出请求到模型返回结果所需的时间。"
    },
    {
      "term": "instruction following",
      "briefZh": "指令遵循",
      "explanationZh": "模型理解并按用户指令完成任务的能力。"
    },
    {
      "term": "context size",
      "briefZh": "上下文大小",
      "explanationZh": "模型一次能够处理的上下文容量，通常以词元数衡量。"
    },
    {
