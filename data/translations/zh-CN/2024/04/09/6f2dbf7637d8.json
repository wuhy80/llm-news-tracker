      "briefZh": "检查点",
      "explanationZh": "保存的模型参数状态，可用于加载模型并运行。"
    },
    {
      "term": "full-precision",
      "briefZh": "全精度",
      "explanationZh": "指模型参数尚未通过量化降低数值精度。"
