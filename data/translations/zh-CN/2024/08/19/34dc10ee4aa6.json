    },
    {
      "id": "b0017",
      "kind": "paragraph",
      "sourceHash": "8818b4d7df7e8d02",
      "translationZh": "让我们开始吧！🚀 你也可以通过这个 Jupyter Notebook 跟着操作。",
      "provider": "nowcoding",
