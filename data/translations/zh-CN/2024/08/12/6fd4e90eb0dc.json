  "sourceUrl": "https://huggingface.co/blog/falconmamba",
  "sourceTitle": "Welcome Falcon Mamba: The first strong attention-free 7B model",
  "sourceBodyHash": "1386137a625965c91ef5f15bffa359b4a81b56145045d46277d49a81f55e6a4c",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
