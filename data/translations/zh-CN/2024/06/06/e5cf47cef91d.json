  "sourceTitle": "Generalizing an LLM from 8k to 1M Context using Qwen-Agent",
  "sourceBodyHash": "a1dfe1ef2450d5fb95f3499a791f8c55ceab4ce62350e03685c76515cccbed54",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
