      "translationZh": "推理时间（秒）",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0045",
      "kind": "paragraph",
      "sourceHash": "94b205cadab5750b",
      "translationZh": "内存（GB）",
      "provider": "nowcoding",
