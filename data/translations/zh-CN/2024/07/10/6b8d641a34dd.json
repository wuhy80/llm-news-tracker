  "sourceTitle": "Announcing New Hugging Face and KerasHub integration",
  "sourceBodyHash": "c717b57f9aa529a0490ef57c0622f75b0272036faaa36769d7305af816d9a59d",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
