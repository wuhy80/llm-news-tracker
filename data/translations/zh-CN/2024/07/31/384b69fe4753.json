    },
    {
      "id": "b0087",
      "kind": "heading",
      "sourceHash": "07a250b64c77b67b",
      "translationZh": "与 Transformers 配合使用",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0088",
      "kind": "paragraph",
      "sourceHash": "cfa0938839c542d4",
      "translationZh": "你可以按如下方式将 shieldgemma-2b 与 transformers 配合使用：",
      "provider": "nowcoding",
