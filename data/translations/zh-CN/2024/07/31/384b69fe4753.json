  "wordWise": [
    {
      "term": "on-device",
      "briefZh": "端侧",
      "explanationZh": "指直接在用户设备上运行模型，而非在远程服务器上运行。"
    },
    {
      "term": "safety classifiers",
      "briefZh": "安全分类器",
      "explanationZh": "用于识别输入或输出中的安全风险内容，以帮助应用进行过滤的模型。"
    },
    {
      "term": "sparse autoencoders",
      "briefZh": "稀疏自编码器",
      "explanationZh": "将输入编码为稀疏特征并尝试重建输入的模型，可用于分析模型的内部表示。"
    },
    {
      "term": "decoder-only",
      "briefZh": "仅解码器",
      "explanationZh": "指模型架构仅包含解码器，不包含独立的编码器。"
    },
    {
      "term": "open weights",
      "briefZh": "开放权重",
      "explanationZh": "指模型的训练后参数对外提供，供用户获取和使用。"
    },
    {
      "term": "instruction-tuned",
      "briefZh": "指令微调",
      "explanationZh": "指经过指令数据微调，使模型更能遵循用户指令。"
    },
    {
      "term": "logit soft-capping",
      "briefZh": "logit 软截断",
      "explanationZh": "通过平滑变换限制 logit 数值幅度，而非直接进行硬截断的技术。"
    },
    {
      "term": "bfloat16",
      "briefZh": "16位浮点格式",
