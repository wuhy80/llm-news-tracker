    },
    {
      "id": "b0038",
      "kind": "paragraph",
      "sourceHash": "6960228bac5a04f2",
      "translationZh": "Llama 2 许可证",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0043",
      "kind": "paragraph",
      "sourceHash": "fca8564849fe2efa",
