    },
    {
      "id": "b0084",
      "kind": "paragraph",
      "sourceHash": "ae1483583dbbb407",
      "translationZh": "如需使用套娃表示学习训练嵌入模型，或将其与其他 Sentence Transformers 技术结合使用，可参阅：",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0085",
      "kind": "list-item",
      "sourceHash": "895c90bd3e5a0cf2",
      "translationZh": "使用 Sentence Transformers 训练和微调嵌入模型：端到端训练指南，涵盖 MatryoshkaLoss 以及其他损失函数。",
      "provider": "nowcoding",
