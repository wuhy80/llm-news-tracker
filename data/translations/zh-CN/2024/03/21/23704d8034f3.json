  "sourceTitle": "Introducing the Chatbot Guardrails Arena",
  "sourceBodyHash": "fcf24dcb0446330cbb5701b0b1e94607b9de45860fbb25d4d5dc93097fb33228",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
