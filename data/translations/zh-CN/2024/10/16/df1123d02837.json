  "sourceTitle": "Fixing Gradient Accumulation",
  "sourceBodyHash": "29bf772a25aba7bc562cb3ea313aa4edfb911db7b3c014799722086badf27ad3",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
