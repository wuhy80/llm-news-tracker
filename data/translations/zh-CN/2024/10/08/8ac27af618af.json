  "wordWise": [
    {
      "term": "speculative decoding",
      "briefZh": "推测解码",
      "explanationZh": "先由较快的草稿模型生成候选词元，再由目标模型并行验证，以加速文本生成。"
    },
    {
      "term": "autoregressively",
      "briefZh": "以自回归方式",
      "explanationZh": "根据已有序列逐个预测并生成后续词元。"
    },
    {
      "term": "forward pass",
      "briefZh": "前向传播",
      "explanationZh": "输入数据通过模型计算并产生输出的一次过程。"
    },
    {
      "term": "speculation lookahead",
      "briefZh": "推测前瞻长度",
      "explanationZh": "草稿模型在每次推测迭代中生成的词元数量，文中简称 SL。"
    },
    {
      "term": "heuristics",
      "briefZh": "启发式规则",
      "explanationZh": "依据经验或简化规则调整策略的方法，不保证得到最优结果。"
    },
    {
      "term": "acceptance rate",
      "briefZh": "接受率",
      "explanationZh": "当前迭代中，草稿模型生成的候选词元被目标模型接受的比例。"
    },
    {
      "term": "oracle",
      "briefZh": "预言机",
      "explanationZh": "用于测试的理想化机制，通过比较草稿模型与目标模型的预测，确定每次迭代的最优前瞻长度。"
    },
    {
