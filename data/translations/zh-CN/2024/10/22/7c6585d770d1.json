  "sourceTitle": "Hugging Face Teams Up with Protect AI: Enhancing Model Security for the ML Community",
  "sourceBodyHash": "158511de5bbe23bb3d6e3185c620ad989a0fc27bbf7a0b2b310664c84f82e89e",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
