  "sourceTitle": "Introducing SynthID Text",
  "sourceBodyHash": "da962f8bd537c76cbaf399eebec3f7734ad70c896f8a2f66b977b25df1214d0b",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
