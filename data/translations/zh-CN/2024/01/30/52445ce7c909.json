      "term": "quantization",
      "briefZh": "量化",
      "explanationZh": "使用较低位宽的数值表示模型参数或计算数据，以降低资源需求并加速推理。"
    },
    {
      "term": "assisted generation",
      "briefZh": "辅助生成",
      "explanationZh": "借助辅助模型等机制协助主模型生成输出，以加快生成过程。"
    },
    {
      "term": "function signature",
      "briefZh": "函数签名",
      "explanationZh": "描述函数名称、参数等接口信息的部分，本文中作为代码补全题目的一部分提供给模型。"
    },
    {
      "term": "docstring",
      "briefZh": "文档字符串",
      "explanationZh": "写在函数等对象内部、用于说明其用途和行为的字符串。"
    },
    {
      "term": "pass@1",
      "briefZh": "单次通过率",
      "explanationZh": "衡量模型为每道题生成一个候选解时，该解通过测试的比例或概率的指标。"
    },
    {
      "term": "Time To First Token",
      "briefZh": "首词元时间",
      "explanationZh": "从请求开始到模型生成首个输出词元所需的时间，缩写为 TTFT。"
    },
    {
      "term": "Time Per Output Token",
      "briefZh": "每词元耗时",
      "explanationZh": "模型生成每个输出词元所需的时间，缩写为 TPOT，用于衡量输出生成速度。"
    },
    {
      "term": "GEMM",
      "briefZh": "通用矩阵乘法",
      "explanationZh": "通用矩阵乘法运算，是深度学习训练和推理中的核心计算操作之一。"
    },
    {
      "term": "auto-regressive",
      "briefZh": "自回归",
      "explanationZh": "指基于此前已有的序列内容，逐步生成下一个 token 的方式。"
    },
    {
      "term": "Weight Only Quantization",
      "briefZh": "仅权重量化",
      "explanationZh": "只量化模型权重而不量化激活值，计算时需将权重反量化至较高精度。"
    },
    {
      "term": "dequantization",
      "briefZh": "反量化",
      "explanationZh": "将量化后的低精度数值转换回较高精度表示的过程。"
    },
    {
      "term": "Static Quantization",
      "briefZh": "静态量化",
      "explanationZh": "通过校准预先确定量化参数，并对权重和激活值进行量化的方法。"
    },
    {
      "term": "post training quantization",
      "briefZh": "训练后量化",
      "explanationZh": "在模型训练完成后进行量化，以降低模型数值表示的精度。"
    },
    {
      "term": "outliers",
      "briefZh": "离群值",
      "explanationZh": "本文指激活值中特定通道内幅值异常大的数值，会影响量化效果。"
    },
    {
      "term": "underflowed",
      "briefZh": "发生下溢",
      "explanationZh": "指数值幅度过小，无法在所用数值表示范围内得到有效表示。"
    },
    {
      "term": "calibration dataset",
      "briefZh": "校准数据集",
      "explanationZh": "用于校准步骤、预先确定量化参数的数据集。"
    },
    {
      "term": "memory bandwidth",
      "briefZh": "内存带宽",
      "explanationZh": "内存与计算单元之间单位时间内可传输的数据量，是逐个生成后续词元时的主要瓶颈。"
    },
    {
      "term": "Round To Nearest (RTN)",
      "briefZh": "就近舍入",
      "explanationZh": "将数值舍入到最接近的可表示量化值的一种量化方法。"
    },
    {
      "term": "groupwise quantization",
      "briefZh": "分组量化",
      "explanationZh": "将权重分成若干组，并按组计算缩放因子进行量化，以帮助保持模型精度。"
    },
    {
      "term": "scaling factors",
      "briefZh": "缩放因子",
      "explanationZh": "用于在原始数值与量化数值之间建立尺度对应关系的参数，文中按组计算。"
    },
    {
      "term": "autoregressive manner",
      "briefZh": "自回归方式",
      "explanationZh": "利用已有输入及此前生成的词元，逐个生成后续词元的方式。"
    },
    {
      "term": "speculative decoding",
      "briefZh": "推测解码",
      "explanationZh": "先由较小的草稿模型生成候选 token，再由目标模型并行验证，以加快生成速度。"
    },
    {
      "term": "memory bandwidth bottleneck",
      "briefZh": "内存带宽瓶颈",
      "explanationZh": "数据从内存读取的速度限制了模型运行速度的情况。"
    },
    {
      "term": "draft model",
      "briefZh": "草稿模型",
      "explanationZh": "用于快速生成候选 token、供目标模型验证的小型模型。"
    }
  ],
