  "sourceTitle": "You could have designed state of the art positional encoding",
  "sourceBodyHash": "cba448958773ec35e64d917aff24330b7206767afa51ae66d46066e018749d44",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
