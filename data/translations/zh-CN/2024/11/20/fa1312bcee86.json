  "wordWise": [
    {
      "term": "static evaluations",
      "briefZh": "静态评测",
      "explanationZh": "使用预先确定的评测内容，而非动态交互过程来衡量模型表现的评测方式。"
    },
    {
      "term": "multimodal",
      "briefZh": "多模态",
      "explanationZh": "涉及文本、图像等多种信息模态的技术或能力。"
    },
    {
      "term": "multi-agent debates",
      "briefZh": "多智能体辩论",
      "explanationZh": "由多个智能体相互辩论，以改善推理能力和事实准确性的交互方式。"
    },
    {
      "term": "Discriminative Power",
      "briefZh": "区分能力",
      "explanationZh": "评测方法辨别不同模型之间性能差异的能力。"
    },
    {
      "term": "Isolated Generation Phenomenon",
      "briefZh": "孤立生成现象",
      "explanationZh": "模型各自根据用户输入生成回答，却不回应或利用彼此输出的现象。"
    },
    {
      "term": "adversarial contexts",
      "briefZh": "对抗情境",
      "explanationZh": "参与方相互质疑或挑战，需要模型应对对立论点的情境。"
    },
    {
      "term": "expert annotations",
      "briefZh": "专家标注",
      "explanationZh": "由专家对模型输出进行评价或标记，为评测提供专业判断依据。"
    },
    {
      "term": "Vote Bias",
      "briefZh": "投票偏差",
      "explanationZh": "投票受风格、格式等偏好影响，而不能客观反映内容质量或模型能力的偏差。"
    },
    {
      "term": "multi-model debates",
      "briefZh": "多模型辩论",
      "explanationZh": "多个模型直接交锋，通过辩论展示各自的推理过程和论证能力。"
    },
    {
      "term": "real-time debugging",
      "briefZh": "实时调试",
      "explanationZh": "在系统运行或交互过程中即时检查、定位和排查问题。"
    },
    {
      "term": "writing systems",
      "briefZh": "文字系统",
      "explanationZh": "用于书写语言的符号及其组织规则，不同语言可能采用不同的文字系统。"
    },
    {
      "term": "fine-tune parameters",
      "briefZh": "微调参数",
      "explanationZh": "根据模型特点和任务要求，对参数进行细致调整，以改善表现。"
    },
    {
      "term": "real-time feedback loop",
      "briefZh": "实时反馈闭环",
      "explanationZh": "及时获取表现反馈，并将反馈用于后续调整，形成持续优化的循环。"
    },
    {
      "term": "dual evaluation system",
      "briefZh": "双重评估体系",
      "explanationZh": "文中指结合专家评审和用户反馈，从技术与体验两个角度评估模型的体系。"
    },
    {
      "term": "logical reasoning",
      "briefZh": "逻辑推理",
      "explanationZh": "依据前提和逻辑关系推导结论的能力，是文中评估模型辩论表现的重要维度。"
    },
    {
      "term": "training paradigms",
      "briefZh": "训练范式",
      "explanationZh": "模型训练所采用的基本方法和框架。"
    },
    {
      "term": "coherence",
      "briefZh": "连贯性",
      "explanationZh": "模型在辩论中保持表达和论述前后衔接一致的能力。"
    },
    {
      "term": "adversarial conditions",
      "briefZh": "对抗条件",
      "explanationZh": "模型面对对方质疑、反驳或立场冲突的交互条件。"
    },
    {
      "term": "fine-grained findings",
      "briefZh": "细粒度发现",
      "explanationZh": "针对模型具体表现差异得出的更细致的研究发现。"
    },
    {
      "term": "head-to-head evaluations",
      "briefZh": "一对一评估",
      "explanationZh": "让两个模型直接对比，以判断其相对表现的评估方式。"
    },
    {
      "term": "fine-tuning",
      "briefZh": "微调",
      "explanationZh": "在已有模型基础上进一步训练，以调整或改善其表现。"
    },
    {
      "term": "system prompt",
      "briefZh": "系统提示词",
      "explanationZh": "用于设定模型整体行为、任务要求和约束的提示内容。"
    },
    {
      "term": "reasoning chains",
      "briefZh": "推理链",
      "explanationZh": "模型从问题出发、逐步推导出结论的推理过程。"
    },
    {
      "term": "adversarial strategies",
      "briefZh": "对抗策略",
      "explanationZh": "在辩论中用于挑战对方论点、应对反驳的策略。"
    }
  ],
