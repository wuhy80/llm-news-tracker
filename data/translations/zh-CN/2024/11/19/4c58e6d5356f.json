  "sourceTitle": "Judge Arena: Benchmarking LLMs as Evaluators",
  "sourceBodyHash": "fdb3a44477b69678acf1d2e3131fae12464320b41a71ede14d960b5a7ccccdbf",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
