  "sourceBodyHash": "181885e3b147731d1fbee2015eaa9ada8395b9daa88c1f115451b91b568dc1d8",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
