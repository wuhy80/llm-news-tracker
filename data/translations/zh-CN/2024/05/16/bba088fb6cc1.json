  "wordWise": [
    {
      "term": "KV Cache Quantization",
      "briefZh": "KV 缓存量化",
      "explanationZh": "通过降低键值缓存中数值的精度来减少内存占用，并在内存效率、生成速度与质量之间进行权衡。"
    },
    {
      "term": "quantization",
      "briefZh": "量化",
      "explanationZh": "将数值舍入或截断到较低精度的格式，以节省内存，但可能带来信息损失。"
    },
    {
      "term": "autoregressive models",
      "briefZh": "自回归模型",
      "explanationZh": "依赖已有上下文逐个预测并生成后续词元的模型。"
    },
    {
      "term": "token",
      "briefZh": "词元",
      "explanationZh": "语言模型处理和生成文本时使用的基本单位，文中模型每次生成一个词元。"
    },
    {
      "term": "matrix multiplications",
      "briefZh": "矩阵乘法",
      "explanationZh": "文中用于从先前词元的表示中计算预测所需信息的运算。"
    },
    {
      "term": "self-attention layers",
      "briefZh": "自注意力层",
      "explanationZh": "通过查询与键计算注意力分数，并对值向量加权求和的模型层。"
    },
    {
      "term": "concatenate",
      "briefZh": "拼接",
      "explanationZh": "将缓存中取出的键和值与当前向量连接起来，以用于当前词元的注意力计算。"
    },
    {
      "term": "kv cache",
      "briefZh": "键值缓存",
      "explanationZh": "缓存此前 token 的键和值，以便自回归生成时复用，避免重复计算。"
    },
    {
      "term": "autoregressive generation",
      "briefZh": "自回归生成",
      "explanationZh": "根据已有序列逐步生成下一个 token 的过程。"
    },
    {
      "term": "per-channel",
      "briefZh": "逐通道",
      "explanationZh": "按通道分别进行量化；文中用于降低键缓存中通道离群值带来的量化误差。"
    },
    {
      "term": "per-token",
      "briefZh": "逐词元",
      "explanationZh": "按每个 token 分别进行量化；文中的实现对键和值都采用这种方式。"
    },
    {
      "term": "residual cache",
      "briefZh": "残留缓存",
      "explanationZh": "以原始精度暂存近期键和值的固定大小缓存，达到容量上限后再量化其内容。"
    },
    {
      "term": "de-quantize",
      "briefZh": "反量化",
      "explanationZh": "将低精度量化表示转换回可用于计算的数值表示。"
    },
    {
      "term": "affine quantization",
      "briefZh": "仿射量化",
      "explanationZh": "通过缩放和偏移，将原始数值映射到较低精度表示的量化方式。"
    },
    {
      "term": "quantized tensor",
      "briefZh": "量化张量",
      "explanationZh": "将数值映射到较低精度表示后的张量。"
    },
    {
      "term": "zeropoint",
      "briefZh": "零点",
      "explanationZh": "量化映射中的偏移参数，此处按 round(-minX / S) 计算。"
    },
    {
      "term": "calibration data",
      "briefZh": "校准数据",
      "explanationZh": "用于确定量化参数的数据；文中指出无需此类数据的方法更易集成。"
    },
    {
      "term": "perplexity",
      "briefZh": "困惑度",
      "explanationZh": "衡量语言模型预测文本能力的指标，通常越低表示预测越好。"
    },
    {
      "term": "int4 cache",
      "briefZh": "四位整数缓存",
      "explanationZh": "使用 int4 精度存储的缓存，文中比较了其与 fp16 精度下的表现。"
    },
    {
      "term": "fp16",
      "briefZh": "半精度浮点",
      "explanationZh": "16 位浮点数格式，文中作为比较缓存质量和基准性能的参照精度。"
    },
    {
      "term": "int2",
      "briefZh": "两位整数",
      "explanationZh": "2 位整数精度格式，文中指出使用该精度时质量会下降。"
    },
    {
      "term": "backends",
      "briefZh": "后端",
      "explanationZh": "提供底层计算或执行支持的实现，文中比较了两个后端上的缓存表现。"
    },
    {
      "term": "benchmark",
      "briefZh": "基准测试",
      "explanationZh": "用于评估和比较性能的标准化测试，文中指 LongBench。"
    },
    {
      "term": "Dataset",
      "briefZh": "数据集",
      "explanationZh": "用于评估的一组数据，此处为表格中标示各测试数据集的列标题。"
    }
  ],
