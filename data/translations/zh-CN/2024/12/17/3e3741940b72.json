    },
    {
      "id": "b0053",
      "kind": "list-item",
      "sourceHash": "72f68f7edff6002b",
      "translationZh": "感谢 Georgi Gerganov 帮助集成一项重要修复，使 Falcon3 系列模型能够在 llama.cpp 中运行。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0054",
      "kind": "list-item",
      "sourceHash": "8cf00e124d76bab9",
      "translationZh": "感谢 Awni Hannun 帮助我们审查将 Falcon3 系列集成到 MLX 生态系统所需的变更。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0055",
      "kind": "list-item",
      "sourceHash": "967e1257b4dbc328",
      "translationZh": "感谢 BitNet.cpp 团队帮助我们将 Falcon3 模型的 1.58bit 变体集成到 BitNet 中。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0056",
      "kind": "heading",
      "sourceHash": "2955789aa4f8eb36",
      "translationZh": "引用",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0057",
      "kind": "paragraph",
      "sourceHash": "e7a9e1a49ad27845",
