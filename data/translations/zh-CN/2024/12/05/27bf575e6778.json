    {
      "id": "b0011",
      "kind": "paragraph",
      "sourceHash": "1d7dfb8ac392d9e5",
      "translationZh": "PaliGemma 2 简介",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0012",
      "kind": "paragraph",
      "sourceHash": "655c794af2538838",
