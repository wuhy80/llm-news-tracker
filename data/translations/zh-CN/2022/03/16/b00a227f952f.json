  "sourceTitle": "Accelerate BERT inference with Hugging Face Transformers and AWS Inferentia",
  "sourceBodyHash": "bc34c62f1112f1076048a8f959dc54c376864291a32de760630497435f43f82d",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
