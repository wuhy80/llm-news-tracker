  "sourceTitle": "Personal Copilot: Train Your Own Coding Assistant",
  "sourceBodyHash": "6d951e4025d8bef2842727c304da3cf8a852410f3cb6868a2bc53987eeba652e",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
