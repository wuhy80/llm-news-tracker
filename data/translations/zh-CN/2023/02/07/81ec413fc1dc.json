  "sourceTitle": "Introducing ⚔️ AI vs. AI ⚔️ a deep reinforcement learning multi-agents competition system",
  "sourceBodyHash": "7865e5bd9a8696c3d74d3ac7eb47f8d63af5a57284750ce9b07e5fdd0494ea51",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
