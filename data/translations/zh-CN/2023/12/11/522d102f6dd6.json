  "wordWise": [
    {
      "term": "Mixture of Experts",
      "briefZh": "混合专家",
      "explanationZh": "一种由多个专家模块组成的模型架构，可根据输入选择部分专家参与计算。"
    },
    {
      "term": "model card",
      "briefZh": "模型卡",
      "explanationZh": "介绍模型用途、特性、评估结果与使用限制等信息的说明文档。"
    },
    {
      "term": "inference",
      "briefZh": "推理",
      "explanationZh": "使用训练好的模型处理输入并生成输出的过程。"
    },
    {
      "term": "Sparsity",
      "briefZh": "稀疏性",
      "explanationZh": "在 MoE 语境中，指每次计算仅激活部分专家或参数的特性。"
    },
    {
      "term": "Load Balancing",
      "briefZh": "负载均衡",
      "explanationZh": "将词元处理任务合理分配给不同专家，避免部分专家过载而其他专家闲置。"
    },
    {
      "term": "tokens",
      "briefZh": "词元",
      "explanationZh": "模型处理文本时使用的基本单位，可以是单词、词的一部分或标点等。"
    },
    {
      "term": "MoEs",
      "briefZh": "混合专家模型",
      "explanationZh": "由多个专家模块组成、通过路由机制选择专家进行计算的模型。"
    },
    {
      "term": "router Z-loss",
      "briefZh": "路由器稳定损失",
      "explanationZh": "用于约束路由器输出、提高训练稳定性的辅助损失。"
    },
    {
      "term": "pretraining",
      "briefZh": "预训练",
      "explanationZh": "在针对具体任务进行调整之前，利用大量数据训练模型的阶段。"
    },
    {
      "term": "Fine-tuning",
      "briefZh": "微调",
      "explanationZh": "在已有模型的基础上继续训练，使其适应特定任务或数据。"
    },
    {
      "term": "sparse MoEs",
      "briefZh": "稀疏混合专家模型",
      "explanationZh": "每次计算仅激活部分专家，而非全部专家的混合专家模型。"
    },
    {
      "term": "dense models",
      "briefZh": "稠密模型",
      "explanationZh": "与稀疏专家模型相对，通常每次计算都会使用全部或大部分参数的模型。"
    },
    {
      "term": "Expert Parallelism",
      "briefZh": "专家并行",
      "explanationZh": "将不同专家分配到不同计算设备上并行运行的方式。"
    },
    {
      "term": "Capacity Factor",
      "briefZh": "容量因子",
      "explanationZh": "混合专家模型中用于控制每个专家可处理的词元数量上限的系数。"
    },
    {
      "term": "Communication costs",
      "briefZh": "通信开销",
      "explanationZh": "分布式计算中，设备之间传输数据所产生的时间和资源开销。"
    },
    {
      "term": "Serving Techniques",
      "briefZh": "推理服务技术",
      "explanationZh": "将模型部署为服务并高效处理推理请求的技术。"
    },
    {
      "term": "TL;DR",
      "briefZh": "简要概览",
      "explanationZh": "“Too Long; Didn’t Read”的缩写，常用作文章简短概览部分的标题。"
    },
    {
      "term": "VRAM",
      "briefZh": "显存",
      "explanationZh": "图形处理器使用的内存，此处用于存放模型的所有专家。"
    },
    {
      "term": "instruction-tuning",
      "briefZh": "指令微调",
      "explanationZh": "使用指令及相应回答进行微调，以提升模型遵循指令的能力。"
    },
    {
      "term": "computing budget",
      "briefZh": "计算预算",
      "explanationZh": "可用于训练的计算资源总量，限制了模型规模与训练步数的选择。"
    },
    {
      "term": "dense model",
      "briefZh": "稠密模型",
      "explanationZh": "与稀疏专家模型相对，通常对每个输入都使用相关层中全部参数进行计算的模型。"
    },
    {
      "term": "feed-forward network (FFN)",
      "briefZh": "前馈网络",
      "explanationZh": "Transformer 中用于变换特征的网络模块，在此被 MoE 层替代。"
    },
    {
      "term": "hierarchical MoEs",
      "briefZh": "层次化混合专家",
      "explanationZh": "专家本身也是 MoE，从而形成多层专家选择结构。"
    },
    {
      "term": "gate network",
      "briefZh": "门控网络",
      "explanationZh": "决定将输入词元分配给哪些专家的可学习网络。"
    }
  ],
