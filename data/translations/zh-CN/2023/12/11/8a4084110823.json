    {
      "id": "b0030",
      "kind": "list-item",
      "sourceHash": "7a9e3967190ce27d",
      "translationZh": "在大多数基准测试中，性能超越 Llama 2 70B，并达到或超过 GPT3.5",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
