  "sourceTitle": "Fine-tuning Stable Diffusion models on Intel CPUs",
  "sourceBodyHash": "b4c89f1fb3385689ba8a848217edd6d76cdd4ccec6f05f0a720080092255c301",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
