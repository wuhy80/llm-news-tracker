      "kind": "list-item",
      "sourceHash": "6877f0a8dc37d048",
      "translationZh": "使用 Hugging Face Hub 上的 SD XL 模型",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
