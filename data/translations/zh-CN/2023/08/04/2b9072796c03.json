  "sourceTitle": "Deploy MusicGen in no time with Inference Endpoints",
  "sourceBodyHash": "faa0b383b5c32c87e1cb5e4553a65f5f9caf3ae4af24fa4ffbc86c4158b73584",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
