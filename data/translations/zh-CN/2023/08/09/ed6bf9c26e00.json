    {
      "id": "b0096",
      "kind": "paragraph",
      "sourceHash": "ec8b53d3afe5d34e",
      "translationZh": "换句话说，它等于 elapsedTimenbLoops\\frac{elapsedTime}{nbLoops}nbLoopselapsedTime​。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0097",
      "kind": "paragraph",
      "sourceHash": "cf761f74af6502f6",
      "translationZh": "延迟越低越好。",
