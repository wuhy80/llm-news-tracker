      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0025",
      "kind": "paragraph",
      "sourceHash": "66a142005120aa26",
      "translationZh": "长度（均值 ± 标准差），以词元计",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
