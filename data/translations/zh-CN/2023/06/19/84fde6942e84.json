    },
    {
      "id": "b0177",
      "kind": "list-item",
      "sourceHash": "9afe99f885db4da6",
      "translationZh": "官方演示",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0178",
      "kind": "list-item",
