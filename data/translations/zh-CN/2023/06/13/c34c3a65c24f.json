  "sourceTitle": "Hugging Face and AMD partner on accelerating state-of-the-art models for CPU and GPU platforms",
  "sourceBodyHash": "cb9b242f0c79beb626abc8f3d7cc9af85a495ac7abaf75e0df45850415b7f070",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
