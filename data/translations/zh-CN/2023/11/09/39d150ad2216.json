    },
    {
      "id": "b0097",
      "kind": "list-item",
      "sourceHash": "7ea08cfa4ab68742",
      "translationZh": "latent-consistency/lcm-lora-ssd-1b。适用于 segmind/SSD-1B 的 LCM LoRA；segmind/SSD-1B 是一个经过蒸馏的 SDXL 模型，比原始 SDXL 小 50%，速度快 60%。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
