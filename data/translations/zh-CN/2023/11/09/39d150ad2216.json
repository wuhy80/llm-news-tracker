      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0100",
      "kind": "heading",
      "sourceHash": "7cd9f78c34d8232c",
      "translationZh": "额外福利：将 LCM LoRAs 与常规 SDXL LoRAs 结合",
