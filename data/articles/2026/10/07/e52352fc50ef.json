        },
        {
          "start": 20,
          "end": 32,
          "kind": "a",
          "href": "https://huggingface.co/LiquidAI/d1-omni-600M"
        }
      ]
    },
    {
      "id": "b0118",
      "source": "Try: run the demos in our System One Arcade Hugging Face Space.",
