    },
    {
      "id": "b0113",
      "kind": "heading",
      "sourceHash": "dd00d3d3e9f73d27",
      "translationZh": "后续步骤",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0114",
      "kind": "paragraph",
      "sourceHash": "1f93374a162bc2ba",
      "translationZh": "你无需安装任何软件即可试用 AI Sheets，也可以从 GitHub 仓库下载并在本地部署。若要在本地运行并充分发挥其作用，我们建议你订阅 PRO，获得 20 倍的每月推理用量。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
