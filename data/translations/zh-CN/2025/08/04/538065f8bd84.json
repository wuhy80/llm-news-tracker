  "sourceTitle": "Measuring Open-Source Llama Nemotron Models on DeepResearch Bench",
  "sourceBodyHash": "31d7896986912115cf103cd0913cbf9c5fefc74952d5f7f420b9f3c6cb505656",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
