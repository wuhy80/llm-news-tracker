  "sourceTitle": "What Is Retrieval-Augmented Generation, aka RAG?",
  "sourceBodyHash": "2be95cde3e5eb5ae099a77e69a2296fb88486fc01fe2aad15853a6d7f17b9c6f",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
