  "sourceTitle": "Microsoft and Hugging Face expand collaboration",
  "sourceBodyHash": "7c3ba63cf07a9dc2e6ba445a0cb2be8342f281deece051b3241ded7532fea3d8",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
