    },
    {
      "id": "b0039",
      "kind": "paragraph",
      "sourceHash": "1d1fc29a633cc45a",
      "translationZh": "图 9：MRCR 8-needle 检索。V4-Pro-Max 在上下文长度达到 256K 之前始终高于 0.82，在 1M 时仍保持在 0.59。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0040",
      "kind": "heading",
      "sourceHash": "ac26d5c9a2d5d0c2",
      "translationZh": "使用这些模型",
      "provider": "nowcoding",
