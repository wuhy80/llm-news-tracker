    },
    {
      "id": "b0043",
      "kind": "list-item",
      "sourceHash": "c6a20ab7e984b2f0",
      "translationZh": "deepseek-ai/DeepSeek-V4-Flash（284B / 13B 激活参数，指令版）",
      "provider": "nowcoding",
