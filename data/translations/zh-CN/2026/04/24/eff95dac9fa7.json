    },
    {
      "id": "b0044",
      "kind": "list-item",
      "sourceHash": "d9a0a1349f55bcb6",
      "translationZh": "deepseek-ai/DeepSeek-V4-Pro-Base（1.6T / 49B 激活参数，基础版）",
      "provider": "nowcoding",
