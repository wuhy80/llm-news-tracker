  "sourceTitle": "Pollo AI turns creative ideas into campaigns with OpenAI",
  "sourceBodyHash": "27d1b0c27f41b5cbb9ec3cd9bba4ea1a10d2023cc9ab14cfb4748e4322a1f843",
  "sourceLanguage": "en",
