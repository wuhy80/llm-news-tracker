  "sourceTitle": "How Oracle turns days of work into minutes with ChatGPT and Codex",
  "sourceBodyHash": "d02b7606cea011e215364004b6b94eb00df203b37cf19def70970eb27ed07b7a",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
