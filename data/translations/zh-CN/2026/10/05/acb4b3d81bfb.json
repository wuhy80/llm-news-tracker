  "sourceTitle": "Agent: Muse, but open source and living on your Android phone",
  "sourceBodyHash": "a42e48656d576c0ce1d1b355700354369b40f2a5f9a6f9cdfa9cd720520c0d59",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
