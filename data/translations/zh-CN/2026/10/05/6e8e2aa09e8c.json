  "sourceTitle": "Making Amazon Quick enterprise-ready: Automated, auditable cross-account resource promotion",
  "sourceBodyHash": "3556ebfe037bbc985dcfb7c794c07496e290ba7c3929a5f21978c58187197c50",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
