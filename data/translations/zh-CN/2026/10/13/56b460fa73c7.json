  "sourceTitle": "Building agents that transact with Anchor Browser and AgentCore payments",
  "sourceBodyHash": "20e8a5c14d62e55f75db6e0a1a0c9f3b2a45fb114cc1a8acd756998d496d80cf",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "complete",
  "importanceLevel": 5,
  "provider": "nowcoding",
