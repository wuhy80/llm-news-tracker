  "sourceTitle": "Higgsfield takes AI video from 1 minute to over 10",
  "sourceBodyHash": "5dbce17724b124f12ae6d95cf434a3752288ad588fbebc2e9a68f8f7d0f20b60",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
