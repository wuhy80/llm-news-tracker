    },
    {
      "id": "b0013",
      "kind": "list-item",
      "sourceHash": "4676a8099ce6d496",
      "translationZh": "在线工具：AskCyph Health Explorer",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0014",
      "kind": "paragraph",
      "sourceHash": "ba36521ac4b7057d",
      "translationZh": "很想听听你们的机器能达到怎样的 WebGPU 吞吐量，以及其他人如何在敏感领域将专用基础模型与客户端 SLMs 搭配使用！",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
