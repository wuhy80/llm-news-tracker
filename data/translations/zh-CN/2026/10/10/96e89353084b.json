  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "2e1e4bbfa218b626",
      "translationZh": "DigUp 是一款免费的 Mac 应用，可在本地使用 Google DeepMind 的新模型 EmbeddingGemma 2 处理你自己的文件。该模型将文本、图像、音频和视频放入同一个空间，因此你只需描述记得的内容，就能找到它：",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0002",
      "kind": "list-item",
      "sourceHash": "a47cb58e6641ed15",
      "translationZh": "“视频中的斑马”会打开视频中它出现的那一刻",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0003",
      "kind": "list-item",
      "sourceHash": "42c36850fad04fe0",
      "translationZh": "“他们谈论睡眠的地方”会跳转到播客中的那一分钟",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0004",
      "kind": "list-item",
      "sourceHash": "638f706598236fab",
      "translationZh": "“租约中关于宠物的条款”会显示相应的 PDF 页面，并标出你的文字",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0005",
      "kind": "list-item",
      "sourceHash": "d7ba58fb346d22bf",
      "translationZh": "“海滩上的狗”会找到那张照片；用孟加拉语或阿拉伯语进行相同搜索也能找到它",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0006",
      "kind": "list-item",
      "sourceHash": "cbfefd9558009c6b",
      "translationZh": "开启代码搜索后，搜索 code: retry with backoff 会在编辑器中打开相应函数",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0007",
      "kind": "paragraph",
      "sourceHash": "0f5aa7bce94ec5e1",
      "translationZh": "它在原生 Swift 应用中通过 Metal 使用 ggml-org 的 Q8_0 GGUF（865 MB，只需下载一次）和 llama.cpp；无需 Python。搜索时只会加载文本编码器（约 250 MB），你停止输入约十分之一秒后就会看到结果。索引建立期间内存峰值低于 2 GB，辅助程序完成后会退出。任意长度的音频和视频都会按 30 秒窗口处理，并为每个镜头提取一帧。所有操作都在本地运行；它只会为下载模型和检查更新联网，而更新检查可以关闭。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0008",
      "kind": "paragraph",
      "sourceHash": "f0e84fc9d3d3b5b6",
      "translationZh": "免费，采用 MIT 许可证。支持 Apple Silicon，要求 macOS 14 或更高版本。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0009",
      "kind": "paragraph",
      "sourceHash": "019e9b11c399a49a",
      "translationZh": "代码仓库与下载（已签名并经过公证）：https://github.com/ARahim3/DigUp",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0010",
      "kind": "paragraph",
      "sourceHash": "9441346a7ba7e36f",
      "translationZh": "非常感谢大家对此提供任何反馈。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    }
  ],
