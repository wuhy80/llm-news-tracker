    },
    {
      "id": "b0103",
      "kind": "paragraph",
      "sourceHash": "0ff1d4576a3f55c9",
      "translationZh": "图 3：生成的内容幻灯片，包含项目符号列表",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0104",
      "kind": "paragraph",
      "sourceHash": "ea4207d5c3272f0a",
      "translationZh": "图 4：生成的幻灯片，将文本与 AI 生成的图像相结合",
      "provider": "nowcoding",
