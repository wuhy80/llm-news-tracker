  "sourceBodyHash": "a7fd1395df54ea4a734effb0af6747b11ea1ed79e808cf7488fc3db0c0b24757",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
