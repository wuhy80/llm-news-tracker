  "sourceTitle": "Amp puts AI agents to work beyond code with OpenAI models",
  "sourceBodyHash": "0fde9d59600b36d31a4b713db7a56d322f5ced27b214c9003f788962cae5acee",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
