  "sourceUrl": "https://openai.com/index/sophos",
  "sourceTitle": "Sophos cuts threat investigation time by 96% with OpenAI Daybreak",
  "sourceBodyHash": "e8f1b65d79da5936ad396787019291e007009fac843be3e5a7664653a5a6f2ff",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "complete",
  "importanceLevel": 5,
