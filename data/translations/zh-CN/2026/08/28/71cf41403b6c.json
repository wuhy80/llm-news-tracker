    {
      "id": "b0056",
      "kind": "list-item",
      "sourceHash": "96ee1402cd84cad1",
      "translationZh": "更改了 /radio 的可用范围，使其在 Bedrock、Vertex AI、Foundry、AWS 上的 Claude Platform 以及禁用遥测时均可用",
      "provider": "openrouter",
