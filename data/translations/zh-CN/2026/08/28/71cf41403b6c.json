    },
    {
      "id": "b0046",
      "kind": "list-item",
      "sourceHash": "179d1639f4720bbb",
      "translationZh": "通过减少冗余的 UI 重渲染，优化了交互式会话在轮次期间的 CPU 使用率",
      "provider": "openrouter",
