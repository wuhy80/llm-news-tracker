  "sourceTitle": "GitHub Copilot app for Beginners: Write your first prompt",
  "sourceBodyHash": "1a547ab45e3cb27608b6b0d5375788a8f33b497a69e4c5be5cd9ff8aadd731e8",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
