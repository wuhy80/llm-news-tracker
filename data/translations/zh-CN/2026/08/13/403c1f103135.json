    },
    {
      "id": "b0039",
      "kind": "heading",
      "sourceHash": "81c3c51bbefa890e",
      "translationZh": "推出基于 Gemini 的智能体式视频理解",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0040",
      "kind": "paragraph",
      "sourceHash": "7b520976bac0e6f5",
      "translationZh": "作者：Rohan Doshi 和 Mario Lučić",
      "provider": "nowcoding",
