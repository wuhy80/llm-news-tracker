    },
    {
      "term": "logits buffer",
      "briefZh": "得分缓冲区",
      "explanationZh": "用于存放 logits 的内存区域；按块处理可以降低其瞬时内存需求。"
    },
    {
      "term": "--context-length",
      "briefZh": "上下文长度参数",
      "explanationZh": "用于配置上下文长度的命令行参数；配置该值并不等于已完成相应长度的实际测试。"
    },
    {
      "term": "multi-turn tool-call history",
      "briefZh": "多轮工具调用历史",
      "explanationZh": "跨多轮交互保留的工具调用记录，此处指被视觉预览功能破坏的历史数据。"
    },
