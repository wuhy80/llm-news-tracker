  "sourceTitle": "Got DeepSeek-V4-Flash-Vision running reliably on 2× RTX PRO 6000 Blackwell (SM120) with SGLang — had to patch 3 separate issues",
  "sourceBodyHash": "03b21dcf42d307a3d929f3e5306680ed51c2c3049fc03ff990757dfe7d2ddc4a",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "complete",
  "importanceLevel": 4,
  "provider": "nowcoding",
