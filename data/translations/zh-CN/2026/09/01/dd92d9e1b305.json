  "sourceTitle": "Claude Fable 5.1 made me a really nice animated pelican",
  "sourceBodyHash": "3947eec3db7dc15f6768626f004826d65965bc705ca97090e796820f98700518",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
