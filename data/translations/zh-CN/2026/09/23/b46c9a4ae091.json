  "sourceTitle": "Use open weight models as your AI coding agent with Amazon Bedrock",
  "sourceBodyHash": "8fdcac631d4bddaf2cfa86d9894aa8bdd9cb4cad4014b6cc4f85c8cdc05d6ae9",
  "sourceLanguage": "en",
