    },
    {
      "id": "b0033",
      "kind": "list-item",
      "sourceHash": "fbf2022815ae8a6c",
      "translationZh": "准入压力修复：当候选项需要主机 KV 容量配额时，不再抑制降级至主机的操作",
      "provider": "nowcoding",
