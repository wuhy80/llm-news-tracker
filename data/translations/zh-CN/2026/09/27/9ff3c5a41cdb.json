  "wordWise": [
    {
      "term": "abliterated",
      "briefZh": "去拒绝",
      "explanationZh": "指通过修改模型内部表示，削弱或移除其拒绝回答倾向的处理。"
    },
    {
      "term": "W8A16",
      "briefZh": "权重8位激活16位",
      "explanationZh": "表示权重使用 8 位精度，激活使用 16 位精度。"
    },
    {
      "term": "drafter",
      "briefZh": "草稿模型",
      "explanationZh": "在推测解码中提前生成候选词元，供主模型验证的模型。"
    },
    {
      "term": "pipeline parallel",
      "briefZh": "流水线并行",
      "explanationZh": "将模型的不同层或组件分配到不同设备上，按阶段执行计算。"
    },
    {
      "term": "FP8 KV",
      "briefZh": "8位键值缓存",
      "explanationZh": "指使用 FP8 浮点格式存储注意力机制的键值缓存。"
    },
    {
      "term": "Prefill",
      "briefZh": "预填充",
      "explanationZh": "处理输入上下文并建立键值缓存的阶段，发生在逐词元生成之前。"
    },
    {
      "term": "TTFT",
      "briefZh": "首个词元延迟",
      "explanationZh": "从提交请求到生成首个输出词元所需的时间。"
    },
    {
      "term": "decodes",
      "briefZh": "解码",
      "explanationZh": "指模型生成输出 token 的过程，此处比较代码与普通文本的生成速度。"
    },
    {
      "term": "prefix cache",
      "briefZh": "前缀缓存",
      "explanationZh": "缓存输入中相同前缀的计算结果，以便后续对话复用。"
    },
    {
      "term": "patched",
      "briefZh": "打过补丁的",
      "explanationZh": "指软件经过补丁修改，此处表示需要使用修改过的 vLLM。"
    },
    {
