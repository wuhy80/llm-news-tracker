  "sourceTitle": "Reducing medical claims review time with AI on AWS: The EXL Medical IDP solution",
  "sourceBodyHash": "5092d90e6e782a2a38a24b84b2dd940d71d07f06fd6e84e1dddab27169e5b126",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
