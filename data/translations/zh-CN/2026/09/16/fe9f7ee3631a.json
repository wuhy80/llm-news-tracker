  "sourceTitle": "How workers are unlocking new ways of working",
  "sourceBodyHash": "6705676abd0e9d3c55742a5ab637b549e9ae6af7ad750e673001a6e627b5af07",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
