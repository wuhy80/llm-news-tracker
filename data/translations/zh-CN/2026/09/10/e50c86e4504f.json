  "sourceUrl": "https://openai.com/index/using-codex-chatgpt-to-search-for-new-antimicrobials",
  "sourceTitle": "How a researcher uses Codex and ChatGPT to search for new antimicrobial molecules",
  "sourceBodyHash": "f85a170ae8ba9c4fe20c4411d66845db7c1279ecd054652587563333cffdecbd",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
