  "sourceTitle": "GitHub Copilot app for Beginners: Using the diff, terminal, and browser",
  "sourceBodyHash": "89e13e12b0343cdeaddf025f558c785a5373682e09fc64f0082d1b7bdfbd775e",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
