  "translatedBlocks": 12,
  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "0a1aa2d391738907",
      "translationZh": "语言模型智能体基准测试正日益成为交互式评估基础设施。智能体观察状态、调用工具、修改工作区、",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0002",
      "kind": "paragraph",
      "sourceHash": "8a1c2766d08a46a8",
      "translationZh": "提交产物，并从结果判定程序中获得奖励。这种交互性使评估容易受到奖励投机的影响：智能体",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0003",
      "kind": "paragraph",
      "sourceHash": "01507f55fa324f7d",
      "translationZh": "通过利用与奖励相关的执行轨迹，而非解决预期任务，来提高其测得的分数。现有防御措施主要依赖",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0004",
      "kind": "paragraph",
      "sourceHash": "2475c620c66be0b8",
      "translationZh": "针对特定任务的补丁、提示指令或事后检测器。它们无法提供可复用的证据，来证明某次具体运行始终处于",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0005",
      "kind": "paragraph",
      "sourceHash": "b2850f1f366214f5",
      "translationZh": "预期的评估边界之内。本文提出 BenchShield，这是一个由模型支撑的插桩层，用于保障",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0006",
      "kind": "paragraph",
      "sourceHash": "76f3b53c08c7de4e",
      "translationZh": "大语言模型智能体评估中的奖励完整性。BenchShield 将检测建立在一个有限生命周期模型之上，该模型刻画评估中与奖励相关的事件。在",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0007",
      "kind": "paragraph",
      "sourceHash": "6be73c12ee872234",
      "translationZh": "基准测试基础设施内部，两种互补的分析基于该模型开展。静态的、具备阶段感知能力的污点分析会在运行前揭示奖励投机",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0008",
      "kind": "paragraph",
      "sourceHash": "5509e8889cdb32c8",
      "translationZh": "路径。与之对应的运行时分析则利用基础设施侧的证据，对智能体的具体利用行为进行归因，并输出有证据支持的判定。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0009",
      "kind": "paragraph",
      "sourceHash": "35227e8673dc319e",
      "translationZh": "我们构建了 BenchShield Trajectories，这是一个经过人工标注的语料库，包含从超过 31,000 次公开智能体运行中裁定的 456 条轨迹，这些运行覆盖",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0010",
      "kind": "paragraph",
      "sourceHash": "3c3521ff08bc3409",
      "translationZh": "三个基准。在相同任务和模型上，与基于智能体的可利用性扫描器基线相比，BenchShield 将全链路召回率",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0011",
      "kind": "paragraph",
      "sourceHash": "0f289e5120f1d568",
      "translationZh": "从 23-94% 提升至 77-100%，将同类攻击向量覆盖率从 16-56% 提升至 43-78%，并将每项任务的成本最多降低 65%。其运行时分析达到 96% 的",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0012",
      "kind": "paragraph",
      "sourceHash": "b90118f5c405907b",
      "translationZh": "准确率，用于根据基础设施侧证据检测奖励黑客行为。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    }
  ],
