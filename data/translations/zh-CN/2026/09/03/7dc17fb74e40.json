  "sourceTitle": "Give Your Coding Agents a Memory You Own",
  "sourceBodyHash": "4e84bf36190dd8ec13e88387b8f08bcea3420445f246fc9d00a49a7f0e92d63f",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "complete",
  "importanceLevel": 4,
  "provider": "nowcoding",
