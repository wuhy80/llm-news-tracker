  "sourceUrl": "https://openai.com/index/proaction",
  "sourceTitle": "Proaction boosts sales 60% and saves 75+ hours with Codex",
  "sourceBodyHash": "4918965ac452f8e98e6df5d13f28f1e5c8d2c575d029b475a1a34bb1ac55904c",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
