      "kind": "list-item",
      "sourceHash": "d2ba9045c15aed9a",
      "translationZh": "功耗配置涵盖 CPU、PCIe/NVMe、GPU 限制/风扇、看门狗行为以及 PSU/UPS 预算",
      "provider": "openrouter",
      "model": "google/gemma-4-26b-a4b-it:free"
    },
    {
