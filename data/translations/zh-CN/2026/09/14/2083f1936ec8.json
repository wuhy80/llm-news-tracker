  "wordWise": [
    {
      "term": "dependence-aware label aggregation",
      "briefZh": "依赖感知标签聚合",
      "explanationZh": "聚合多个评判者的标签时，将它们之间的依赖关系纳入考虑，避免把相关意见当作独立证据。"
    },
    {
      "term": "Ising models",
      "briefZh": "伊辛模型",
      "explanationZh": "用于描述变量之间相互作用的模型，文中用于建模评判者输出之间的相关性。"
    },
    {
      "term": "pairwise dependencies",
      "briefZh": "两两依赖关系",
      "explanationZh": "任意两个评判者的输出之间存在的依赖关系，可反映它们是否倾向于作出相同判断。"
    },
    {
      "term": "unsupervised settings",
      "briefZh": "无监督场景",
      "explanationZh": "文中指没有人工参考标签可供对照，却仍需估计评判者可靠性并聚合判断的场景。"
    },
    {
