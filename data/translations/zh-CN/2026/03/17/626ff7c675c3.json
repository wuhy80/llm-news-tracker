  "sourceTitle": "State of Open Source on Hugging Face: Spring 2026",
  "sourceBodyHash": "54049fbacec55310986dd4f4eb73d9f193602a34d6cfa8973eee250bac21ce78",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
