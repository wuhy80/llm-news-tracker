  "sourceTitle": "The Open Source Community is backing OpenEnv for Agentic RL",
  "sourceBodyHash": "edbad4271915ab7cb19d3094eede62a9590cd5183a2649672ec3590f43d9d18d",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
