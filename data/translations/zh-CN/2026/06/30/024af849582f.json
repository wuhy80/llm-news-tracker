    },
    {
      "id": "b0052",
      "kind": "heading",
      "sourceHash": "81c0514443d15d43",
      "translationZh": "Gemini 4 Argon：开启我们的前沿智能新纪元",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0053",
      "kind": "heading",
      "sourceHash": "1dcfa6e64bf1becb",
      "translationZh": "看看 4 位开发者正在用 Gemini 3.8 Flash 打造什么",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0054",
