      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0032",
      "kind": "paragraph",
      "sourceHash": "95ce9f7baf51d948",
      "translationZh": "作者：Justyna Politanska-Pyszko 和 Natalie McHugh",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0033",
      "kind": "heading",
      "sourceHash": "892c6f3a5093583b",
      "translationZh": "我们在 2026 年 8 月发布的最新 AI 新闻",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0034",
      "kind": "paragraph",
      "sourceHash": "91979947e61b341b",
      "translationZh": "作者：News from Google 团队",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0035",
      "kind": "heading",
      "sourceHash": "f7adf7dcfb47847d",
      "translationZh": "将 Google Antigravity 与 Gemini 3.7 Flash 搭配使用，可解决值得关注的多智能体数学和工程问题。",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0036",
      "kind": "heading",
      "sourceHash": "f6a54f1c6d3cdcce",
      "translationZh": "Gemini Omni 1.1 Flash 让你在构建时拥有更多控制权",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0037",
      "kind": "paragraph",
      "sourceHash": "979723201aeb3d1e",
      "translationZh": "作者：Anish Nangia 和 Alisa Fortin",
      "provider": "nowcoding",
      "model": "gpt-6.1-sol"
    },
    {
      "id": "b0038",
      "kind": "heading",
      "sourceHash": "4d5de3ea8dfb28f7",
      "translationZh": "开发者如何利用 Gemma 4 构建造福社会的 AI",
      "provider": "nowcoding",
