  "sourceTitle": "Model Routing Is Simple. Until It Isn’t.",
  "sourceBodyHash": "59e2876fdc0aa4b67fa21474ff70cc6c5956fa69e526763774c48c37584a540a",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
