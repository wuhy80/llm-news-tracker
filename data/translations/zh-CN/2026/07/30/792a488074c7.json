  "sourceTitle": "Stacked sessions and pull requests in the GitHub Copilot app",
  "sourceBodyHash": "9fcdef854bd046f9167df7c75a7612c8395644a597924d1f8bf379842765a4b4",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
