  "sourceUrl": "https://huggingface.co/blog/community-evals",
  "sourceTitle": "Community Evals: Because we're done trusting black-box leaderboards over the community",
  "sourceBodyHash": "3941937d7f0fb4a85099313081f5266a1f91080ae747fa9a74ec9a09c2fdef7c",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
