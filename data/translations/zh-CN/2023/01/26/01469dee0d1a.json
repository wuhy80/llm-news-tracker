  "sourceTitle": "Using LoRA for Efficient Stable Diffusion Fine-Tuning",
  "sourceBodyHash": "67a9bba572632b8c988f9f61cc34068655ec05fad064060afa570999533e5eaa",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "complete",
