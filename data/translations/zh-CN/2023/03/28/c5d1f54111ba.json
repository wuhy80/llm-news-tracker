  "sourceTitle": "Fast Inference on Large Language Models: BLOOMZ on Habana Gaudi2 Accelerator",
  "sourceBodyHash": "af6cba6abc168c34678f10cacd1c5d461782621371c3b8f7fff8d57a66d5618f",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "complete",
