      "provider": "zcode-local",
      "model": "GLM-5.3-Flash"
    },
    {
      "id": "b0009",
      "kind": "paragraph",
      "sourceHash": "1e3fd26f7f7989ae",
      "translationZh": "总成本（$）",
      "provider": "zcode-local",
      "model": "GLM-5.3-Flash"
    },
    {
      "id": "b0010",
      "kind": "paragraph",
      "sourceHash": "6c75a19dd39ee15d",
      "translationZh": "网格搜索",
      "provider": "zcode-local",
      "model": "GLM-5.3-Flash"
    },
    {
      "id": "b0013",
      "kind": "paragraph",
