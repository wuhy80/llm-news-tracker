  "blocks": [
    {
      "id": "b0001",
      "kind": "paragraph",
      "sourceHash": "d4d5c9a6b089c151",
      "translationZh": "每天都有数百个 Transformers 实验和模型上传到 Hugging Face Hub。做这些实验的机器学习工程师和学生使用各种框架：PyTorch、TensorFlow/Keras 或其他。这些模型已被数千家公司使用，构成 AI 产品的地基。",
      "provider": "zcode",
      "model": "glm-5.3-flash"
    },
    {
      "id": "b0002",
      "kind": "paragraph",
      "sourceHash": "157d71a8e589ddb8",
      "translationZh": "如果你在生产环境部署 Transformers 模型，我们建议先把它们导出成一种序列化格式，以便在专用运行时和硬件上加载、优化和执行。",
      "provider": "zcode",
      "model": "glm-5.3-flash"
    },
    {
      "id": "b0003",
      "kind": "paragraph",
      "sourceHash": "bf0fdf8a867c0bde",
      "translationZh": "在本指南中，你将了解：",
      "provider": "zcode",
      "model": "glm-5.3-flash"
    },
    {
      "id": "b0004",
      "kind": "list-item",
      "sourceHash": "2b49388b3c22ebfa",
      "translationZh": "什么是 ONNX？",
      "provider": "zcode",
      "model": "glm-5.3-flash"
    },
    {
      "id": "b0005",
