  "sourceTitle": "Getting Started with Transformers on Habana Gaudi",
  "sourceBodyHash": "27514ff88b245fee4e11fd46f8ef0c6c52ad3738ec67851ddd4b30e5e091ded3",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
  "status": "complete",
