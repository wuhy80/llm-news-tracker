  "sourceTitle": "Introducing Community Tools on HuggingChat",
  "sourceBodyHash": "c779bd62f8e66472393a7f4b4e24ff56747e70a1ca6d67a7945753630a88867c",
  "sourceLanguage": "en",
  "targetLanguage": "zh-CN",
  "translationVersion": "openrouter-zh-v2",
